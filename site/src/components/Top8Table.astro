---
import { t, type Locale } from '@/lib/i18n';

interface Top8Entry {
  place: number;
  playerName: string;
  commanderName: string;
  score: string;
  commanderImage: string | null;
  cardImage: string | null;
  decklistUrl: string | null;
  isBanned: boolean;
  /** The result was published without naming the commander. */
  isUnknown?: boolean;
}

interface Props {
  top8: Top8Entry[];
  locale: Locale;
  topLabel: string;
}

const { top8, locale, topLabel } = Astro.props;
const winner = top8.find(e => e.place === 1) ?? null;
const rest = top8.filter(e => e.place > 1);

function splitCmd(name: string): string[] {
  return name.split(' // ').map(s => s.trim());
}

// Pre-compute data for template
const winnerParts = winner ? splitCmd(winner.commanderName) : [];
const restData = rest.map(entry => ({
  ...entry,
  parts: entry.isUnknown ? [entry.commanderName] : splitCmd(entry.commanderName),
  placeClass: entry.place <= 3 ? `tournament-place--${entry.place}` : '',
}));
---

<div class="lg:col-span-3 min-w-0">
  <h2 class="text-lg font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
    <span class="w-1 h-5 bg-brand-orange rounded-full"></span>
    {topLabel}
  </h2>

  {top8.length > 0 ? (
    <div>
      {/* Winner highlight */}
      {winner && (
        <div class={`tournament-winner mb-4 ${winner.decklistUrl ? 'tournament-winner--link' : ''}`}>
          {winner.decklistUrl ? (
            <a href={winner.decklistUrl} class="block">
              <div class="flex items-center gap-2 sm:gap-3">
                <div class="tournament-place tournament-place--1">1</div>
                {winner.commanderImage && (
                  <div class={`w-10 h-10 sm:w-14 sm:h-14 rounded-lg overflow-hidden shadow-lg ring-2 ${winner.isBanned ? 'ring-red-500/40 grayscale' : 'ring-yellow-500/30'} flex-shrink-0 card-hover-trigger`}
                       data-card-name={winner.commanderName}
                       data-card-image={winner.cardImage ?? winner.commanderImage}>
                    <img src={winner.commanderImage} alt={winner.commanderName} width="56" height="56" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <p class={`font-bold text-sm sm:text-base text-yellow-300 font-beleren truncate leading-tight ${winner.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{winnerParts[0]}</p>
                    {winner.isBanned && (
                      <span class="flex-shrink-0 px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-xs font-bold text-red-400 uppercase tracking-wider leading-none">{t('meta.banned', locale)}</span>
                    )}
                  </div>
                  {winnerParts.length > 1 && (
                    <p class={`text-xs text-yellow-200/70 font-beleren truncate leading-tight ${winner.isBanned ? 'line-through decoration-red-500/70' : ''}`}>+ {winnerParts[1]}</p>
                  )}
                  {winner.playerName && <p class="text-xs text-yellow-200/80 truncate">{winner.playerName}</p>}
                </div>
                {winner.score && <span class="text-xs font-mono text-yellow-400 flex-shrink-0">{winner.score}</span>}
                <span class="flex-shrink-0 px-2.5 py-1 bg-yellow-500/15 border border-yellow-500/30 rounded text-xs font-bold text-yellow-400 uppercase tracking-wide">{t('tournament.deck', locale)}</span>
              </div>
            </a>
          ) : (
            <div class="flex items-center gap-2 sm:gap-3">
              <div class="tournament-place tournament-place--1">1</div>
              {winner.commanderImage && (
                <div class={`w-10 h-10 sm:w-14 sm:h-14 rounded-lg overflow-hidden shadow-lg ring-2 ${winner.isBanned ? 'ring-red-500/40 grayscale' : 'ring-yellow-500/30'} flex-shrink-0 card-hover-trigger`}
                     data-card-name={winner.commanderName}
                     data-card-image={winner.cardImage ?? winner.commanderImage}>
                  <img src={winner.commanderImage} alt={winner.commanderName} width="56" height="56" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5">
                  <p class={`font-bold text-sm sm:text-base text-yellow-300 font-beleren truncate leading-tight ${winner.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{winnerParts[0]}</p>
                  {winner.isBanned && (
                    <span class="flex-shrink-0 px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-xs font-bold text-red-400 uppercase tracking-wider leading-none">{t('meta.banned', locale)}</span>
                  )}
                </div>
                {winnerParts.length > 1 && (
                  <p class={`text-xs text-yellow-200/70 font-beleren truncate leading-tight ${winner.isBanned ? 'line-through decoration-red-500/70' : ''}`}>+ {winnerParts[1]}</p>
                )}
                {winner.playerName && <p class="text-xs text-yellow-200/80 truncate">{winner.playerName}</p>}
              </div>
              {winner.score && <span class="text-xs font-mono text-yellow-400 flex-shrink-0">{winner.score}</span>}
            </div>
          )}
        </div>
      )}

      {/* Remaining entries */}
      <div class="tournament-table">
        {restData.map(entry => (
          entry.decklistUrl ? (
            <a href={entry.decklistUrl} class={`tournament-row tournament-row--link `}>
              <div class={`tournament-place ${entry.placeClass}`}>{entry.place}</div>
              {entry.commanderImage ? (
                <div class={`w-9 h-9 rounded overflow-hidden flex-shrink-0 ${entry.isBanned ? 'grayscale ring-1 ring-red-500/40' : ''} card-hover-trigger`}
                     data-card-name={entry.commanderName} data-card-image={entry.cardImage ?? entry.commanderImage}>
                  <img src={entry.commanderImage} alt={entry.commanderName} width="56" height="56" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              ) : (
                <div class="w-9 h-9 rounded bg-bg-tertiary flex-shrink-0"></div>
              )}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5">
                  <p class={`text-sm font-semibold text-text-primary font-beleren truncate leading-tight ${entry.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{entry.parts[0]}</p>
                  {entry.isBanned && (
                    <span class="flex-shrink-0 px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-xs font-bold text-red-400 uppercase tracking-wider leading-none">{t('meta.banned', locale)}</span>
                  )}
                </div>
                {entry.parts.length > 1 && (
                  <p class={`text-xs text-text-muted font-beleren truncate leading-tight ${entry.isBanned ? 'line-through decoration-red-500/70' : ''}`}>+ {entry.parts[1]}</p>
                )}
                {entry.playerName && <p class="text-xs text-text-muted truncate leading-tight">{entry.playerName}</p>}
              </div>
              {entry.score && <span class="text-xs font-mono text-text-muted flex-shrink-0">{entry.score}</span>}
              <span class="flex-shrink-0 px-2 py-0.5 bg-brand-orange/10 border border-brand-orange/20 rounded text-xs font-semibold text-brand-orange">{t('tournament.deck', locale)}</span>
            </a>
          ) : (
            <div class={`tournament-row `}>
              <div class={`tournament-place ${entry.placeClass}`}>{entry.place}</div>
              {entry.commanderImage ? (
                <div class={`w-9 h-9 rounded overflow-hidden flex-shrink-0 ${entry.isBanned ? 'grayscale ring-1 ring-red-500/40' : ''} card-hover-trigger`}
                     data-card-name={entry.commanderName} data-card-image={entry.cardImage ?? entry.commanderImage}>
                  <img src={entry.commanderImage} alt={entry.commanderName} width="56" height="56" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              ) : (
                <div class="w-9 h-9 rounded bg-bg-tertiary flex-shrink-0"></div>
              )}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5">
                  <p class={`text-sm font-semibold text-text-primary font-beleren truncate leading-tight ${entry.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{entry.parts[0]}</p>
                  {entry.isBanned && (
                    <span class="flex-shrink-0 px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-xs font-bold text-red-400 uppercase tracking-wider leading-none">{t('meta.banned', locale)}</span>
                  )}
                </div>
                {entry.parts.length > 1 && (
                  <p class={`text-xs text-text-muted font-beleren truncate leading-tight ${entry.isBanned ? 'line-through decoration-red-500/70' : ''}`}>+ {entry.parts[1]}</p>
                )}
                {entry.playerName && <p class="text-xs text-text-muted truncate leading-tight">{entry.playerName}</p>}
              </div>
              {entry.score && <span class="text-xs font-mono text-text-muted flex-shrink-0">{entry.score}</span>}
              <span class="flex-shrink-0 text-xs text-text-muted/40">&mdash;</span>
            </div>
          )
        ))}
      </div>
    </div>
  ) : (
    <p class="text-text-muted italic text-sm">{t('tournament.resultsUnavailable', locale)}</p>
  )}
</div>
