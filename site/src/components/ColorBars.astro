---
/**
 * How many players' commanders include each colour.
 *
 * Replaces the colour donut (ColorPieChart). Its slices split one circle
 * between colours that overlap: a two-colour commander counted in two slices,
 * so no slice could be read as a share of anything. Each colour is its own bar
 * now, measured against the players, with the numbers printed beside it.
 */
import '@/styles/results.css';
import { t, localeTag, type Locale } from '@/lib/i18n';
import { formatColorSymbols } from '@/lib/mana';

interface Props {
  /** Players per colour, a multicolour commander counting in each of its colours. */
  counts: Record<string, number>;
  /** Players whose commander is known: the denominator of every bar. */
  total: number;
  locale: Locale;
  title: string;
  class?: string;
}

const { counts, total, locale, title, class: className } = Astro.props;

const TOKEN: Record<string, string> = { W: 'white', U: 'blue', B: 'black', R: 'red', G: 'green', C: 'colorless' };
const percent = new Intl.NumberFormat(localeTag(locale), { style: 'percent', maximumFractionDigits: 0 });

// Mana order, not count order: the same colour sits on the same line in every
// aggregate, so the global meta and the top 4 compare at a glance.
const rows = Object.keys(TOKEN)
  .filter(color => (counts[color] ?? 0) > 0)
  .map(color => {
    const value = total > 0 ? Math.min(1, counts[color] / total) : 0;
    return {
      color,
      name: t(`color.${color}`, locale),
      count: counts[color],
      width: Math.round(value * 100),
      share: percent.format(value),
      bar: `var(--color-mana-${TOKEN[color]})`,
    };
  });
---

{rows.length > 0 && (
  <section class:list={['panel p-4 sm:p-5 flex flex-col gap-3', className]}>
    <h3 class="font-heading font-bold text-base uppercase tracking-wider text-text-primary">{title}</h3>
    {/* One grid for every row (the row wrappers are display: contents), so each
        track starts and ends at the same place whatever the numbers' width. */}
    <dl class="grid grid-cols-[6.25rem_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2.5">
      {rows.map(row => (
        <div class="contents">
          <dt class="flex items-center gap-2 text-sm text-text-primary">
            <span aria-hidden="true" set:html={formatColorSymbols(row.color)} />
            {row.name}
          </dt>
          <dd class="share-bar" aria-hidden="true">
            <span class="share-bar__fill share-bar__fill--mana" style={`width: ${row.width}%; --bar: ${row.bar}`}></span>
          </dd>
          <dd class="text-sm text-right tabular-nums whitespace-nowrap">
            <strong class="font-semibold text-text-primary">{row.share}</strong>{' '}
            <span class="text-text-muted">{row.count}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="text-xs leading-relaxed text-text-muted">{t('meta.colorPresenceHelp', locale)}</p>
  </section>
)}
