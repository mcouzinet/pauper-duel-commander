---
/**
 * Deck cards grouped by type.
 *
 * Two columns from 360px up rather than one: at one column, ninety-nine cards
 * made a 12,700px page on a phone, which is the device this gets read on. Each
 * group gets a stable anchor so the contents bar above can jump into it.
 */
import { formatManaCost } from '@/lib/mana';
import { t, type Locale } from '@/lib/i18n';
import type { EnrichedCard } from '@/types/decklist';

interface Props {
  cardsByType: Record<string, EnrichedCard[]>;
  locale: Locale;
}

const { cardsByType, locale } = Astro.props;

const TYPE_LABEL_KEYS: Record<string, string> = {
  Creature: 'common.creatures',
  Instant: 'common.instants',
  Sorcery: 'common.sorceries',
  Artifact: 'common.artifacts',
  Enchantment: 'common.enchantments',
  Land: 'common.lands',
  Planeswalker: 'common.planeswalkers',
  Other: 'common.other',
};

const groups = Object.entries(cardsByType).map(([type, cards]) => ({
  type,
  anchor: `type-${type.toLowerCase()}`,
  label: t(TYPE_LABEL_KEYS[type] ?? 'common.other', locale),
  total: cards.reduce((sum, card) => sum + card.quantity, 0),
  bannedCount: cards.filter(card => card.isBanned).length,
  cards,
}));
---

<div class="space-y-8">
  {groups.map(group => (
    <section id={group.anchor}>
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-magic-gradient uppercase tracking-wider mb-3 pb-2 border-b border-brand-orange/15">
        {group.label} <span class="text-text-muted tabular-nums">({group.total})</span>
        {group.bannedCount > 0 && (
          <span class="badge badge--danger ml-2 align-middle normal-case tracking-normal">
            {group.bannedCount} {group.bannedCount === 1
              ? t('decklist.bannedCardsShortOne', locale)
              : t('decklist.bannedCardsShort', locale)}
          </span>
        )}
      </h2>

      <ul class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-0.5">
        {group.cards.map(card => (
          <li class:list={[
                'card-hover-trigger group flex items-center gap-2 py-1.5 px-1.5 -mx-1.5 rounded transition-colors cursor-pointer min-w-0',
                card.isBanned ? 'bg-red-500/8 hover:bg-red-500/15' : 'hover:bg-brand-orange/8',
              ]}
              data-card-name={card.name}
              data-card-image={card.imageUrl ?? ''}>
            <span class="text-sm font-mono text-text-muted w-4 text-right flex-shrink-0 tabular-nums">
              {card.quantity}
            </span>
            <span class:list={[
              'text-sm sm:text-base truncate flex-1 font-beleren transition-colors',
              card.isBanned
                ? 'text-red-300 line-through decoration-red-500/70'
                : 'text-text-primary group-hover:text-brand-orange',
            ]} lang="en">
              {card.name}
            </span>
            {card.isBanned && (
              <span class="badge badge--danger flex-shrink-0 uppercase tracking-wider" title={t('decklist.bannedCardTitle', locale)}>
                {t('meta.banned', locale)}
              </span>
            )}
            {card.manaCost && (
              <span class="flex-shrink-0" set:html={formatManaCost(card.manaCost)} />
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
