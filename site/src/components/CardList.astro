---
/**
 * CardList Component
 *
 * Renders deck cards grouped by type (Creature, Instant, Sorcery, etc.)
 * with mana costs displayed via mana-font icons.
 *
 * Props:
 * - cardsByType: Record<string, EnrichedCard[]> — cards grouped by primary type
 * - locale: 'fr' | 'en' — current locale for type labels
 */
import { formatManaCost } from '@/lib/mana';
import { t, type Locale } from '@/lib/i18n';
import type { EnrichedCard } from '@/types/decklist';

interface Props {
  cardsByType: Record<string, EnrichedCard[]>;
  locale: Locale;
}

const { cardsByType, locale } = Astro.props;

/** Map English type names to i18n keys. */
const TYPE_LABEL_KEYS: Record<string, string> = {
  Creature: 'common.creatures',
  Instant: 'common.instants',
  Sorcery: 'common.sorceries',
  Artifact: 'common.artifacts',
  Enchantment: 'common.enchantments',
  Land: 'common.lands',
  Planeswalker: 'common.planeswalkers',
  Other: 'common.other',
};

/** Pre-compute type totals and labels. */
const typeEntries = Object.entries(cardsByType).map(([type, cards]) => {
  const total = cards.reduce((sum, card) => sum + card.quantity, 0);
  const label = t(TYPE_LABEL_KEYS[type] ?? 'common.other', locale);
  return { type, label, total, cards };
});
---

<div>
  {typeEntries.map(({ label, total, cards }) => (
    <div class="mb-10">
      <h3 class="text-2xl font-heading font-bold text-magic-gradient uppercase tracking-wider mb-3 pb-2 border-b border-brand-orange/10">
        {label} <span class="text-text-muted">({total})</span>
      </h3>

      <div class="columns-1 md:columns-2 lg:columns-3 gap-x-4">
        {cards.map((card) => (
          <div
            class="py-1.5 px-2 hover:bg-brand-orange/5 transition-colors group relative card-hover-trigger cursor-pointer break-inside-avoid"
            data-card-name={card.name}
            data-card-image={card.imageUrl ?? ''}
          >
            <div class="flex items-center gap-3">
              {/* Quantity */}
              <span class="text-base font-mono text-text-muted w-4 text-right flex-shrink-0">
                {card.quantity}
              </span>

              {/* Card Name */}
              <span class="text-base text-text-primary group-hover:text-brand-orange transition-colors truncate flex-1 font-beleren">
                {card.name}
              </span>

              {/* Mana Cost */}
              {card.manaCost && (
                <div class="flex-shrink-0">
                  <span set:html={formatManaCost(card.manaCost)} />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
