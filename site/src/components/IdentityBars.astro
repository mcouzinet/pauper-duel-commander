---
/**
 * Players per colour identity (Dimir, Mono Rouge...), most played first.
 *
 * Was written out three times, twice on the meta page and once in the
 * tournament's MetaPanel, each with its own arithmetic. The tail folds like the
 * commander ranking's: past the first rows, identities are played once or twice.
 */
import '@/styles/results.css';
import { t, tf, localeTag, type Locale } from '@/lib/i18n';
import { colorIdentityLabel } from '@/lib/colors';
import { formatColorSymbols } from '@/lib/mana';

interface Props {
  /** Players per identity key ("BR", "C"...). */
  counts: Record<string, number>;
  locale: Locale;
  title: string;
  /** Rows shown before folding. */
  limit?: number;
  class?: string;
}

const { counts, locale, title, limit = Infinity, class: className } = Astro.props;

const sorted = Object.entries(counts)
  .filter(([, count]) => count > 0)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const total = sorted.reduce((sum, [, count]) => sum + count, 0);
const max = sorted[0]?.[1] ?? 0;
const percent = new Intl.NumberFormat(localeTag(locale), { style: 'percent', maximumFractionDigits: 0 });

const rows = sorted.map(([key, count]) => ({
  key,
  count,
  label: colorIdentityLabel(key, locale),
  symbols: formatColorSymbols(key),
  share: percent.format(total > 0 ? count / total : 0),
  width: max > 0 ? Math.round((count / max) * 100) : 0,
}));
// Folding one row behind "show the 1 other" costs more than showing it.
const shown = rows.length === limit + 1 ? limit + 1 : limit;
const head = rows.slice(0, shown);
const rest = rows.slice(shown);
---

{rows.length > 0 && (
  <section class:list={['panel p-4 sm:p-5 flex flex-col gap-3', className]}>
    <h3 class="font-heading font-bold text-base uppercase tracking-wider text-text-primary">{title}</h3>
    <ul class="flex flex-col gap-2.5" role="list">
      {head.map(row => (
        <li class="flex flex-col gap-1">
          <span class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 min-w-0 text-sm text-text-primary">
              <span class="flex-shrink-0" aria-hidden="true" set:html={row.symbols} />
              {row.label}
            </span>
            <span class="flex-shrink-0 text-sm tabular-nums whitespace-nowrap">
              <strong class="font-semibold text-text-primary">{row.share}</strong>{' '}
              <span class="text-text-muted">{row.count}</span>
            </span>
          </span>
          <span class="share-bar" aria-hidden="true">
            <span class="share-bar__fill" style={`width: ${row.width}%`}></span>
          </span>
        </li>
      ))}
    </ul>

    {rest.length > 0 && (
      <details class="group/fold">
        <summary class="cursor-pointer select-none inline-flex items-center min-h-11 text-sm font-semibold text-brand-orange hover:text-brand-orange-light transition-colors">
          <span class="group-open/fold:hidden">{tf('metaPage.showAllIdentities', locale, { n: rest.length })}</span>
          <span class="hidden group-open/fold:inline">{t('metaPage.hideAll', locale)}</span>
        </summary>
        <ul class="flex flex-col gap-1.5 mt-1 pt-3 border-t border-white/8" role="list">
          {rest.map(row => (
            <li class="flex items-center justify-between gap-3 text-sm">
              <span class="flex items-center gap-2 min-w-0 text-text-secondary">
                <span class="flex-shrink-0" aria-hidden="true" set:html={row.symbols} />
                {row.label}
              </span>
              <span class="flex-shrink-0 text-xs text-text-muted tabular-nums">{row.share} · {row.count}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}
