---
/**
 * The author's other projects, as two linked cards: Endstep Tracker and Whozic.
 * Shown on the home page (`placement="home"`, larger) and in the footer.
 *
 * Whozic has a page per language, Endstep Tracker only an English one. The utm
 * tags and `data-analytics-placement` tell which spot a visit came from.
 */
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  placement: 'home' | 'footer';
}

const { locale, placement } = Astro.props;
const large = placement === 'home';

const utm = `utm_source=pauperduelcommander&utm_medium=${placement}`;
// A Record, not a test on the locale: a new language fails the type check here.
const WHOZIC_PATH: Record<Locale, string> = { fr: '', en: 'en/', it: 'it/' };

const projects = [
  {
    id: 'endstep-tracker',
    name: 'Endstep Tracker',
    pitch: t('footer.endstepTrackerPitch', locale),
    href: `https://endstep-tracker.tolarianstudio.com/?${utm}`,
    icon: '/img/projects/endstep-tracker.png',
  },
  {
    id: 'whozic',
    name: 'Whozic',
    pitch: t('footer.whozicPitch', locale),
    href: `https://whozic.party/${WHOZIC_PATH[locale]}?${utm}`,
    icon: '/img/projects/whozic.png',
  },
];
---

<ul class:list={['grid gap-3 sm:grid-cols-2', large ? 'gap-4' : 'max-w-3xl']}>
  {projects.map(project => (
    <li>
      <a href={project.href}
         target="_blank" rel="noopener"
         data-analytics="sister_project_click"
         data-analytics-project={project.id}
         data-analytics-placement={placement}
         class:list={[
           'group flex items-center h-full rounded-lg border transition-colors hover:border-brand-orange/60',
           large ? 'gap-4 p-4 border-card-border/40 bg-bg-secondary' : 'gap-3 p-3 border-card-border/30 bg-bg-primary/40',
         ]}>
        <img src={project.icon} alt="" width="40" height="40" loading="lazy"
             class:list={['shrink-0 rounded-lg', large ? 'w-14 h-14' : 'w-10 h-10']} />
        <span class="min-w-0">
          <span class:list={[
            'flex items-center gap-1.5 font-semibold text-text-primary group-hover:text-brand-orange transition-colors',
            large ? 'text-base font-heading uppercase tracking-wide' : 'text-sm',
          ]}>
            {project.name}
            <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </span>
          <span class:list={['block text-text-secondary leading-snug mt-0.5', large ? 'text-sm' : 'text-xs']}>
            {project.pitch}
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
