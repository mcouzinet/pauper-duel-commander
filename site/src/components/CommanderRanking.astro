---
/**
 * Ranked commander list.
 *
 * The meta page inlined this row markup twice (global and top 4), so the home page
 * could not show a five-line summary without a third copy. It also had no way out:
 * the most-played commander in the format was a picture and a percentage, not a
 * link to the decks playing it.
 *
 * `limit` + `foldRest` render the tail inside a `<details>`: the page listed 68
 * commanders, 39 of them played exactly once, as one 7,500px scroll.
 *
 * Names wrap rather than truncate, so they read whole on a phone.
 *
 * No bars: shares here run from 1 to 6 %. Stretched to the leader, they drew a
 * full-width bar for 6 % beside a half bar for a colour played by half the
 * field; on a 0-100 % scale they were slivers. The printed share does the job.
 */
import '@/styles/results.css';
import { t, tf, localeTag, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { formatColorSymbols } from '@/lib/mana';
import type { CommanderStat } from '@/lib/meta';

interface Props {
  commanders: CommanderStat[];
  total: number;
  locale: Locale;
  /** Rows shown before folding. */
  limit?: number;
  /** Fold the remainder into a details element instead of dropping it. */
  foldRest?: boolean;
  /** Link each commander to its decklists. */
  linkToDecklists?: boolean;
  showTrend?: boolean;
  /** Number the rows. Off where ties are the rule, as in one tournament's ten players. */
  ranked?: boolean;
}

const {
  commanders,
  total,
  locale,
  limit = commanders.length,
  foldRest = false,
  linkToDecklists = true,
  showTrend = false,
  ranked = true,
} = Astro.props;

// Folding one row behind "show the 1 other" costs more than showing it.
const shown = foldRest && commanders.length === limit + 1 ? limit + 1 : limit;
const head = commanders.slice(0, shown);
const rest = foldRest ? commanders.slice(shown) : [];

// A commander played once among a few hundred entries rounds to "0 %", which
// reads as "never played".
const percent = new Intl.NumberFormat(localeTag(locale), { style: 'percent', maximumFractionDigits: 0 });
const share = (count: number) => {
  const value = total > 0 ? count / total : 0;
  return value > 0 && value < 0.005 ? `< ${percent.format(0.01)}` : percent.format(value);
};

/** Decklists filtered to this commander; the index reads ?commander= on load. */
function decklistHref(name: string): string {
  return `${route('decklists', locale)}?commander=${encodeURIComponent(name)}`;
}
---

{/* Banned rows carry no row-level opacity: it diluted every token inside them
    below the contrast floor. Banned is signalled by the strikethrough, the badge
    and the greyscale art instead. */}
<ol class="rank-list" role="list">
  {head.map(commander => {
    const href = linkToDecklists ? decklistHref(commander.mainName) : null;
    return (
      <li>
        <div class="rank-row">
          {ranked && (
            <span class:list={['medal', commander.rank <= 3 && `medal--${commander.rank}`]} aria-hidden="true">{commander.rank}</span>
          )}

          {commander.image ? (
            <span class:list={['rank-row__art card-hover-trigger', commander.isBanned && 'grayscale']}
                  data-card-name={commander.mainName}
                  data-card-image={commander.cardImage ?? commander.image}>
              <img src={commander.image} alt="" width="56" height="56"
                   class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </span>
          ) : (
            <span class="rank-row__art" aria-hidden="true"></span>
          )}

          <span class="flex-1 min-w-0">
            <span class="flex items-start justify-between gap-3">
              <span class="min-w-0">
                {href ? (
                  <a href={href} lang="en"
                     data-analytics="meta_commander_click"
                     data-analytics-commander={commander.mainName}
                     class:list={['rank-row__name', commander.isBanned && 'line-through decoration-red-500/70']}>{commander.mainName}</a>
                ) : (
                  <span lang="en" class:list={['rank-row__name', commander.isBanned && 'line-through decoration-red-500/70']}>{commander.mainName}</span>
                )}
                {commander.partnerName && (
                  <span lang="en" class:list={[
                    'block font-beleren text-sm leading-snug text-text-secondary',
                    commander.isBanned && 'line-through decoration-red-500/70',
                  ]}>+ {commander.partnerName}</span>
                )}
              </span>
              <span class="flex-shrink-0 pt-0.5 font-heading font-bold text-lg leading-none text-text-primary tabular-nums">{share(commander.count)}</span>
            </span>

            {/* Its own line, not beside the name: Beleren arrives after the first
                paint and is wider than its fallback, so symbols sharing the
                name's line wrapped under it once the font loaded and pushed
                every row below down. */}
            <span class="flex items-center justify-between gap-3 mt-1">
              <span class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center text-sm">
                  <span class="sr-only">{t('a11y.colors', locale)}</span>
                  <span set:html={formatColorSymbols(commander.colors)} />
                </span>
                {commander.isBanned && (
                  <span class="badge badge--danger uppercase tracking-wider">{t('meta.banned', locale)}</span>
                )}
                {showTrend && commander.trend !== null && commander.trend !== 0 && (
                  <span class:list={[
                    'inline-flex items-center gap-0.5 text-[11px] font-semibold tabular-nums',
                    commander.trend > 0 ? 'text-green-400' : 'text-text-muted',
                  ]} title={commander.trend > 0 ? t('metaPage.trendUp', locale) : t('metaPage.trendDown', locale)}>
                    {commander.trend > 0 ? '▲' : '▼'}{Math.abs(commander.trend)}
                  </span>
                )}
              </span>
              <span class="flex-shrink-0 text-xs text-text-muted tabular-nums">{commander.count}/{total}</span>
            </span>
          </span>
        </div>
      </li>
    );
  })}
</ol>

{rest.length > 0 && (
  <details class="mt-4 group/fold">
    <summary class="cursor-pointer select-none inline-flex items-center min-h-11 text-sm font-semibold text-brand-orange hover:text-brand-orange-light transition-colors"
             data-analytics="meta_expand">
      <span class="group-open/fold:hidden">{tf('metaPage.showAll', locale, { n: rest.length })}</span>
      <span class="hidden group-open/fold:inline">{t('metaPage.hideAll', locale)}</span>
    </summary>

    <ol class="grid gap-x-6 gap-y-0.5 mt-2 pt-3 border-t border-white/8 sm:grid-cols-2" role="list">
      {rest.map(commander => (
        <li class="flex items-center gap-2.5 py-1 text-sm">
          {ranked && (
            <span class="w-6 flex-shrink-0 text-right text-xs text-text-muted tabular-nums" aria-hidden="true">{commander.rank}</span>
          )}

          {commander.image ? (
            <span class:list={[
              'w-8 h-8 flex-shrink-0 overflow-hidden rounded ring-1 ring-white/10 card-hover-trigger',
              commander.isBanned && 'grayscale',
            ]}
                  data-card-name={commander.mainName}
                  data-card-image={commander.cardImage ?? commander.image}>
              <img src={commander.image} alt="" width="32" height="32"
                   class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </span>
          ) : (
            <span class="w-8 h-8 flex-shrink-0 rounded bg-bg-tertiary" aria-hidden="true"></span>
          )}

          <span class="flex-1 min-w-0 flex items-baseline justify-between gap-2">
            {linkToDecklists ? (
              <a href={decklistHref(commander.mainName)} lang="en"
                 class:list={[
                   'font-beleren leading-snug text-text-secondary hover:text-brand-orange transition-colors',
                   commander.isBanned && 'line-through decoration-red-500/70',
                 ]}>{commander.mainName}</a>
            ) : (
              <span class="font-beleren leading-snug text-text-secondary" lang="en">{commander.mainName}</span>
            )}
            <span class="flex-shrink-0 text-xs text-text-muted tabular-nums">
              {share(commander.count)} · {commander.count}
            </span>
          </span>
        </li>
      ))}
    </ol>
  </details>
)}
