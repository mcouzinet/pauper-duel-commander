---
/**
 * A tournament's standings: the first three on a podium, the others below.
 *
 * A top 8 is a ranking, not a share of anything, so it is drawn as one: the
 * winner raised in the middle and gilded, second and third on either side, each
 * card standing on a step of its height with its place written large on it.
 * Places 4 to 8 follow as compact rows (Standings), beside the podium when the
 * screen has room. Names wrap rather than truncate.
 * A pair (partners, a commander and its background) shows both cards: fanned on
 * the podium, two overlapping thumbnails in a row.
 *
 * The podium is in place order in the markup (1, 2, 3, read in that order by a
 * screen reader) and laid out 2, 1, 3 by CSS (results.css). A card links to the
 * decklist without a tab stop of its own: the "Deck" link under it is the one
 * the keyboard reaches.
 */
import '@/styles/results.css';
import { t, type Locale } from '@/lib/i18n';
import { splitCommanderName } from '@/lib/tournaments';
import Standings from './Standings.astro';

export interface Top8Entry {
  place: number;
  /** Empty when the result named no player. */
  playerName: string;
  commanderName: string;
  /** The result was published without naming the commander. */
  isUnknown: boolean;
  score: string;
  commanderImage: string | null;
  cardImage: string | null;
  /** The partner's or background's art crop and card. */
  partnerImage: string | null;
  partnerCardImage: string | null;
  decklistUrl: string | null;
  isBanned: boolean;
}

interface Props {
  entries: Top8Entry[];
  locale: Locale;
}

const { entries, locale } = Astro.props;

const places = entries.map(entry => {
  const [main, partner] = entry.isUnknown ? [entry.commanderName] : splitCommanderName(entry.commanderName);
  return { ...entry, main, partner: partner ?? null };
});
const podium = places.filter(entry => entry.place <= 3);
const rest = places.filter(entry => entry.place > 3);
---

<div class:list={['top8', rest.length > 0 && 'top8--split']}>
{podium.length > 0 && (
  <ol class:list={['podium', `podium--${Math.min(podium.length, 3)}`]} role="list">
    {podium.map(entry => {
      const Card = entry.decklistUrl ? 'a' : 'div';
      const struck = entry.isBanned && 'line-through decoration-red-500/70';
      return (
        <li class:list={['podium__step', `podium__step--${entry.place}`]}>
          <Card class:list={['podium__card', entry.partnerCardImage && 'podium__card--pair']} {...(entry.decklistUrl ? { href: entry.decklistUrl, tabindex: -1, 'aria-hidden': 'true' } : {})}>
            {entry.partnerCardImage && (
              <span class:list={['tile-face podium__partner', entry.isBanned && 'grayscale']}>
                <img src={entry.partnerCardImage} alt="" width="488" height="680" loading="lazy" decoding="async" />
              </span>
            )}
            <span class:list={['tile-face podium__main', entry.isBanned && 'grayscale']}>
              {entry.cardImage ? (
                <img src={entry.cardImage} alt="" width="488" height="680" loading="lazy" decoding="async" />
              ) : (
                <span class="tile-face__fallback" lang={entry.isUnknown ? undefined : 'en'}>{entry.main}</span>
              )}
              {entry.isBanned && <span class="tile-badge tile-badge--banned">{t('meta.banned', locale)}</span>}
            </span>
          </Card>
          {entry.isUnknown ? (
            <span class="mt-1 text-sm italic text-text-muted">{entry.main}</span>
          ) : (
            <span lang="en" class:list={['podium__name', struck]}>
              {entry.main}
              {entry.partner && <span class="block text-xs sm:text-sm text-text-secondary">+ {entry.partner}</span>}
            </span>
          )}
          {(entry.playerName || entry.score) && (
            <span class="text-xs sm:text-sm text-text-secondary">
              {entry.playerName}{entry.playerName && entry.score && ' · '}<span class="whitespace-nowrap tabular-nums">{entry.score}</span>
            </span>
          )}
          {entry.decklistUrl && (
            <a href={entry.decklistUrl} class="podium__deck">{t('tournament.deck', locale)}{' '}<span aria-hidden="true">›</span></a>
          )}
          <span class="podium__base" aria-hidden="true"><span class="podium__rank">{entry.place}</span></span>
        </li>
      );
    })}
  </ol>
)}

<Standings entries={rest} locale={locale} class="standings" />
</div>
