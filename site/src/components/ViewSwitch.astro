---
/**
 * List / visual switch for a ranking or a top 8 (results.css).
 *
 * The choice is remembered per scope (`pdc:view:<scope>`) and applied to
 * <html data-view> by the inline script below, which runs where the switch
 * sits, above the list it controls: a returning visitor never sees the list
 * flip. view-switch.ts wires the buttons. Hidden without JavaScript.
 */
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  /** Storage key and analytics event prefix: one per kind of list. */
  scope: string;
  /** Icons only on a phone, where the switch shares its line with other controls. */
  compact?: boolean;
  class?: string;
}

const { locale, scope, compact = false, class: className } = Astro.props;
const label = compact ? 'max-sm:sr-only' : undefined;

const prepaint = `try{if(localStorage.getItem(${JSON.stringify(`pdc:view:${scope}`)})==='visual')document.documentElement.dataset.view='visual'}catch(e){}`;
---
<script is:inline set:html={prepaint} />
<div class:list={['inline-flex gap-0.5 p-[3px] rounded-lg bg-bg-secondary border border-white/10', className]}
     role="group" aria-label={t('decklist.viewLabel', locale)} data-view-switch={scope} data-needs-js>
  <button type="button" class="view-toggle" data-view-option="list" aria-pressed="true"
          data-analytics={`${scope}_display`} data-analytics-view="list">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
    <span class={label}>{t('decklist.viewList', locale)}</span>
  </button>
  <button type="button" class="view-toggle" data-view-option="visual" aria-pressed="false"
          data-analytics={`${scope}_display`} data-analytics-view="visual">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="9" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
    <span class={label}>{t('decklist.viewVisual', locale)}</span>
  </button>
</div>

<script src="@/scripts/view-switch.ts"></script>
