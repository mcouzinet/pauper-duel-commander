---
/**
 * Community.
 *
 * "I want to play PDC — where are the players?" had no answer anywhere on the
 * site: the Discord link existed on the home page and nowhere else, there was no
 * list of venues, and nothing told a store or a club how to run an event.
 *
 * The venue list is derived from the tournaments already published, so it grows
 * on its own and never claims a scene that does not exist.
 */
import Base from '@/layouts/Base.astro';
import DiscordCta from '@/components/DiscordCta.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { submissionsEnabled } from '@/lib/features';
import { getAllTournaments, getUpcomingTournaments, formatDate } from '@/lib/tournaments';
import { getBanlistDate, formatBanlistDate, getAnnouncements } from '@/lib/banlist';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [all, upcoming, announcements, banlistDate] = await Promise.all([
  getAllTournaments(),
  getUpcomingTournaments(),
  getAnnouncements(),
  getBanlistDate(),
]);

/**
 * Venues, from the events that actually happened there. Sorted by how many
 * tournaments each has hosted, then by recency.
 */
interface Venue {
  name: string;
  city: string;
  count: number;
  lastDate: string;
  lastSlug: string;
}

const venues: Venue[] = [...all
  .reduce((map, tournament) => {
    const name = tournament.location || tournament.city;
    if (!name) return map;
    const existing = map.get(name);
    if (existing) {
      existing.count++;
      if (tournament.date > existing.lastDate) {
        existing.lastDate = tournament.date;
        existing.lastSlug = tournament.slug;
      }
    } else {
      map.set(name, {
        name,
        city: tournament.city,
        count: 1,
        lastDate: tournament.date,
        lastSlug: tournament.slug,
      });
    }
    return map;
  }, new Map<string, Venue>())
  .values()]
  .sort((a, b) => b.count - a.count || b.lastDate.localeCompare(a.lastDate));

const past = all
  .filter(tournament => tournament.top8.length > 0)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const title = t('community.seoTitle', locale);
---
<Base title={title} description={t('community.subtitle', locale)} bareTitle={false}>

  <section class="page-head">
    <div class="page-head__bg"></div>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none">
      <img src="/img/hero-background.webp" alt="" aria-hidden="true"
           width="1280" height="993" class="w-full h-full object-cover" />
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-4xl">
        <Breadcrumb locale={locale} items={[{ label: t('community.title', locale) }]} />

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-magic-gradient mt-3 mb-3">
          {t('community.title', locale)}
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl mb-5">
          {t('community.subtitle', locale)}
        </p>

        <div class="flex flex-wrap items-center gap-2">
          <span class="stat-pill"><strong>{all.length}</strong> {t('quick.tournamentsShort', locale)}</span>
          <span class="stat-pill"><strong>{venues.length}</strong> {t('common.venues', locale)}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Discord first: it is where the format lives ---------------------------->
  <section class="py-10 md:py-12">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl">
        <DiscordCta locale={locale} placement="community" showCommunityLink={false} />
      </div>
    </div>
  </section>

  <!-- Where to play ---------------------------------------------------------->
  {venues.length > 0 && (
    <section class="py-10 md:py-12 border-t border-card-border/20 bg-bg-secondary/40">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-5xl">
          <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-2">
            {t('community.venuesTitle', locale)}
          </h2>
          <p class="text-text-secondary mb-6">{t('community.venuesText', locale)}</p>

          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {venues.map(venue => (
              <li>
                <a href={route('tournaments', locale, venue.lastSlug)}
                   class="panel block p-4 no-underline hover:border-brand-orange/40 transition-colors group h-full">
                  <p class="font-heading font-bold uppercase tracking-wide text-text-primary group-hover:text-magic-gold transition-colors">
                    {venue.name}
                  </p>
                  {venue.city && venue.city !== venue.name && (
                    <p class="text-sm text-text-secondary mt-0.5">{venue.city}</p>
                  )}
                  <p class="text-xs text-text-muted mt-2">
                    <strong class="text-magic-gold">{venue.count}</strong>
                    {' '}
                    {venue.count > 1
                      ? t('community.venueTournamentsPlural', locale)
                      : t('community.venueTournaments', locale)}
                    {' · '}
                    {t('community.venueLastEvent', locale)} {formatDate(venue.lastDate, locale)}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Events ----------------------------------------------------------------->
  <section class="py-10 md:py-12 border-t border-card-border/20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl grid lg:grid-cols-2 gap-8">

        <div>
          <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-2">
            {t('community.eventsTitle', locale)}
          </h2>
          <p class="text-text-secondary mb-5">{t('community.eventsText', locale)}</p>

          {upcoming.length > 0 ? (
            <ul class="space-y-2.5">
              {upcoming.slice(0, 3).map(tournament => (
                <li>
                  <a href={route('tournaments', locale, tournament.slug)}
                     class="panel block p-4 no-underline hover:border-brand-orange/40 transition-colors group">
                    <div class="flex items-start justify-between gap-3">
                      <p class="font-heading font-bold uppercase tracking-wide text-text-primary group-hover:text-magic-gold transition-colors">
                        {tournament.title}
                      </p>
                      <span class="badge badge--orange flex-shrink-0">{formatDate(tournament.date, locale)}</span>
                    </div>
                    <p class="text-xs text-text-muted mt-1">
                      {tournament.location}{tournament.city ? `, ${tournament.city}` : ''}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="panel p-5">
              <p class="font-heading font-bold uppercase tracking-wide text-text-primary mb-2">
                {t('tournament.upcomingNone', locale)}
              </p>
              <p class="text-sm text-text-secondary leading-relaxed">
                {t('tournament.upcomingNoneText', locale)}
              </p>
            </div>
          )}

          {past.length > 0 && (
            <ul class="space-y-2 mt-4">
              {past.map(tournament => {
                const winner = tournament.top8.find(entry => entry.place === 1);
                return (
                  <li>
                    <a href={route('tournaments', locale, tournament.slug)}
                       class="flex items-baseline justify-between gap-3 px-3 py-2 rounded-lg hover:bg-bg-secondary transition-colors no-underline group">
                      <span class="text-sm text-text-secondary group-hover:text-brand-orange transition-colors truncate">
                        {tournament.title}
                        {winner && <span class="text-text-muted"> — {winner.playerName}</span>}
                      </span>
                      <span class="text-xs text-text-muted flex-shrink-0">{formatDate(tournament.date, locale)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}

          <a href={route('tournaments', locale)}
             class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors mt-4">
            {t('home.resultsCta', locale)}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="space-y-6">
          <div class="panel p-5">
            <h2 class="text-xl font-heading font-bold text-magic-gradient mb-2">
              {t('community.organiseTitle', locale)}
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed mb-4">
              {t('community.organiseText', locale)}
            </p>
            <div class="flex flex-wrap gap-2">
              <a href={route('rules', locale)} class="btn-secondary !px-4 !py-2.5 !text-sm">
                {t('nav.rules', locale)}
              </a>
              {submissionsEnabled && (
                <a href={route('submitDecklist', locale)} class="btn-secondary !px-4 !py-2.5 !text-sm">
                  {t('submit.cta', locale)}
                </a>
              )}
            </div>
          </div>

          <div class="panel p-5">
            <h2 class="text-xl font-heading font-bold text-magic-gradient mb-2">
              {t('community.committeeTitle', locale)}
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed mb-3">
              {t('community.committeeText', locale)}
            </p>
            <p class="text-xs text-text-muted mb-4">
              {t('banlist.lastUpdate', locale)} {formatBanlistDate(banlistDate, locale)}
              {announcements.length > 0 && ` — ${announcements.length} ${t('common.announcementsPublished', locale)}`}
            </p>
            <a href={`${route('banlist', locale)}#history`} class="btn-secondary !px-4 !py-2.5 !text-sm">
              {t('community.committeeCta', locale)}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
