---
/**
 * Tournament index.
 *
 * The "upcoming" section only rendered when a future event existed, so with none
 * scheduled the page looked like a dead archive rather than a live format with a
 * gap in its calendar. It also gave no way to tell the four tournaments published
 * without results from the eleven with them, and never named a winner.
 *
 * Since the decklist redesign: a compact header without the faint card art
 * (barely visible, and still the page's largest paint), and each result led by
 * its winner's commander art, so the list scans by picture as well as by name.
 */
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, tf, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { getUpcomingTournaments, getPastTournaments, formatDate, isPlaceholder } from '@/lib/tournaments';
import { getMeta } from '@/lib/meta';
import { getCardsByNames, getCardImage } from '@/lib/scryfall';
import { splitNames } from '@/lib/banlist';
import { submissionsEnabled } from '@/lib/features';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [upcoming, past, meta] = await Promise.all([
  getUpcomingTournaments(),
  getPastTournaments(),
  getMeta(),
]);

/** Venue options for the filter, ordered by how often they have hosted. */
const venues = [...past, ...upcoming]
  .reduce((map, tournament) => {
    const key = tournament.location || tournament.city;
    if (!key) return map;
    map.set(key, (map.get(key) ?? 0) + 1);
    return map;
  }, new Map<string, number>());
const venueOptions = [...venues.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const withResults = past.filter(tournament => tournament.top8.length > 0).length;

const winnerOf = (tournament: (typeof past)[number]) =>
  tournament.top8.find(entry => entry.place === 1 && !isPlaceholder(entry.commanderName)) ?? null;
const winnerCards = await getCardsByNames([
  ...new Set(past.flatMap(tournament => {
    const winner = winnerOf(tournament);
    return winner ? [splitNames(winner.commanderName)[0]] : [];
  })),
]);

/** Results shown per page. Read by the script below through `data-page-size`. */
const PAGE_SIZE = 10;

const title = t('tournament.seoTitle', locale);
const description = t('tournament.seoDescription', locale)
  .replace('%total%', String(past.length))
  .replace('%withResults%', String(withResults));
---
<Base title={title} description={description} bareTitle={false}>

  <div class="container mx-auto px-4 md:px-6 pt-5 md:pt-8">
    <Breadcrumb locale={locale} items={[{ label: t('tournament.title', locale) }]} />

    <header class="mt-4 pb-8 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-magic-gradient">{t('tournament.title', locale)}</h1>
      <p class="mt-3 text-lg leading-relaxed text-text-secondary">{t('tournament.desc', locale)}</p>

      <ul class="mt-4 flex flex-wrap gap-1.5 sm:gap-2" role="list">
        <li class="stat-pill"><strong>{past.length}</strong> {t('quick.tournamentsShort', locale)}</li>
        <li class="stat-pill"><strong>{venueOptions.length}</strong> {t('common.venues', locale)}</li>
      </ul>

      <div class="mt-5 flex flex-wrap gap-3">
        <a href={route('meta', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('home.metaCta', locale)}</a>
        {submissionsEnabled && (
          <a href={route('submitTournament', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
            {t('submitTournament.cta', locale)}
          </a>
        )}
      </div>
    </header>
  </div>

  <!-- Upcoming: always present, with a real empty state ---------------------->
  <section class="py-8 md:py-10 border-t border-white/8" aria-labelledby="tournaments-upcoming">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl">
        <div class="flex items-center gap-3 mb-4">
          <h2 id="tournaments-upcoming" class="section-title !mb-0">{t('tournament.upcoming', locale)}</h2>
          {upcoming.length > 0 && (
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-orange opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-orange"></span>
            </span>
          )}
        </div>

        {upcoming.length > 0 ? (
          <ul class="grid md:grid-cols-2 gap-4">
            {upcoming.map(tournament => (
              <li>
                <article class="panel p-5 h-full">
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <h3 class="text-lg font-heading font-bold text-text-primary">{tournament.title}</h3>
                    <span class="badge badge--orange flex-shrink-0 whitespace-nowrap">
                      {formatDate(tournament.date, locale)}
                    </span>
                  </div>

                  <dl class="space-y-1.5 text-sm text-text-secondary mb-4">
                    {tournament.location && (
                      <div class="flex items-center gap-2">
                        <dt class="sr-only">{t('tournament.filterCity', locale)}</dt>
                        <svg class="w-4 h-4 text-magic-gold/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <dd>{tournament.location}{tournament.city ? `, ${tournament.city}` : ''}</dd>
                      </div>
                    )}
                    {tournament.playerCount > 0 && (
                      <div class="flex items-center gap-2">
                        <dt class="sr-only">{t('tournament.spots', locale)}</dt>
                        <svg class="w-4 h-4 text-magic-gold/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <dd>{tournament.playerCount} {t('tournament.spots', locale)}</dd>
                      </div>
                    )}
                  </dl>

                  <div class="flex flex-wrap items-center gap-3">
                    {tournament.signupUrl && (
                      <a href={tournament.signupUrl} target="_blank" rel="noopener noreferrer"
                         data-analytics="tournament_signup_click" data-analytics-slug={tournament.slug}
                         class="btn-primary !px-5 !py-2.5 !text-sm">
                        {t('tournament.signUp', locale)}
                      </a>
                    )}
                    <a href={route('tournaments', locale, tournament.slug)}
                       class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
                      {t('tournament.moreDetails', locale)}
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                      </svg>
                    </a>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <div class="panel p-6 max-w-2xl">
            <p class="font-heading font-bold uppercase tracking-wide text-text-primary mb-2">
              {t('tournament.upcomingNone', locale)}
            </p>
            <p class="text-sm text-text-secondary leading-relaxed mb-4">
              {t('tournament.upcomingNoneText', locale)}
            </p>
            <a href={route('community', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
              {t('community.organiseTitle', locale)}
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Past results ----------------------------------------------------------->
  <section class="py-8 md:py-10 border-t border-white/8" aria-labelledby="tournaments-results">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <h2 id="tournaments-results" class="section-title !mb-0">{t('tournament.results', locale)}</h2>

          {venueOptions.length > 1 && (
            <div class="flex items-center gap-2">
              <label for="filter-venue" class="text-xs font-heading font-bold uppercase tracking-wider text-text-muted">
                {t('tournament.filterCity', locale)}
              </label>
              <select id="filter-venue"
                      class="px-3 py-2 bg-bg-primary border border-white/10 rounded-lg text-text-primary focus:border-brand-orange/60 focus:outline-none transition-colors text-sm">
                <option value="">{t('tournament.allCities', locale)}</option>
                {venueOptions.map(([venue, count]) => (
                  <option value={venue}>{venue} ({count})</option>
                ))}
              </select>
            </div>
          )}
        </div>

        {past.length > 0 ? (
          <ul class="flex flex-col gap-2.5" id="tournament-list">
            {past.map((tournament, index) => {
              const players = tournament.actualPlayerCount || tournament.playerCount;
              const winner = winnerOf(tournament);
              const winnerName = winner ? splitNames(winner.commanderName)[0] : null;
              const art = winnerName ? getCardImage(winnerCards.get(winnerName.toLowerCase()) ?? null, 'art_crop') : null;
              const hasResults = tournament.top8.length > 0;
              const decklistCount = tournament.top8.filter(entry => entry.decklistSlug).length;
              const isRecent = meta.recentSlugs.includes(tournament.slug);
              const facts = [
                formatDate(tournament.date, locale),
                [tournament.location, tournament.city].filter(Boolean).join(', '),
                players > 0 ? `${players} ${t('tournament.players', locale)}` : '',
                decklistCount > 0 ? tf('tournament.decklistsCount', locale, { n: decklistCount }) : '',
              ].filter(Boolean);

              return (
                <li data-venue={tournament.location || tournament.city} class:list={[index >= PAGE_SIZE && 'is-later']}>
                  <a href={route('tournaments', locale, tournament.slug)}
                     data-analytics="tournament_view" data-analytics-slug={tournament.slug}
                     class="panel flex items-center gap-3 sm:gap-4 p-3 sm:p-4 hover:border-brand-orange/40 transition-colors no-underline group">
                    <span class="relative flex items-center justify-center w-16 h-12 sm:w-24 sm:h-[70px] flex-shrink-0 self-start overflow-hidden rounded-md bg-bg-tertiary ring-1 ring-white/10" aria-hidden="true">
                      {art ? (
                        <img src={art} alt="" width="96" height="70" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                      ) : (
                        <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      )}
                    </span>

                    <div class="flex-1 min-w-0">
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <h3 class="text-base sm:text-lg leading-tight text-text-primary group-hover:text-brand-orange transition-colors">
                          {tournament.title}
                        </h3>
                        {hasResults ? (
                          <span class="badge badge--gold">{t('tournament.resultsPublished', locale)}</span>
                        ) : (
                          <span class="badge badge--muted">{t('tournament.resultsPending', locale)}</span>
                        )}
                        {isRecent && <span class="badge badge--new">{t('archive.shelfNew', locale)}</span>}
                      </div>

                      <p class="mt-1 text-xs sm:text-sm text-text-muted">{facts.join(' · ')}</p>

                      {winner && winnerName && (
                        <p class="mt-1.5 text-sm text-text-secondary">
                          <span class="font-semibold text-magic-gold">{t('tournament.winner', locale)}</span>{' '}
                          <span class="font-beleren text-text-primary" lang="en">{winnerName}</span>
                          {!isPlaceholder(winner.playerName) && <>{' · '}{winner.playerName}</>}
                        </p>
                      )}
                    </div>

                    <svg class="hidden sm:block w-5 h-5 flex-shrink-0 text-text-muted group-hover:text-brand-orange group-hover:translate-x-1 transition duration-300"
                         fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                    </svg>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="text-center py-12">
            <h3 class="text-xl font-heading font-bold text-text-primary mb-3">{t('tournament.noYet', locale)}</h3>
            <p class="text-text-secondary">{t('tournament.resultsComing', locale)}</p>
          </div>
        )}

        <p id="tournament-empty" class="hidden text-center py-10 text-text-secondary">
          {t('tournament.noneForFilter', locale)}
        </p>

        {/* Hidden until the script decides there is more than one page, so the
            list reads whole with no JavaScript instead of stopping at ten. */}
        {past.length > 0 && (
          <nav id="tournament-pager" data-page-size={PAGE_SIZE} hidden
               aria-label={t('tournament.results', locale)}
               class="mt-6 flex items-center justify-center gap-3">
            <button type="button" id="tournament-prev" class="btn-secondary !px-4 !py-2 !text-sm">
              {t('archive.paginationPrevious', locale)}
            </button>
            <span id="tournament-pager-status" aria-live="polite"
                  class="text-sm font-mono tabular-nums text-text-muted min-w-16 text-center"></span>
            <button type="button" id="tournament-next" class="btn-secondary !px-4 !py-2 !text-sm">
              {t('archive.paginationNext', locale)}
            </button>
          </nav>
        )}
      </div>
    </div>
  </section>

  <script>
    /**
     * Venue filter and pagination, in one pass.
     *
     * The whole list is in the HTML: it reads complete without JavaScript and
     * stays crawlable, and paging is applied on top rather than fetched. That
     * also keeps the filter honest — server-side pages would only ever filter
     * the ten rows on screen, so "Artefacts (7)" could return three.
     *
     * Both concerns write the same `hidden` flag, so they share one render
     * instead of overwriting each other.
     */
    const venue = document.getElementById('filter-venue') as HTMLSelectElement | null;
    const list = document.getElementById('tournament-list');
    const empty = document.getElementById('tournament-empty');
    const pager = document.getElementById('tournament-pager');
    const prev = document.getElementById('tournament-prev') as HTMLButtonElement | null;
    const next = document.getElementById('tournament-next') as HTMLButtonElement | null;
    const status = document.getElementById('tournament-pager-status');

    const perPage = Number(pager?.dataset.pageSize) || 10;
    let page = 1;

    function render() {
      if (!list) return;
      const items = [...list.children] as HTMLElement[];
      const wanted = venue?.value ?? '';
      const matching = items.filter(item => !wanted || item.dataset.venue === wanted);

      const pageCount = Math.max(1, Math.ceil(matching.length / perPage));
      page = Math.min(page, pageCount);
      const start = (page - 1) * perPage;

      for (const item of items) item.hidden = true;
      for (const item of matching.slice(start, start + perPage)) item.hidden = false;

      empty?.classList.toggle('hidden', matching.length > 0);
      if (pager) pager.hidden = matching.length <= perPage;
      if (status) status.textContent = `${page} / ${pageCount}`;
      if (prev) prev.disabled = page === 1;
      if (next) next.disabled = page === pageCount;
    }

    function turn(by: number) {
      page += by;
      render();
      // Page 2 starting mid-scroll would look like rows vanished.
      list?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    venue?.addEventListener('change', () => {
      page = 1;
      render();
      window.pdcTrack?.('tournament_filter', { venue: venue.value });
    });
    prev?.addEventListener('click', () => turn(-1));
    next?.addEventListener('click', () => turn(1));

    render();
    if (list) list.dataset.ready = '';
  </script>

  <style is:global>
    /* Rows past the first page, hidden from the first layout when the pager
       will run: laid out even for the instant before it does, their lazy
       thumbnails were already close enough to the viewport to download. */
    html.js #tournament-list:not([data-ready]) > .is-later {
      display: none;
    }
  </style>
</Base>
