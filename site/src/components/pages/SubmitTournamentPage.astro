---
/**
 * Tournament submission form — organizers (shared by the three locales).
 *
 * Posts JSON to /api/submit-tournament.php, which opens a moderated PR carrying
 * the tournament plus one decklist file per top-8 player who provided a legal
 * list. The live check reuses /api/validate-deck.php, one call per filled
 * decklist, so an organizer sees what would be rejected before submitting.
 *
 * The eight places are all rendered server-side and progressively revealed
 * rather than cloned from a template: blank rows are dropped by the API, so a
 * top 4 simply leaves the rest empty.
 *
 * Sections use `panel`, not `magic-card` — they are containers, not clickable
 * objects, and the orange accent keeps its meaning that way.
 */
import Base from '@/layouts/Base.astro';
import { t, messagesFor, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { submissionsEnabled } from '@/lib/features';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const msgs = messagesFor(locale);

// Client-side strings + the validator's rule labels (for the legality display).
const jsBlob = { ...msgs.submitTournament.js, rules: msgs.js };

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';

const PLACES = [1, 2, 3, 4, 5, 6, 7, 8];
/** Places visible before the organizer asks for more — a top 4 is the common case. */
const VISIBLE = 4;

const fieldClass =
  'w-full px-4 py-3 bg-bg-secondary border border-white/10 rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand-orange/50';
const labelClass =
  'block font-heading font-bold text-text-primary uppercase tracking-wide mb-2 text-sm';
const sectionTitleClass =
  'font-heading font-bold uppercase tracking-wider text-magic-gold mb-4 text-lg';
---
<Base title={t('submitTournament.title', locale)} description={t('submitTournament.subtitle', locale)}>

  <!-- Hero -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="container mx-auto px-4 sm:px-6 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl sm:text-5xl font-heading font-bold text-magic-gradient mb-6">{t('submitTournament.title', locale)}</h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">{t('submitTournament.subtitle', locale)}</p>
      </div>
    </div>
  </section>

  {!submissionsEnabled && (
    <section class="py-24 bg-bg-primary">
      <div class="container mx-auto px-6 text-center">
        <p class="text-lg text-text-secondary">{t('submit.comingSoon', locale)}</p>
      </div>
    </section>
  )}

  {submissionsEnabled && (
  <Fragment>
  <section class="py-16 bg-bg-primary">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <form id="st-form" class="space-y-6">

          <!-- Organizer gate -->
          <div class="panel border-magic-gold/40 p-6 sm:p-8">
            <h2 class={sectionTitleClass}>{t('submitTournament.accessSection', locale)}</h2>
            <label for="st-code" class={labelClass}>
              {t('submitTournament.accessCode', locale)} <span class="text-brand-orange">*</span>
            </label>
            <input type="password" id="st-code" name="accessCode" required autocomplete="off"
              placeholder={t('submitTournament.accessCodePlaceholder', locale)} class={fieldClass} />
            <p class="text-xs text-text-muted mt-1">{t('submitTournament.accessCodeHelp', locale)}</p>
          </div>

          <!-- Tournament -->
          <div class="panel p-6 sm:p-8">
            <h2 class={sectionTitleClass}>{t('submitTournament.tournamentSection', locale)}</h2>
            <p class="text-xs text-text-muted mb-5">{t('submitTournament.resultsOnly', locale)}</p>

            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="st-title" class={labelClass}>
                  {t('submitTournament.name', locale)} <span class="text-brand-orange">*</span>
                </label>
                <input type="text" id="st-title" name="title" required
                  placeholder={t('submitTournament.namePlaceholder', locale)} class={fieldClass} />
              </div>
              <div>
                <label for="st-date" class={labelClass}>
                  {t('submitTournament.date', locale)} <span class="text-brand-orange">*</span>
                </label>
                <input type="date" id="st-date" name="date" required class={fieldClass} />
              </div>
            </div>

            <div class="grid sm:grid-cols-3 gap-6 mt-6">
              <div>
                <label for="st-location" class={labelClass}>{t('submitTournament.location', locale)}</label>
                <input type="text" id="st-location" name="location"
                  placeholder={t('submitTournament.locationPlaceholder', locale)} class={fieldClass} />
              </div>
              <div>
                <label for="st-city" class={labelClass}>{t('submitTournament.city', locale)}</label>
                <input type="text" id="st-city" name="city"
                  placeholder={t('submitTournament.cityPlaceholder', locale)} class={fieldClass} />
              </div>
              <div>
                <label for="st-participants" class={labelClass}>{t('submitTournament.participants', locale)}</label>
                <input type="number" id="st-participants" name="participants" min="0" max="10000" class={fieldClass} />
                <p class="text-xs text-text-muted mt-1">{t('submitTournament.participantsHelp', locale)}</p>
              </div>
            </div>
          </div>

          <!-- Top 8 -->
          <div class="panel p-6 sm:p-8">
            <h2 class={sectionTitleClass}>{t('submitTournament.top8Section', locale)}</h2>
            <p class="text-xs text-text-muted mb-5">{t('submitTournament.top8Help', locale)}</p>

            {PLACES.map((place) => (
              <div class:list={['st-row rounded-lg border border-white/10 bg-bg-primary/40 p-4 mb-3', place > VISIBLE && 'hidden']}
                data-place={place}>
                <div class="flex gap-4 items-start">
                  <div class="font-heading font-bold text-magic-gold text-2xl w-8 text-center pt-8 shrink-0 tabular-nums">{place}</div>
                  <div class="flex-1 min-w-0">
                    <div class="grid sm:grid-cols-[1fr_1fr_auto] gap-4">
                      <div>
                        <label for={`st-player-${place}`} class={labelClass}>{t('submitTournament.player', locale)}</label>
                        <input type="text" id={`st-player-${place}`} data-f="player" class={fieldClass} />
                      </div>
                      <div>
                        <label for={`st-commander-${place}`} class={labelClass}>{t('submitTournament.commander', locale)}</label>
                        <input type="text" id={`st-commander-${place}`} data-f="commander" class={fieldClass} />
                      </div>
                      <div class="sm:w-28">
                        <label for={`st-score-${place}`} class={labelClass}>{t('submitTournament.score', locale)}</label>
                        <input type="text" id={`st-score-${place}`} data-f="score" placeholder="4-0" class={fieldClass} />
                      </div>
                    </div>
                    <p class="text-xs text-text-muted mt-1">{t('submitTournament.commanderHelp', locale)}</p>

                    <details class="mt-3">
                      <summary class="cursor-pointer text-sm text-text-secondary hover:text-brand-orange transition-colors">
                        {t('submitTournament.decklistToggle', locale)}
                      </summary>
                      <textarea data-f="decklist" rows="10" placeholder={"1 Command Tower\n1 Lightning Bolt\n…"}
                        class={`${fieldClass} font-mono text-xs mt-2`}></textarea>
                      <p class="text-xs text-text-muted mt-1">{t('submitTournament.decklistHelp', locale)}</p>
                    </details>

                    <div data-f="status" class="hidden mt-2 text-sm"></div>
                  </div>
                </div>
              </div>
            ))}

            <button type="button" id="st-add-place"
              class="w-full rounded-lg border border-dashed border-white/20 text-brand-orange py-3 hover:border-brand-orange/50 hover:bg-brand-orange/5 transition-colors">
              + {t('submitTournament.addPlace', locale)}
            </button>
          </div>

          <!-- Metagame -->
          <div class="panel p-6 sm:p-8">
            <h2 class={sectionTitleClass}>{t('submitTournament.metaSection', locale)}</h2>
            <p class="text-xs text-text-muted mb-4">{t('submitTournament.metaHelp', locale)}</p>
            <textarea id="st-meta" name="meta" rows="6" placeholder={"2 Baleful Strix\n1 Sphinx of the Guildpact\n…"}
              class={fieldClass}></textarea>
          </div>

          <!-- Honeypot: must stay empty. Hidden from humans. -->
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <!-- Global result -->
          <div id="st-result" class="hidden"></div>

          <div class="cf-turnstile" data-sitekey={siteKey}></div>

          <div class="flex flex-wrap gap-4 items-center">
            <button type="button" id="st-check" class="btn-secondary">{t('submitTournament.checkBtn', locale)}</button>
            <button type="submit" id="st-submit" class="btn-primary">{t('submitTournament.submitBtn', locale)}</button>
          </div>

          <p class="text-xs text-text-muted">{t('submitTournament.moderationNote', locale)}</p>
        </form>

        <!-- Success panel (revealed after submit) -->
        <div id="st-success" class="hidden panel p-8 text-center">
          <div class="w-16 h-16 rounded-full bg-green-500/10 border border-green-500/30 flex items-center justify-center mx-auto mb-5 text-3xl text-green-400">✓</div>
          <h2 class="text-2xl font-heading font-bold text-text-primary mb-3">{t('submitTournament.js.successTitle', locale)}</h2>
          <p class="text-text-secondary mb-5">{t('submitTournament.js.successBody', locale)}</p>
          <ol class="text-left text-sm text-text-secondary bg-bg-secondary border border-white/10 rounded-lg p-4 space-y-1 max-w-md mx-auto mb-6">
            <li>1. {t('submitTournament.js.successStep1', locale)}</li>
            <li>2. {t('submitTournament.js.successStep2', locale)}</li>
            <li>3. {t('submitTournament.js.successStep3', locale)}</li>
          </ol>
          <div id="st-partial" class="hidden text-left text-sm bg-bg-secondary border border-amber-500/30 rounded-lg p-4 max-w-md mx-auto mb-6"></div>
          <a href={route('tournaments', locale)} class="btn-primary">{t('submitTournament.js.backToTournaments', locale)}</a>
        </div>
      </div>
    </div>
  </section>

  <script id="submit-tournament-i18n" type="application/json" set:html={JSON.stringify(jsBlob)} />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

  <script>
    const i18n = JSON.parse(document.getElementById('submit-tournament-i18n')?.textContent ?? '{}');
    const RULE: Record<string, string> = {
      format: i18n.rules.ruleFormat, commander: i18n.rules.ruleCommander,
      commander_type: i18n.rules.ruleCommanderType, commander_rarity: i18n.rules.ruleCommanderRarity,
      deck_size: i18n.rules.ruleDeckSize, not_found: i18n.rules.ruleNotFound,
      duplicates: i18n.rules.ruleDuplicates, rarity: i18n.rules.ruleRarity,
      color_identity: i18n.rules.ruleColorIdentity, ban_list: i18n.rules.ruleBanList,
    };

    // Every id below is rendered by this component, and the whole block only
    // ships when submissions are enabled — so the lookup is asserted non-null
    // rather than guarded at each call site.
    function $<T extends HTMLElement = HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }
    const form = $<HTMLFormElement>('st-form');
    const result = $('st-result');
    const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

    interface Row { place: number; playerName: string; commanderName: string; score: string; decklist: string }

    function rows(): HTMLElement[] {
      return Array.from(document.querySelectorAll<HTMLElement>('.st-row'));
    }

    function field<T extends HTMLElement>(row: HTMLElement, name: string): T {
      return row.querySelector(`[data-f="${name}"]`) as T;
    }

    function readRow(row: HTMLElement): Row {
      return {
        place: Number(row.dataset.place),
        playerName: field<HTMLInputElement>(row, 'player').value.trim(),
        commanderName: field<HTMLInputElement>(row, 'commander').value.trim(),
        score: field<HTMLInputElement>(row, 'score').value.trim(),
        decklist: field<HTMLTextAreaElement>(row, 'decklist').value.trim(),
      };
    }

    /** Rows the organizer actually filled in; blank ones are dropped by the API too. */
    function filledRows(): Row[] {
      return rows().map(readRow).filter((r) => r.playerName || r.commanderName || r.decklist);
    }

    function payload() {
      return {
        accessCode: $<HTMLInputElement>('st-code').value,
        title: $<HTMLInputElement>('st-title').value.trim(),
        date: $<HTMLInputElement>('st-date').value,
        location: $<HTMLInputElement>('st-location').value.trim(),
        city: $<HTMLInputElement>('st-city').value.trim(),
        participants: $<HTMLInputElement>('st-participants').value,
        top8: filledRows(),
        meta: $<HTMLTextAreaElement>('st-meta').value,
        locale: document.documentElement.lang || 'fr',
      };
    }

    function showResult(html: string, ok: boolean) {
      result.className = 'panel p-4 text-sm border ' + (ok ? 'border-green-500/30' : 'border-red-500/30');
      result.innerHTML = html;
    }

    function setRowStatus(place: number, html: string, ok: boolean) {
      const row = rows().find((r) => Number(r.dataset.place) === place);
      if (!row) return;
      const box = field<HTMLElement>(row, 'status');
      box.className = 'mt-2 text-sm ' + (ok ? 'text-green-400' : 'text-red-400');
      box.innerHTML = html;
    }

    // Reveal the hidden places one at a time.
    $('st-add-place').addEventListener('click', () => {
      const hidden = rows().find((r) => r.classList.contains('hidden'));
      if (hidden) hidden.classList.remove('hidden');
      if (!rows().some((r) => r.classList.contains('hidden'))) {
        $('st-add-place').classList.add('hidden');
      }
    });

    function ruleErrors(errors: { rule?: string; cards?: string[] }[]): string {
      return errors
        .map((e) => {
          let html = esc(RULE[e.rule ?? ''] || e.rule || '');
          if (e.cards && e.cards.length) {
            html += ' <span class="text-text-muted font-mono text-xs">' + e.cards.map(esc).join(', ') + '</span>';
          }
          return html;
        })
        .join('<br>');
    }

    // Live legality pass — one validator call per filled decklist.
    $('st-check').addEventListener('click', async () => {
      const withLists = filledRows().filter((r) => r.decklist);
      if (!withLists.length) { showResult(esc(i18n.noDecklists), false); return; }

      showResult(esc(i18n.checking), true);
      let allLegal = true;

      for (const row of withLists) {
        const [commander, partner] = row.commanderName.split(/\s+\/\/\s+/);
        try {
          const body = new URLSearchParams({
            commander: commander ?? '',
            partner: partner ?? '',
            decklist: row.decklist,
            locale: document.documentElement.lang || 'fr',
          });
          const res = await fetch('/api/validate-deck.php', { method: 'POST', body });
          const data = await res.json();
          if (!res.ok || !data.success) { setRowStatus(row.place, esc(i18n.errServer), false); allLegal = false; continue; }
          if (data.data.is_valid) {
            setRowStatus(row.place, esc(i18n.legalOk), true);
          } else {
            setRowStatus(row.place, ruleErrors(data.data.errors || []), false);
            allLegal = false;
          }
        } catch {
          setRowStatus(row.place, esc(i18n.errServer), false);
          allLegal = false;
        }
      }

      showResult(
        '<span class="' + (allLegal ? 'text-green-400' : 'text-red-400') + ' font-semibold">'
          + esc(allLegal ? i18n.allLegal : i18n.someIllegal) + '</span>',
        allLegal
      );
    });

    /** Decklists the API left out: the tournament landed, these did not. */
    function renderPartial(rejected: { place: number; playerName: string; reason: string }[]) {
      if (!rejected.length) return;
      const box = $('st-partial');
      let html = '<p class="text-amber-400 font-semibold mb-2">' + esc(i18n.partial) + '</p><ul class="space-y-1">';
      for (const r of rejected) {
        const why = r.reason === 'not_checked' ? i18n.partialUnchecked : i18n.partialInvalid;
        html += '<li class="text-text-secondary">' + esc(i18n.place) + ' ' + esc(r.place)
          + ' (' + esc(r.playerName) + ') — ' + esc(why) + '</li>';
      }
      box.innerHTML = html + '</ul>';
      box.classList.remove('hidden');
    }

    // Submit -> opens a moderated PR.
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const data = payload();
      if (!data.accessCode) { showResult(esc(i18n.needCode), false); return; }
      if (!data.title) { showResult(esc(i18n.needTitle), false); return; }
      if (!data.date) { showResult(esc(i18n.needDate), false); return; }
      const token = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value || '';
      if (!token) { showResult(esc(i18n.needCaptcha), false); return; }

      const btn = $<HTMLButtonElement>('st-submit');
      btn.disabled = true;
      const label = btn.textContent; btn.textContent = i18n.sending;
      try {
        const res = await fetch('/api/submit-tournament.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, website: '', 'cf-turnstile-response': token }),
        });
        const body = await res.json().catch(() => ({}));
        if (res.status === 200 && body.success) {
          form.classList.add('hidden');
          $('st-success').classList.remove('hidden');
          renderPartial(body.rejected || []);
          return;
        }
        // 422 carries a stable code, not prose, so the reason reads in the
        // organizer's language rather than the API's.
        const formError = (i18n.formErrors ?? {})[body.reason] || i18n.errForm;
        const map: Record<number, string> = {
          400: i18n.errUnexpected, 403: body.error === 'access_code' ? i18n.errCode : i18n.errCaptcha,
          413: i18n.errUnexpected, 422: formError, 429: i18n.errRate,
        };
        showResult(esc(map[res.status] || i18n.errUnexpected), false);
        // Injected by Cloudflare's widget script, so it has no ambient type here.
        const turnstile = (window as any).turnstile;
        if (turnstile) turnstile.reset();
      } catch {
        showResult(esc(i18n.errServer), false);
      } finally {
        btn.disabled = false; btn.textContent = label;
      }
    });
  </script>
  </Fragment>
  )}
</Base>
