---
import Base from '@/layouts/Base.astro';
import RulesSummary from '@/components/RulesSummary.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, messagesFor } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { getBanlist } from '@/lib/banlist';
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const bannedCount = getBanlist().cards.length;

const description = t('validator.seoDescription', locale);
---
<Base title={t('validator.title', locale)} description={description} bareTitle={false}>

  <section class="page-head">
    <div class="page-head__bg"></div>
    <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
      <img src="/img/cards-background.webp" alt="" aria-hidden="true"
           width="1024" height="356" class="w-full h-full object-cover" />
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-4xl">
        <Breadcrumb locale={locale} items={[{ label: t('validator.title', locale) }]} />

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-magic-gradient mt-3 mb-3">
          {t('validator.title', locale)}
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl mb-5">
          {t('validator.subtitle1', locale)} <strong class="text-text-primary">{t('validator.pdc', locale)}</strong>. {t('validator.subtitle2', locale)}
        </p>

        <div class="flex flex-wrap items-center gap-2">
          <a href={route('rules', locale)} class="stat-pill no-underline hover:border-brand-orange/50 hover:text-brand-orange transition-colors">
            {t('nav.rules', locale)}
          </a>
          <a href={route('banlist', locale)} class="stat-pill no-underline hover:border-brand-orange/50 hover:text-brand-orange transition-colors">
            {t('nav.banlist', locale)} · <strong>{bannedCount}</strong>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Form section -->
  <section class="py-16 bg-bg-primary">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <div class="magic-card p-8 mb-8">
          <form id="deck-validator-form" class="space-y-6">
            <!-- Commander -->
            <div>
              <label for="commander-name" class="block font-heading font-bold text-text-primary uppercase tracking-wide mb-2">
                {t('validator.commander', locale)} <span class="text-brand-orange">*</span>
              </label>
              <input type="text" id="commander-name" name="commander" required
                     placeholder={t('validator.commanderPlaceholder', locale)}
                     class="w-full px-4 py-3 bg-bg-secondary border border-white/10 rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand-orange/50 focus:border-brand-orange/50" />
              <p class="text-xs text-text-muted mt-1">{t('validator.commanderHelp', locale)}</p>
            </div>

            <!-- Partner toggle -->
            <div>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="has-partner" class="w-4 h-4 rounded border-white/20 bg-bg-secondary text-brand-orange focus:ring-brand-orange/50" />
                <span class="text-sm text-text-secondary">{t('validator.partnerToggle', locale)}</span>
              </label>
            </div>

            <!-- Partner field (hidden by default) -->
            <div id="partner-field" class="hidden">
              <label for="partner-name" class="block font-heading font-bold text-text-primary uppercase tracking-wide mb-2">
                {t('validator.partner', locale)}
              </label>
              <input type="text" id="partner-name" name="partner"
                     placeholder={t('validator.partnerPlaceholder', locale)}
                     class="w-full px-4 py-3 bg-bg-secondary border border-white/10 rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand-orange/50 focus:border-brand-orange/50" />
              <p class="text-xs text-text-muted mt-1">{t('validator.partnerHelp', locale)}</p>
            </div>

            <!-- Decklist -->
            <div>
              <label for="decklist-input" class="block font-heading font-bold text-text-primary uppercase tracking-wide mb-2">
                Decklist <span class="text-brand-orange">*</span>
              </label>
              <textarea id="decklist-input" name="decklist" rows="18" required
                        class="w-full px-4 py-3 bg-bg-secondary border border-white/10 rounded-lg text-text-primary font-mono text-sm placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand-orange/50 focus:border-brand-orange/50 resize-y"
                        placeholder="1 Lightning Bolt&#10;1 Counterspell&#10;..."></textarea>
              <p class="text-xs text-text-muted mt-1">{t('validator.decklistFormat', locale)} <code class="text-text-primary">1 Lightning Bolt</code></p>
              <p class="text-xs text-text-muted mt-1">{t('validator.decklistHelp', locale)}</p>
            </div>

            <!-- Submit -->
            <button type="submit" id="validate-btn" class="btn-primary w-full py-4 text-lg">
              <span id="btn-text">{t('validator.submit', locale)}</span>
              <svg id="btn-spinner" class="hidden w-5 h-5 ml-2 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>
          </form>

          <!-- Results area -->
          <div id="validator-results" class="mt-8" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules: the same six cards the rules page and the home page show -->
  <section class="py-12 border-t border-card-border/25 bg-bg-secondary/40">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-4xl">
        <RulesSummary locale={locale} />
      </div>
    </div>
  </section>

  <!-- Inject translations for JS -->
  <script id="validator-i18n" type="application/json" set:html={JSON.stringify(messagesFor(locale).js)} />

  <script>
    const i18n = JSON.parse(document.getElementById('validator-i18n')?.textContent ?? '{}');
    const form = document.getElementById('deck-validator-form') as HTMLFormElement;
    const partnerCheckbox = document.getElementById('has-partner') as HTMLInputElement;
    const partnerField = document.getElementById('partner-field') as HTMLElement;
    const btnText = document.getElementById('btn-text') as HTMLElement;
    const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
    const validateBtn = document.getElementById('validate-btn') as HTMLButtonElement;
    const resultsDiv = document.getElementById('validator-results') as HTMLElement;

    // Partner toggle
    partnerCheckbox?.addEventListener('change', () => {
      partnerField?.classList.toggle('hidden', !partnerCheckbox.checked);
    });

    // Prefill from a decklist page's "check this deck" button. A 99-card list is
    // handed over through sessionStorage rather than a query string, and consumed
    // once so a later reload starts from a blank form.
    try {
      const raw = sessionStorage.getItem('pdc:prefill');
      if (raw) {
        sessionStorage.removeItem('pdc:prefill');
        const prefill = JSON.parse(raw);
        const commanderInput = document.getElementById('commander-name') as HTMLInputElement | null;
        const partnerInput = document.getElementById('partner-name') as HTMLInputElement | null;
        const decklistInput = document.getElementById('decklist-input') as HTMLTextAreaElement | null;

        if (commanderInput && prefill.commander) commanderInput.value = prefill.commander;
        if (decklistInput && prefill.decklist) {
          decklistInput.value = String(prefill.decklist).replace(/\r\n/g, '\n').trim();
        }
        if (prefill.partner && partnerCheckbox && partnerInput) {
          partnerCheckbox.checked = true;
          partnerField?.classList.remove('hidden');
          partnerInput.value = prefill.partner;
        }
      }
    } catch {
      // Storage unavailable or malformed payload: leave the form empty.
    }

    function escHtml(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function setLoading(loading: boolean) {
      validateBtn.disabled = loading;
      btnText.textContent = loading ? (i18n.btnLoading ?? 'Validation...') : (i18n.btnDefault ?? 'Valider le deck');
      btnSpinner?.classList.toggle('hidden', !loading);
    }

    const RULE_LABELS: Record<string, string> = {
      format: i18n.ruleFormat, commander: i18n.ruleCommander,
      commander_type: i18n.ruleCommanderType, commander_rarity: i18n.ruleCommanderRarity,
      deck_size: i18n.ruleDeckSize, not_found: i18n.ruleNotFound,
      duplicates: i18n.ruleDuplicates, rarity: i18n.ruleRarity,
      color_identity: i18n.ruleColorIdentity, ban_list: i18n.ruleBanList,
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const commander = (document.getElementById('commander-name') as HTMLInputElement)?.value?.trim();
      const partner = partnerCheckbox?.checked ? (document.getElementById('partner-name') as HTMLInputElement)?.value?.trim() : '';
      const decklist = (document.getElementById('decklist-input') as HTMLTextAreaElement)?.value?.trim();

      if (!commander) { renderError(i18n.errorNoCommander); return; }
      if (!decklist) { renderError(i18n.errorNoDecklist); return; }

      setLoading(true);
      try {
        const body = new URLSearchParams({
          commander,
          partner: partner ?? '',
          decklist,
          // The endpoint answers in French unless told otherwise; the EN page used
          // to render English rule labels around French sentences.
          locale: document.documentElement.lang || 'fr',
        });
        const res = await fetch('/api/validate-deck.php', { method: 'POST', body });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (!data.success) { renderError(data.data?.message ?? i18n.errorUnexpected); return; }
        window.pdcTrack?.('validator_submit', {
          is_valid: Boolean(data.data?.is_valid),
          error_count: data.data?.errors?.length ?? 0,
        });
        renderResults(data.data);
      } catch (err: any) {
        renderError(i18n.errorServer ?? 'Server error');
      } finally {
        setLoading(false);
      }
    });

    function renderError(msg: string) {
      resultsDiv.innerHTML = `<div class="magic-card border-red-500/30 p-6"><p class="text-red-400 font-semibold">${escHtml(msg)}</p></div>`;
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function renderResults(result: any) {
      const color = result.is_valid ? 'green' : 'red';
      const title = result.is_valid ? (i18n.resultValid ?? 'Valid!') : (i18n.resultInvalid ?? 'Invalid');
      const msg = result.is_valid ? (i18n.resultValidMsg ?? '') : ((i18n.resultInvalidMsg ?? '').replace('%count%', result.errors?.length ?? 0));

      let html = `<div class="magic-card border-${color}-500/30 p-6 space-y-4">`;
      html += `<div class="flex items-center gap-3"><span class="text-${color}-400 text-2xl font-bold">${result.is_valid ? '✓' : '✗'}</span>`;
      html += `<div><h3 class="text-lg font-heading font-bold text-${color}-400">${escHtml(title)}</h3>`;
      html += `<p class="text-sm text-text-secondary">${escHtml(msg)}</p></div></div>`;

      if (result.stats) {
        html += `<div class="flex gap-4 text-sm text-text-muted"><span>${result.stats.total_cards} ${i18n.statsTotal ?? 'cards'}</span><span>${result.stats.unique_cards} ${i18n.statsUnique ?? 'unique'}</span></div>`;
      }

      if (result.errors?.length) {
        for (const err of result.errors) {
          html += `<div class="border-l-2 border-red-500/30 pl-4"><p class="text-sm font-semibold text-red-400">${escHtml(RULE_LABELS[err.rule] ?? err.rule)}</p>`;
          html += `<p class="text-xs text-text-secondary mt-1">${escHtml(err.message)}</p>`;
          if (err.cards?.length) {
            html += `<div class="mt-2 font-mono text-xs text-text-muted space-y-0.5">${err.cards.map((c: string) => `<div>${escHtml(c)}</div>`).join('')}</div>`;
          }
          html += `</div>`;
        }
      }

      if (result.warnings?.length) {
        for (const w of result.warnings) {
          html += `<div class="bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-3 text-sm text-yellow-400">${escHtml(w)}</div>`;
        }
      }

      html += `</div>`;
      resultsDiv.innerHTML = html;
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</Base>
