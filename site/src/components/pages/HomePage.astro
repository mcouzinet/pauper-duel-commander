---
import Base from '@/layouts/Base.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<Base title={t('home.title', locale)} description={t('home.description', locale)}>

  <!-- Hero (M02) -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="absolute inset-0 opacity-5">
      <img src="/img/hero-background.jpg" alt="" aria-hidden="true" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/4 left-10 w-64 h-64 bg-brand-orange/20 rounded-full blur-[100px] animate-float"></div>
      <div class="absolute bottom-1/4 right-10 w-80 h-80 bg-magic-gold/20 rounded-full blur-[120px] animate-float" style="animation-delay: -3s;"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center max-w-5xl mx-auto animate-fade-in">
        <div class="inline-block mb-10">
          <span class="px-6 py-3 glass-effect border border-magic-purple/30 rounded-full text-magic-gold text-sm font-heading font-semibold tracking-wider uppercase shadow-card">
            {t('home.rejoinsNous', locale)}
          </span>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-heading font-bold mb-8 leading-tight">
          <span class="block text-text-primary mb-2">{t('home.rejoinsLaCommunaut', locale)}</span>
          <span class="block text-magic-gradient">Pauper Duel Commander</span>
        </h1>

        <div class="text-xl md:text-2xl text-text-secondary mb-14 max-w-3xl mx-auto" style="line-height: 32px;">
          <p>{t('home.lePauperDuelCommander', locale)}</p>
          <p class="mt-2">{t('home.spCifiquementConU', locale)}</p>
        </div>

        <div class="flex flex-wrap gap-6 justify-center items-center">
          <a href={route('banlist', locale)} class="btn-secondary">{t('home.viewBanlist', locale)}</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-bg-primary to-transparent"></div>
  </section>

  <!-- Qu'est-ce que le PDC -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary relative overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">
          {t('home.quEstCeQue', locale)}
        </h2>
        <p class="text-xl text-text-secondary max-w-3xl mx-auto leading-relaxed">
          {t('home.lesBasesDuFormat', locale)}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
          <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.2Joueurs', locale)}</h3>
          <p class="text-text-secondary leading-relaxed">
            {t('home.unDuelPurSans', locale)}
          </p>
        </div>
        <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
          <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.100Cartes', locale)}</h3>
          <p class="text-text-secondary leading-relaxed">
            {t('home.votreDeckContientExactement', locale)}
          </p>
        </div>
        <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
          <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.unCommandantAuCoeur', locale)}</h3>
          <p class="text-text-secondary leading-relaxed">
            {t('home.votreCommandantDFinit', locale)}
          </p>
        </div>
        <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
          <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.communesUniquement', locale)}</h3>
          <p class="text-text-secondary leading-relaxed">
            {t('home.queDesCommunesDans', locale)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Join the adventure - Discord CTA -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary">
    <div class="container mx-auto px-6">
      <div class="max-w-5xl mx-auto">
        <div class="glass-effect border-2 border-brand-orange/40 rounded-xl p-8 md:p-10 bg-gradient-to-br from-brand-orange/5 to-transparent">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex-1">
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-magic-gradient mb-3">
                {t('home.rejoignezLAventure', locale)}
              </h3>
              <p class="text-text-secondary text-lg leading-relaxed">
                {t('home.queVousSoyezUn', locale)}
              </p>
            </div>
            <a href="https://discord.gg/4MR2sSWdms" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-3 px-8 py-4 bg-[#5865F2] hover:bg-[#5865F2]/90 text-white font-heading font-bold rounded-lg transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl whitespace-nowrap">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>{t('home.rejoindreLeDiscord', locale)}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- À Propos -->
  <section class="py-24 relative overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">{t('home.propos', locale)}</h2>
        <p class="text-lg text-text-secondary leading-relaxed mb-12 max-w-4xl">
          {t('home.lePauperDuelCommander2', locale)}
        </p>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="magic-card p-8 group">
            <h3 class="text-2xl font-heading font-semibold text-magic-gold mb-4 group-hover:text-magic-gold-light transition-colors">{t('home.20PointDeVie', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.commeLaPlupartDes', locale)}
            </p>
          </div>
          <div class="magic-card p-8 group">
            <h3 class="text-2xl font-heading font-semibold text-magic-gold mb-4 group-hover:text-magic-gold-light transition-colors">{t('home.pur1v1Format', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.conUPourDes', locale)}
            </p>
          </div>
          <div class="magic-card p-8 group">
            <h3 class="text-2xl font-heading font-semibold text-magic-gold mb-4 group-hover:text-magic-gold-light transition-colors">{t('home.100CartesUniques', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.crEzDesDecks', locale)}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Community & Events -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary relative overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">
            {t('home.communautVNements', locale)}
          </h2>
          <p class="text-lg text-text-secondary max-w-3xl mx-auto">
            {t('home.uneCommunautGrandissanteDes', locale)}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
            <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.tournois', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.participezDesVNements', locale)}
            </p>
          </div>
          <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
            <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.communautActive', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.rejoignezDesJoueursPassionn', locale)}
            </p>
          </div>
          <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
            <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.discordRSeaux', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.restezConnectSVia', locale)}
            </p>
          </div>
          <div class="glass-effect border border-card-border rounded-xl p-8 hover:border-brand-orange/50 transition-all duration-300">
            <h3 class="text-4xl font-heading font-bold text-magic-gold mb-4">{t('home.espritCompTitif', locale)}</h3>
            <p class="text-text-secondary leading-relaxed">
              {t('home.fairPlayCompTition', locale)}
            </p>
          </div>
        </div>

        <!-- Discord CTA (bottom) -->
        <div class="glass-effect border-2 border-brand-orange/40 rounded-xl p-8 md:p-10 bg-gradient-to-br from-brand-orange/5 to-transparent">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex-1">
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-magic-gradient mb-3">
                {t('home.rejoignezLAventure2', locale)}
              </h3>
              <p class="text-text-secondary text-lg leading-relaxed">
                {t('home.queVousSoyezUn2', locale)}
              </p>
            </div>
            <a href="https://discord.gg/4MR2sSWdms" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-3 px-8 py-4 bg-[#5865F2] hover:bg-[#5865F2]/90 text-white font-heading font-bold rounded-lg transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl whitespace-nowrap">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>{t('home.rejoindreLeDiscord2', locale)}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
