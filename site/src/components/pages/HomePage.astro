---
/**
 * Home page.
 *
 * The previous version answered none of the three questions a newcomer arrives
 * with — what is this, why would I play it, how do I start — and showed no live
 * content at all: no ban list date, no tournament, no decklist, no statistic. It
 * also said the same four facts three times over.
 *
 * The rebuild is structural, not cosmetic:
 *   1. hero — what / why / one primary way in
 *   2. quick access — the four things a returning player came for
 *   3. "New here?" — a four-step path from curiosity to a first game
 *   4. the format in four numbers (replaces the three redundant sections)
 *   5. why play (five differentiators, each backed by a rule or by our own data)
 *   6. Pauper vs Duel Commander vs PDC
 *   7. the metagame right now
 *   8. recent results and upcoming events
 *   9. decks to try
 *  10. community
 *
 * Everything under 2 and 7-9 is derived from the content collections at build
 * time, so the page ages with the format instead of standing still.
 */
import Base from '@/layouts/Base.astro';
import RulesSummary from '@/components/RulesSummary.astro';
import FormatComparison from '@/components/FormatComparison.astro';
import CommanderRanking from '@/components/CommanderRanking.astro';
import DeckCard from '@/components/DeckCard.astro';
import DiscordCta from '@/components/DiscordCta.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { getMeta } from '@/lib/meta';
import { getShelves } from '@/lib/decklists';
import { getBanlistDate, formatBanlistDate, getBanlist } from '@/lib/banlist';
import { getUpcomingTournaments, getPastTournaments, formatDate } from '@/lib/tournaments';
import { colorIdentityLabel } from '@/lib/colors';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [meta, banlistDate, upcoming, past] = await Promise.all([
  getMeta(),
  getBanlistDate(),
  getUpcomingTournaments(),
  getPastTournaments(),
]);

const banlist = getBanlist();

// Shelves: two of them (winners, offbeat) are enough for a home page; the index
// page carries the full set.
const shelves = await getShelves({
  recentTournamentSlugs: meta.recentSlugs,
  originalCommanders: meta.originalCommanders,
  limit: 3,
});
const featuredDecks = [
  ...(shelves.find(s => s.key === 'performing')?.decklists ?? []),
  ...(shelves.find(s => s.key === 'original')?.decklists ?? []),
]
  // A deck can be both a winner and offbeat; show it once.
  .filter((deck, i, all) => all.findIndex(d => d.slug === deck.slug) === i)
  .slice(0, 6);

const nextEvent = upcoming[0] ?? null;
const recentResults = past.filter(tournament => tournament.top8.length > 0).slice(0, 3);
const latest = recentResults[0] ?? null;
const latestWinner = latest?.top8.find(entry => entry.place === 1) ?? null;

const topCommanders = meta.global.commanders.slice(0, 5);
const topIdentities = Object.entries(meta.global.ciCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3);

const heroImage = topCommanders.find(c => c.image)?.image ?? null;
---
<Base
  title={locale === 'fr'
    ? 'Pauper Duel Commander — le Commander compétitif en 1v1 avec des communes'
    : 'Pauper Duel Commander — competitive 1v1 Commander played with commons'}
  description={t('site.description', locale)}
  bareTitle={true}
>

  <!-- 1. Hero ---------------------------------------------------------------->
  <section class="page-head !py-14 md:!py-20">
    <div class="page-head__bg"></div>
    {heroImage && (
      <div class="absolute inset-0 opacity-[0.07] pointer-events-none">
        <img src="/img/hero-background.webp" alt="" aria-hidden="true"
             width="1280" height="993" class="w-full h-full object-cover" />
      </div>
    )}
    <div class="absolute inset-0 opacity-25 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-10 w-64 h-64 bg-brand-orange/20 rounded-full blur-[100px] animate-float"></div>
      <div class="absolute bottom-0 right-10 w-72 h-72 bg-magic-gold/20 rounded-full blur-[120px] animate-float" style="animation-delay: -3s;"></div>
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-3xl">
        <p class="eyebrow mb-4">{t('value.eyebrow', locale)}</p>

        <h1 class="font-heading font-bold leading-[0.95] mb-4">
          <span class="block text-4xl sm:text-5xl md:text-6xl text-text-primary">Pauper Duel</span>
          <span class="block text-4xl sm:text-5xl md:text-6xl text-magic-gradient">Commander</span>
        </h1>

        <p class="text-xl sm:text-2xl text-text-primary font-semibold mb-3 leading-snug">
          {t('value.tagline', locale)}
        </p>
        <p class="text-base sm:text-lg text-text-secondary mb-8 leading-relaxed max-w-2xl">
          {t('value.pitch', locale)}
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="#decouvrir" class="btn-primary"
             data-analytics="hero_cta_click" data-analytics-cta="discover">
            {t('hero.ctaPrimary', locale)}
          </a>
          <a href={route('decklists', locale)} class="btn-secondary"
             data-analytics="hero_cta_click" data-analytics-cta="decklists">
            {t('hero.ctaDecklists', locale)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Quick access ------------------------------------------------------->
  <section class="border-b border-card-border/25 bg-bg-secondary/60">
    <div class="container mx-auto px-4 md:px-6 py-6">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">

        <a href={route('banlist', locale)} class="quick-tile"
           data-analytics="quick_access_click" data-analytics-tile="banlist">
          <span class="quick-tile__label">{t('quick.banlist', locale)}</span>
          <span class="quick-tile__value">{banlist.cards.length} {t('banlist.cardCount', locale)}</span>
          <span class="quick-tile__hint">{t('quick.banlistHint', locale)} : {formatBanlistDate(banlistDate, locale)}</span>
        </a>

        {nextEvent ? (
          <a href={route('tournaments', locale, nextEvent.slug)} class="quick-tile"
             data-analytics="quick_access_click" data-analytics-tile="next_event">
            <span class="quick-tile__label">{t('quick.nextEvent', locale)}</span>
            <span class="quick-tile__value">{nextEvent.title}</span>
            <span class="quick-tile__hint">{formatDate(nextEvent.date, locale)} · {nextEvent.city}</span>
          </a>
        ) : (
          <a href={route('community', locale)} class="quick-tile"
             data-analytics="quick_access_click" data-analytics-tile="next_event_empty">
            <span class="quick-tile__label">{t('quick.nextEvent', locale)}</span>
            <span class="quick-tile__value">{t('quick.nextEventNone', locale)}</span>
            <span class="quick-tile__hint">{t('quick.nextEventHint', locale)}</span>
          </a>
        )}

        {latest && (
          <a href={route('tournaments', locale, latest.slug)} class="quick-tile"
             data-analytics="quick_access_click" data-analytics-tile="last_result">
            <span class="quick-tile__label">{t('quick.lastResult', locale)}</span>
            <span class="quick-tile__value truncate">{latest.title}</span>
            <span class="quick-tile__hint truncate">
              {latestWinner ? `${latestWinner.playerName} · ${latestWinner.commanderName.split(' // ')[0]}` : t('quick.lastResultHint', locale)}
            </span>
          </a>
        )}

        <a href={route('meta', locale)} class="quick-tile"
           data-analytics="quick_access_click" data-analytics-tile="meta">
          <span class="quick-tile__label">{t('quick.meta', locale)}</span>
          <span class="quick-tile__value">
            {meta.global.tournamentCount} {t('quick.tournamentsShort', locale)}
          </span>
          <span class="quick-tile__hint">{meta.global.total} {t('quick.metaHint', locale)}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. New here? ---------------------------------------------------------->
  <section id="decouvrir" class="py-14 md:py-16">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-2">
          {t('onboarding.title', locale)}
        </h2>
        <p class="text-text-secondary mb-8">{t('onboarding.subtitle', locale)}</p>

        <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { n: '01', key: 'step1', href: `${route('rules', locale)}#essentiel` },
            { n: '02', key: 'step2', href: route('meta', locale) },
            { n: '03', key: 'step3', href: route('decklists', locale) },
            { n: '04', key: 'step4', href: route('community', locale) },
          ].map(step => (
            <li class="step-card">
              <span class="step-card__n">{step.n}</span>
              <h3 class="font-heading font-bold uppercase tracking-wide text-text-primary">
                {t(`onboarding.${step.key}`, locale)}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed flex-1">
                {t(`onboarding.${step.key}Text`, locale)}
              </p>
              <a href={step.href}
                 data-analytics="onboarding_step_click" data-analytics-step={step.n}
                 class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors mt-1">
                {t(`onboarding.${step.key}Cta`, locale)}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 4. The format in four numbers ----------------------------------------->
  <section class="py-14 md:py-16 bg-bg-secondary/60 border-y border-card-border/25">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-8">
          {t('basics.title', locale)}
        </h2>

        <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-10">
          {['players', 'cards', 'commander', 'life'].map(key => (
            <div class="panel p-4">
              <dt class="text-2xl sm:text-3xl font-heading font-bold text-magic-gold leading-none mb-2">
                {t(`basics.${key}`, locale)}
              </dt>
              <dd class="text-sm text-text-secondary leading-snug">
                {t(`basics.${key}Text`, locale)}
              </dd>
            </div>
          ))}
        </dl>

        <RulesSummary locale={locale} as="h3" compact={true} />
        <p class="mt-5">
          <a href={route('rules', locale)}
             class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
            {t('rulesSummary.fullRuleset', locale)}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Why play ------------------------------------------------------------>
  <section class="py-14 md:py-16">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-8">
          {t('value.why', locale)}
        </h2>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {['duel', 'access', 'commanders', 'singleton', 'living'].map(key => (
            <div class="panel p-5">
              <h3 class="font-heading font-bold uppercase tracking-wide text-magic-gold mb-2">
                {t(`value.${key}Title`, locale)}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {t(`value.${key}Text`, locale)}
              </p>
            </div>
          ))}

          {/* The open-metagame claim, shown with the number that supports it. */}
          {meta.global.commanders.length > 0 && (
            <a href={route('meta', locale)} class="panel p-5 block no-underline hover:border-brand-orange/50 transition-colors">
              <h3 class="font-heading font-bold uppercase tracking-wide text-brand-orange mb-2">
                {meta.global.commanders.length} {locale === 'fr' ? 'généraux différents' : 'different commanders'}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {locale === 'fr'
                  ? `Sur ${meta.global.total} entrées joueurs relevées, le général le plus joué ne pèse que ${meta.global.commanders[0].percentage} %.`
                  : `Across ${meta.global.total} recorded player entries, the most played commander accounts for just ${meta.global.commanders[0].percentage}%.`}
              </p>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Format comparison --------------------------------------------------->
  <section class="py-14 md:py-16 bg-bg-secondary/60 border-y border-card-border/25">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-4xl mx-auto">
        <FormatComparison locale={locale} compact={true} />
      </div>
    </div>
  </section>

  <!-- 7. The metagame right now ---------------------------------------------->
  {topCommanders.length > 0 && (
    <section class="py-14 md:py-16">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-5xl mx-auto">
          <div class="flex flex-wrap items-end justify-between gap-3 mb-2">
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient">
              {t('home.metaTitle', locale)}
            </h2>
            <a href={route('meta', locale)} class="text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
              {t('home.metaCta', locale)} →
            </a>
          </div>
          <p class="text-text-secondary mb-6">{t('home.metaSubtitle', locale)}</p>

          <div class="grid lg:grid-cols-3 gap-5 items-start">
            <div class="lg:col-span-2 panel p-4">
              <CommanderRanking
                commanders={topCommanders}
                total={meta.global.total}
                locale={locale}
                showTrend={true}
              />
            </div>

            <div class="panel p-4">
              <h3 class="font-heading font-bold uppercase tracking-wide text-text-primary text-sm mb-3">
                {t('meta.ciTitle', locale)}
              </h3>
              <ul class="space-y-2.5">
                {topIdentities.map(([key, count]) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-2 mb-1">
                      <span class="text-sm text-text-primary">{colorIdentityLabel(key, locale)}</span>
                      <span class="text-xs text-text-secondary tabular-nums">
                        {count}<span class="text-text-muted">/{meta.global.total}</span>
                      </span>
                    </div>
                    <div class="h-1.5 bg-bg-primary/60 rounded-full overflow-hidden" aria-hidden="true">
                      <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold"
                           style={`width: ${Math.round((count / (topIdentities[0]?.[1] || 1)) * 100)}%`}></div>
                    </div>
                  </li>
                ))}
              </ul>
              <p class="text-xs text-text-muted mt-4 leading-relaxed">
                {t('metaPage.sample', locale)
                  .replace('%tournaments%', String(meta.global.tournamentCount))
                  .replace('%entries%', String(meta.global.total))
                  .replace('%from%', formatBanlistDate(meta.from, locale))
                  .replace('%to%', formatBanlistDate(meta.to, locale))}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 8. Results and upcoming ------------------------------------------------>
  <section class="py-14 md:py-16 bg-bg-secondary/60 border-y border-card-border/25">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-8">

        <div>
          <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
            <h2 class="text-2xl font-heading font-bold text-magic-gradient">{t('home.resultsTitle', locale)}</h2>
            <a href={route('tournaments', locale)} class="text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
              {t('home.resultsCta', locale)} →
            </a>
          </div>

          <ul class="space-y-2.5">
            {recentResults.map(tournament => {
              const winner = tournament.top8.find(entry => entry.place === 1);
              return (
                <li>
                  <a href={route('tournaments', locale, tournament.slug)}
                     class="panel block p-4 hover:border-brand-orange/40 transition-colors no-underline group">
                    <p class="font-heading font-bold uppercase tracking-wide text-text-primary group-hover:text-magic-gold transition-colors truncate">
                      {tournament.title}
                    </p>
                    <p class="text-xs text-text-muted mt-0.5">
                      {formatDate(tournament.date, locale)} · {tournament.city}
                      {(tournament.actualPlayerCount || tournament.playerCount) > 0 && (
                        <> · {tournament.actualPlayerCount || tournament.playerCount} {t('tournament.players', locale)}</>
                      )}
                    </p>
                    {winner && (
                      <p class="text-sm text-text-secondary mt-2">
                        <span class="text-magic-gold font-semibold">{t('tournament.winner', locale)}</span>
                        {' · '}{winner.playerName}
                        {' — '}<span class="font-beleren" lang="en">{winner.commanderName.split(' // ')[0]}</span>
                      </p>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-5">{t('home.upcomingTitle', locale)}</h2>

          {upcoming.length > 0 ? (
            <ul class="space-y-2.5">
              {upcoming.slice(0, 3).map(tournament => (
                <li>
                  <a href={route('tournaments', locale, tournament.slug)}
                     class="panel block p-4 hover:border-brand-orange/40 transition-colors no-underline group">
                    <div class="flex items-start justify-between gap-3">
                      <p class="font-heading font-bold uppercase tracking-wide text-text-primary group-hover:text-magic-gold transition-colors">
                        {tournament.title}
                      </p>
                      <span class="badge badge--orange flex-shrink-0">{formatDate(tournament.date, locale)}</span>
                    </div>
                    <p class="text-xs text-text-muted mt-1">
                      {tournament.location}{tournament.city ? `, ${tournament.city}` : ''}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="panel p-5">
              <p class="font-heading font-bold uppercase tracking-wide text-text-primary mb-2">
                {t('tournament.upcomingNone', locale)}
              </p>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                {t('tournament.upcomingNoneText', locale)}
              </p>
              <a href={route('community', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
                {t('home.communityCta', locale)}
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Decks to try -------------------------------------------------------->
  {featuredDecks.length > 0 && (
    <section class="py-14 md:py-16">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-6xl mx-auto">
          <div class="flex flex-wrap items-end justify-between gap-3 mb-2">
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient">
              {t('home.decklistsTitle', locale)}
            </h2>
            <a href={route('decklists', locale)} class="text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
              {t('home.decklistsCta', locale)} →
            </a>
          </div>
          <p class="text-text-secondary mb-6">{t('home.decklistsSubtitle', locale)}</p>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featuredDecks.map(deck => <DeckCard deck={deck} locale={locale} from="home" />)}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 10. Community ---------------------------------------------------------->
  <section class="py-14 md:py-16 bg-bg-secondary/60 border-t border-card-border/25">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-2">
          {t('home.communityTitle', locale)}
        </h2>
        <p class="text-text-secondary mb-6">{t('home.communitySubtitle', locale)}</p>
        <DiscordCta locale={locale} placement="home" />
      </div>
    </div>
  </section>

</Base>
