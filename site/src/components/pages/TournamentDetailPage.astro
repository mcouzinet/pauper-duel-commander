---
/**
 * Tournament detail.
 *
 * This page carried the audit's one outright bug: the top 8's "Deck" links were
 * built as `/${locale}/decklists/${slug}/` while the route is `/decklist/`, so all
 * fifteen of them 404'd. They go through `route()` now, which is the single place
 * that knows the localised segments, the whole reason that helper exists.
 *
 * Laid out like the decklist page since its redesign: a compact header, the
 * winner's card in a sticky column on desktop (a strip under the title on a
 * phone, the same image), the top 8 as rows or as cards, then the field as a
 * mosaic like the meta page's, each place in the top 8 marked on its tile. The faint winner art behind the
 * header is gone: barely visible at 12 % opacity, it was still the page's
 * largest paint. Once the event is over, the organiser's notes (times, fees,
 * prizes) move below the results.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Top8, { type Top8Entry } from '@/components/Top8.astro';
import CommanderTable from '@/components/CommanderTable.astro';
import MetaMosaic from '@/components/MetaMosaic.astro';
import GuildGrid from '@/components/GuildGrid.astro';
import ColorColumns from '@/components/ColorColumns.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, tf, type Locale } from '@/lib/i18n';
import { route, homeRoute } from '@/lib/routes';
import { formatDate, isPlaceholder, hasHappened } from '@/lib/tournaments';
import { getCardsByNames, getCardImage } from '@/lib/scryfall';
import { bannedNameSet, splitNames } from '@/lib/banlist';
import { SITE_ORIGIN } from '@/lib/site';
import type { CommanderStat } from '@/lib/meta';
import type { ScryfallCard } from '@/types/scryfall';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'tournaments'>;
}

const { locale, entry } = Astro.props;
const data = entry.data;

const banned = bannedNameSet();

const isPast = hasHappened(data);
const dateFormatted = formatDate(data.date, locale);
const playerCount = data.actualPlayerCount || data.playerCount;
const venue = [data.location, data.city].filter(Boolean).join(', ');

const names = [
  ...data.top8.map(entry => entry.commanderName),
  ...data.metaList.map(entry => entry.name),
].filter(name => !isPlaceholder(name));
const cards = names.length > 0
  ? await getCardsByNames([...new Set(names.flatMap(splitNames))])
  : new Map<string, ScryfallCard | null>();

function resolveCard(name: string): ScryfallCard | null {
  for (const part of splitNames(name)) {
    const card = cards.get(part.toLowerCase());
    if (card) return card;
  }
  return null;
}

function commanderColors(name: string): string[] {
  const colors = new Set<string>();
  for (const part of splitNames(name)) {
    for (const color of cards.get(part.toLowerCase())?.color_identity ?? []) colors.add(color);
  }
  return [...colors].sort();
}

const isBanned = (name: string) => splitNames(name).some(part => banned.has(part.toLowerCase()));

/** The second card of a pair (partner, background), when there is one. */
function partnerCardOf(name: string): ScryfallCard | null {
  const second = splitNames(name)[1];
  return second ? cards.get(second.toLowerCase()) ?? null : null;
}

const top8: Top8Entry[] = data.top8
  .map(finish => {
    const unknown = isPlaceholder(finish.commanderName);
    const card = unknown ? null : resolveCard(finish.commanderName);
    const partner = unknown ? null : partnerCardOf(finish.commanderName);
    return {
      place: finish.place,
      // Placeholders never reach the UI as a name.
      playerName: isPlaceholder(finish.playerName) ? '' : finish.playerName,
      commanderName: unknown ? t('tournament.unknownCommander', locale) : finish.commanderName,
      isUnknown: unknown,
      score: finish.score,
      commanderImage: getCardImage(card, 'art_crop'),
      cardImage: getCardImage(card, 'normal'),
      partnerImage: getCardImage(partner, 'art_crop'),
      partnerCardImage: getCardImage(partner, 'normal'),
      // The bug: this used to interpolate a route that does not exist.
      decklistUrl: finish.decklistSlug ? route('decklists', locale, finish.decklistSlug) : null,
      isBanned: unknown ? false : isBanned(finish.commanderName),
    };
  })
  .sort((a, b) => a.place - b.place);

const topLabel = top8.length <= 4 ? 'Top 4' : 'Top 8';

// The meta of the day, in the shape the meta page's ranking reads. Unrecorded
// commanders count in the total but in no colour: they used to be counted as
// colourless, which a "???" is not.
const metaTotal = data.metaList.reduce((sum, entry) => sum + entry.count, 0);
const recorded = data.metaList
  .filter(entry => !isPlaceholder(entry.name))
  .sort((a, b) => b.count - a.count);
const unattributed = metaTotal - recorded.reduce((sum, entry) => sum + entry.count, 0);
const colorCounts: Record<string, number> = {};
const ciCounts: Record<string, number> = {};

const commanders: CommanderStat[] = recorded.map((entry, index) => {
  const parts = splitNames(entry.name);
  const card = resolveCard(entry.name);
  const colors = commanderColors(entry.name);
  const ciKey = colors.length > 0 ? colors.join('') : 'C';

  for (const color of colors.length > 0 ? colors : ['C']) colorCounts[color] = (colorCounts[color] ?? 0) + entry.count;
  ciCounts[ciKey] = (ciCounts[ciKey] ?? 0) + entry.count;

  return {
    rank: index + 1,
    name: entry.name,
    mainName: parts[0] ?? entry.name,
    partnerName: parts[1] ?? null,
    count: entry.count,
    percentage: metaTotal > 0 ? Math.round((entry.count / metaTotal) * 100) : 0,
    image: getCardImage(card, 'art_crop'),
    cardImage: getCardImage(card, 'normal'),
    thumb: getCardImage(card, 'small'),
    partnerImage: getCardImage(partnerCardOf(entry.name), 'art_crop'),
    partnerCardImage: getCardImage(partnerCardOf(entry.name), 'normal'),
    colors,
    ciKey,
    isBanned: isBanned(entry.name),
    trend: null,
  };
});

const hasMeta = commanders.length > 0;

// Best place reached by each entry of the field, for the mosaic's badges, keyed
// by the field's own name for it. A top 8 can record a pair by its first card
// alone ("Gut, True Soul Zealot" for the pair with its background): it then
// goes to the field entry with that first card, but only if there is just one,
// so two pairs sharing a first card never trade places.
const places: Record<string, number> = {};
for (const finish of data.top8) {
  if (isPlaceholder(finish.commanderName)) continue;
  const full = finish.commanderName.toLowerCase();
  const main = splitNames(finish.commanderName)[0].toLowerCase();
  const exact = commanders.find(c => c.name.toLowerCase() === full);
  const byMain = commanders.filter(c => c.mainName.toLowerCase() === main);
  const target = exact ?? (byMain.length === 1 ? byMain[0] : null);
  if (!target) continue;
  const key = target.name.toLowerCase();
  places[key] = Math.min(places[key] ?? Infinity, finish.place);
}
const hasResults = top8.length > 0 || hasMeta;
const winner = top8.find(finish => finish.place === 1) ?? null;
const decklistCount = top8.filter(finish => finish.decklistUrl).length;

// `city` is empty for an online event, and all three `seoDetail` templates
// write "%date%, %city%.": substituting nothing left "28 septembre 2026, .
// Vainqueur". Consuming the separator along with the value drops it too. The
// bare `%city%` replace below is the fallback for a locale written without the
// comma.
const cityPart = data.city ? `, ${data.city}` : '';

const description = winner && !winner.isUnknown
  ? t('tournament.seoDetail', locale)
      .replace('%title%', data.title)
      .replace('%date%', dateFormatted)
      .replace(', %city%', cityPart)
      .replace('%city%', data.city)
      .replace('%winner%', winner.playerName || winner.commanderName)
      .replace('%top%', String(top8.length))
  : `${data.title} · ${dateFormatted}${cityPart}`;

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: data.title,
    startDate: data.date,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.location || data.city,
      address: { '@type': 'PostalAddress', addressLocality: data.city, addressCountry: 'FR' },
    },
    ...(data.signupUrl ? { url: data.signupUrl } : {}),
    ...(playerCount > 0 ? { maximumAttendeeCapacity: playerCount } : {}),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('common.home', locale), item: SITE_ORIGIN + homeRoute(locale) },
      { '@type': 'ListItem', position: 2, name: t('tournament.title', locale), item: SITE_ORIGIN + route('tournaments', locale) },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---
<Base
  title={data.title}
  description={description}
  image={winner?.commanderImage ?? null}
  ogType="article"
  schemas={schemas}
>
  <article class="container mx-auto px-4 md:px-6 pt-5 md:pt-8 pb-12">
    <Breadcrumb locale={locale} items={[
      { label: t('tournament.title', locale), href: route('tournaments', locale) },
      { label: data.title },
    ]} />

    <header class="mt-4 pb-6">
      {isPast && (
        <div class="flex flex-wrap items-center gap-2 mb-2">
          {hasResults ? (
            <span class="badge badge--gold sm:text-sm">{t('tournament.resultsPublished', locale)}</span>
          ) : (
            <span class="badge badge--muted sm:text-sm">{t('tournament.resultsPending', locale)}</span>
          )}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-text-primary leading-tight">{data.title}</h1>

      <p class="mt-2 text-base text-text-secondary">
        {dateFormatted}{venue && <>{' · '}{venue}</>}
      </p>

      {(playerCount > 0 || decklistCount > 0) && (
        <ul class="mt-4 flex flex-wrap gap-1.5 sm:gap-2" role="list">
          {playerCount > 0 && (
            <li class="stat-pill"><strong>{playerCount}</strong> {isPast ? t('tournament.players', locale) : t('tournament.spots', locale)}</li>
          )}
          {top8.length > 0 && <li class="stat-pill">{topLabel}</li>}
          {decklistCount > 0 && (
            <li class="stat-pill">{tf('tournament.decklistsCount', locale, { n: decklistCount })}</li>
          )}
        </ul>
      )}

      {!isPast && data.signupUrl && (
        <a href={data.signupUrl} target="_blank" rel="noopener noreferrer"
           data-analytics="tournament_signup_click" data-analytics-slug={entry.id}
           class="btn-primary !px-6 !py-3 !text-sm mt-5">
          {t('tournament.signUp', locale)}
        </a>
      )}

      {isPast && winner?.decklistUrl && (
        <a href={winner.decklistUrl} class="btn-secondary !px-5 !py-2.5 !text-sm mt-5">{t('tournament.winnerDeck', locale)}</a>
      )}
    </header>

    {!isPast && data.details && (
      <section class="py-6 md:py-8 border-t border-white/8" aria-labelledby="tournament-notes">
        <h2 id="tournament-notes" class="section-title">{t('tournament.organizerNotes', locale)}</h2>
        <div class="rich-text max-w-3xl text-text-secondary leading-relaxed" set:html={data.details} />
      </section>
    )}

    {isPast && !hasResults && (
      <div class="panel p-6 max-w-2xl">
        <p class="font-heading font-bold uppercase tracking-wide text-text-primary mb-2">
          {t('tournament.resultsPending', locale)}
        </p>
        <p class="text-sm text-text-secondary leading-relaxed mb-4">
          {t('tournament.resultsUnavailable', locale)} {t('tournament.upcomingNoneText', locale)}
        </p>
        <a href={route('community', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
          {t('nav.community', locale)}
        </a>
      </div>
    )}

    {isPast && top8.length > 0 && (
      <section class="py-6 md:py-8 border-t border-white/8" aria-labelledby="tournament-top">
        <h2 id="tournament-top" class="section-title">{topLabel}</h2>
        <Top8 entries={top8} locale={locale} />
      </section>
    )}

    {isPast && hasResults && (
      <section class="py-6 md:py-8 border-t border-white/8" aria-labelledby="tournament-meta">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 mb-4">
          <h2 id="tournament-meta" class="section-title !mb-0">{t('tournament.metaLabel', locale)}</h2>
          {hasMeta && <p class="text-sm text-text-secondary">{t('meta.glanceHelp', locale)}</p>}
        </div>
        {hasMeta ? (
          <div class="flex flex-col gap-6">
            <MetaMosaic commanders={commanders} total={metaTotal} unattributed={unattributed} locale={locale}
                        label={t('tournament.commandersPlayed', locale)} places={places} />
            <div class="grid gap-6 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] xl:items-start">
              <CommanderTable commanders={commanders} total={metaTotal} locale={locale} ranked={false}
                              id="tournament-table" title={t('tournament.commandersPlayed', locale)} countLabel={t('meta.colPlayers', locale)}
                              note={unattributed > 0 ? tf('tournament.unattributed', locale, { n: unattributed }) : null} />
              <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-1">
                <GuildGrid counts={ciCounts} locale={locale} title={t('tournament.colorIdentities', locale)} />
                <ColorColumns counts={colorCounts} total={metaTotal - unattributed} locale={locale} title={t('meta.colorPresence', locale)} />
              </div>
            </div>
          </div>
        ) : (
          <p class="panel p-4 text-sm text-text-muted">{t('tournament.metaUnavailable', locale)}</p>
        )}
      </section>
    )}

    {isPast && data.details && (
      <section class="py-6 md:py-8 border-t border-white/8" aria-labelledby="tournament-notes">
        <h2 id="tournament-notes" class="section-title">{t('tournament.organizerNotes', locale)}</h2>
        <div class="rich-text max-w-3xl text-sm text-text-secondary leading-relaxed" set:html={data.details} />
      </section>
    )}

    <div class="pt-6 border-t border-white/8 flex flex-wrap gap-3">
      <a href={route('tournaments', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('tournament.backToList', locale)}</a>
      {isPast && hasMeta && (
        <a href={route('meta', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('home.metaCta', locale)}</a>
      )}
      <a href={route('decklists', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('archive.allDecklists', locale)}</a>
    </div>
  </article>
</Base>
