---
/**
 * Tournament detail.
 *
 * This page carried the audit's one outright bug: the top 8's "Deck" links were
 * built as `/${locale}/decklists/${slug}/` while the route is `/decklist/`, so all
 * fifteen of them 404'd. They go through `route()` now, which is the single place
 * that knows the localised segments — the whole reason that helper exists.
 *
 * With the links working, the loop the audit describes closes: event → results →
 * decklists → metagame.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Top8Table from '@/components/Top8Table.astro';
import MetaPanel from '@/components/MetaPanel.astro';
import ColorPieChart from '@/components/ColorPieChart.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route, homeRoute } from '@/lib/routes';
import { formatDate, sortColorCounts } from '@/lib/tournaments';
import { getCardsByNames, getCardImage } from '@/lib/scryfall';
import { bannedNameSet, splitNames } from '@/lib/banlist';
import { SITE_ORIGIN } from '@/lib/site';
import type { ScryfallCard } from '@/types/scryfall';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'tournaments'>;
}

const { locale, entry } = Astro.props;
const data = entry.data;

const banned = bannedNameSet();

const today = new Date().toISOString().slice(0, 10);
const isPast = data.date < today;
const dateFormatted = formatDate(data.date, locale);
const playerCount = data.actualPlayerCount || data.playerCount;

const names = [
  ...data.top8.map(entry => entry.commanderName),
  ...data.metaList.map(entry => entry.name),
].filter(Boolean);
const cards = names.length > 0
  ? await getCardsByNames([...new Set(names.flatMap(splitNames))])
  : new Map<string, ScryfallCard | null>();

function resolveCard(name: string): ScryfallCard | null {
  for (const part of splitNames(name)) {
    const card = cards.get(part.toLowerCase());
    if (card) return card;
  }
  return null;
}

function commanderColors(name: string): string[] {
  const colors = new Set<string>();
  for (const part of splitNames(name)) {
    for (const color of cards.get(part.toLowerCase())?.color_identity ?? []) colors.add(color);
  }
  return [...colors].sort();
}

const isBanned = (name: string) => splitNames(name).some(part => banned.has(part.toLowerCase()));

const top8 = data.top8
  .map(finish => {
    const card = resolveCard(finish.commanderName);
    return {
      place: finish.place,
      playerName: finish.playerName,
      commanderName: finish.commanderName,
      score: finish.score,
      commanderImage: getCardImage(card, 'art_crop'),
      cardImage: getCardImage(card, 'normal'),
      // The bug: this used to interpolate a route that does not exist.
      decklistUrl: finish.decklistSlug ? route('decklists', locale, finish.decklistSlug) : null,
      isBanned: isBanned(finish.commanderName),
    };
  })
  .sort((a, b) => a.place - b.place);

const topLabel = top8.length <= 4 ? 'Top 4' : 'Top 8';

const totalParticipants = data.metaList.reduce((sum, entry) => sum + entry.count, 0);
const colorCounts: Record<string, number> = {};
const colorIdentityCounts: Record<string, number> = {};

const metaCommanders = data.metaList.map(entry => {
  const card = resolveCard(entry.name);
  const colors = commanderColors(entry.name);

  if (colors.length > 0) {
    for (const color of colors) colorCounts[color] = (colorCounts[color] ?? 0) + entry.count;
  } else {
    colorCounts.C = (colorCounts.C ?? 0) + entry.count;
  }

  const key = colors.length > 0 ? colors.join('') : 'C';
  colorIdentityCounts[key] = (colorIdentityCounts[key] ?? 0) + entry.count;

  return {
    name: entry.name,
    count: entry.count,
    percentage: totalParticipants > 0 ? Math.round((entry.count / totalParticipants) * 100) : 0,
    image: getCardImage(card, 'art_crop'),
    cardImage: getCardImage(card, 'normal'),
    colors,
    isBanned: isBanned(entry.name),
  };
});

const hasMeta = metaCommanders.length > 0;
const winner = top8.find(finish => finish.place === 1) ?? null;
const heroImage = winner?.commanderImage ?? null;
const decklistCount = top8.filter(finish => finish.decklistUrl).length;

const description = winner
  ? (locale === 'fr'
      ? `${data.title} — ${dateFormatted}, ${data.city}. Vainqueur : ${winner.playerName} avec ${winner.commanderName}. Top ${top8.length}, méta et decklists.`
      : `${data.title} — ${dateFormatted}, ${data.city}. Winner: ${winner.playerName} with ${winner.commanderName}. Top ${top8.length}, metagame and decklists.`)
  : `${data.title} — ${dateFormatted}${data.city ? `, ${data.city}` : ''}`;

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: data.title,
    startDate: data.date,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.location || data.city,
      address: { '@type': 'PostalAddress', addressLocality: data.city, addressCountry: 'FR' },
    },
    ...(data.signupUrl ? { url: data.signupUrl } : {}),
    ...(playerCount > 0 ? { maximumAttendeeCapacity: playerCount } : {}),
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'fr' ? 'Accueil' : 'Home', item: SITE_ORIGIN + homeRoute(locale) },
      { '@type': 'ListItem', position: 2, name: t('tournament.title', locale), item: SITE_ORIGIN + route('tournaments', locale) },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---
<Base
  title={data.title}
  description={description}
  image={heroImage}
  ogType="article"
  schemas={schemas}
>

  <section class="page-head !py-8 md:!py-10">
    <div class="page-head__bg"></div>
    {heroImage && (
      <div class="absolute inset-0 opacity-[0.12] pointer-events-none">
        <img src={heroImage} alt="" aria-hidden="true"
             width="626" height="457" class="w-full h-full object-cover" />
      </div>
    )}

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-6xl">
        <Breadcrumb locale={locale} items={[
          { label: t('tournament.title', locale), href: route('tournaments', locale) },
          { label: data.title },
        ]} />

        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mt-3">
          <h1 class="text-2xl md:text-3xl font-heading font-bold text-magic-gradient leading-tight">
            {data.title}
          </h1>

          <div class="flex flex-wrap items-center gap-2 sm:flex-shrink-0">
            <span class="tournament-badge tournament-badge--primary">
              <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              {dateFormatted}
            </span>

            {data.location && (
              <span class="tournament-badge">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {data.location}{data.city ? `, ${data.city}` : ''}
              </span>
            )}

            {playerCount > 0 && (
              <span class="tournament-badge">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {playerCount} {isPast ? t('tournament.players', locale) : t('tournament.spots', locale)}
              </span>
            )}

            {decklistCount > 0 && (
              <span class="tournament-badge">
                {t('tournament.decklistsCount', locale).replace('%n%', String(decklistCount))}
              </span>
            )}

            {data.signupUrl && (
              <a href={data.signupUrl} target="_blank" rel="noopener noreferrer"
                 data-analytics="tournament_signup_click" data-analytics-slug={entry.id}
                 class="tournament-badge hover:border-brand-orange/50 hover:text-brand-orange transition-colors">
                {t('tournament.registration', locale)}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  {data.details && (
    <section class="py-6 bg-bg-secondary/50 border-b border-card-border/25">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-6xl">
          <div class="rich-text text-sm text-text-secondary" set:html={data.details} />
          {data.signupUrl && (
            <div class="mt-5">
              <a href={data.signupUrl} target="_blank" rel="noopener noreferrer"
                 data-analytics="tournament_signup_click" data-analytics-slug={entry.id}
                 class="btn-primary !px-5 !py-2.5 !text-sm">
                {t('tournament.signUp', locale)}
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {isPast && (
    <section class="py-8 md:py-10">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-6xl">
          {top8.length === 0 && !hasMeta ? (
            <div class="panel p-6 max-w-2xl">
              <p class="font-heading font-bold uppercase tracking-wide text-text-primary mb-2">
                {t('tournament.resultsPending', locale)}
              </p>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                {t('tournament.resultsUnavailable', locale)} {t('tournament.upcomingNoneText', locale)}
              </p>
              <a href={route('community', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
                {t('nav.community', locale)}
              </a>
            </div>
          ) : (
            <div class="grid lg:grid-cols-5 gap-6 items-start">
              <Top8Table top8={top8} locale={locale} topLabel={topLabel} />

              <div class="lg:col-span-2 min-w-0 space-y-4">
                <h2 class="section-title">{t('tournament.metaLabel', locale)}</h2>

                {hasMeta ? (
                  <>
                    <MetaPanel
                      metaCommanders={metaCommanders}
                      colorIdentityCounts={colorIdentityCounts}
                      playerCount={playerCount}
                      locale={locale}
                    />
                    {Object.keys(colorCounts).length > 0 && (
                      <ColorPieChart colorCounts={sortColorCounts(colorCounts)} locale={locale} />
                    )}
                    <a href={route('meta', locale)}
                       class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
                      {t('home.metaCta', locale)}
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  </>
                ) : (
                  <div class="panel p-4">
                    <p class="text-text-muted italic text-sm">{t('tournament.metaUnavailable', locale)}</p>
                  </div>
                )}
              </div>
            </div>
          )}

          <div class="mt-8 pt-6 border-t border-card-border/20 flex flex-wrap gap-3">
            <a href={route('tournaments', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
              {t('tournament.backToList', locale)}
            </a>
            <a href={route('decklists', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
              {t('archive.allDecklists', locale)}
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

</Base>
