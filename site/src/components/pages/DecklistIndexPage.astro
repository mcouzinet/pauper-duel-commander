---
/**
 * Decklist index.
 *
 * It called itself "Quelques Decklists", apologised for being under construction,
 * and then showed a grid in which four separate "Gut, True Soul Zealot" entries
 * were indistinguishable. The collection is one of the site's main assets; this
 * presents it as one.
 *
 * Two changes carry most of the value:
 *   - cards now show the finish, the tournament, the date and the author, which is
 *     what tells two lists with the same commander apart;
 *   - shelves in front of the full grid answer "I want to play PDC, what do I
 *     build?" — the question a flat grid cannot.
 *
 * Search / sort / filter run client-side over the `data-*` attributes DeckCard
 * already renders, so there is no second copy of the data, and with JS off the
 * whole collection is still visible.
 */
import Base from '@/layouts/Base.astro';
import DeckCard from '@/components/DeckCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { submissionsEnabled } from '@/lib/features';
import { getDecklists, getShelves, getArchetypes, getColorIdentities } from '@/lib/decklists';
import { getMeta } from '@/lib/meta';
import { colorIdentityLabel } from '@/lib/colors';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [decklists, archetypes, colorIdentities, meta] = await Promise.all([
  getDecklists(),
  getArchetypes(),
  getColorIdentities(),
  getMeta(),
]);

const shelves = await getShelves({
  recentTournamentSlugs: meta.recentSlugs,
  originalCommanders: meta.originalCommanders,
  limit: 4,
});

const fromTournaments = decklists.filter(deck => deck.result).length;

/** archive.shelfMoment, archive.shelfMomentHint… from the shelf key. */
const shelfKey = (key: string) => `${key.charAt(0).toUpperCase()}${key.slice(1)}`;

const title = locale === 'fr'
  ? 'Decklists Pauper Duel Commander'
  : 'Pauper Duel Commander decklists';
const description = t('archive.subtitle', locale)
  .replace('%total%', String(decklists.length))
  .replace('%fromTournaments%', String(fromTournaments));
---
<Base title={title} description={description} bareTitle={false}>

  <section class="page-head">
    <div class="page-head__bg"></div>
    <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
      <img src="/img/cards-background.webp" alt="" aria-hidden="true"
           width="1024" height="356" class="w-full h-full object-cover" />
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-4xl">
        <Breadcrumb locale={locale} items={[{ label: t('archive.title', locale) }]} />

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-magic-gradient mt-3 mb-3">
          {t('archive.title', locale)}
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl mb-5">
          {description}
        </p>

        {submissionsEnabled && (
          <a href={route('submitDecklist', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
            {t('submit.cta', locale)}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Shelves: one picker, not five stacked sections ------------------------->
  {/*
    These were five full sections in a row, so the complete collection — the
    reason most people open this page — started some 3,000px down. They are one
    section now, with a picker: same content, one shelf deep.
  */}
  {shelves.length > 0 && (
    <section class="container mx-auto px-4 md:px-6 py-8 md:py-10">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
        <label for="shelf-select" class="text-xl sm:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide">
          {t('archive.shelfSelectLabel', locale)}
        </label>
        <select id="shelf-select"
                class="px-3 py-2 bg-bg-secondary border border-card-border/40 rounded-lg text-text-primary focus:outline-none focus:ring-2 focus:ring-brand-orange/50">
          {shelves.map(shelf => (
            <option value={shelf.key}>{t(`archive.shelf${shelfKey(shelf.key)}`, locale)}</option>
          ))}
        </select>
      </div>

      {/* Every shelf ships in the DOM; the picker swaps which one shows. With no
          JS the first stays visible, which is the old default view. */}
      {shelves.map((shelf, i) => (
        <div data-shelf-panel={shelf.key} hidden={i > 0}>
          <p class="text-sm text-text-muted mb-4">
            {t(`archive.shelf${shelfKey(shelf.key)}Hint`, locale)}
          </p>

          {/* Horizontal scroller below sm, grid above. Stacked full-height cards
              would have added ~6,000px of shelf to a phone page — the opposite of
              what the shelves are for. */}
          <ul class="flex sm:grid gap-4 sm:grid-cols-2 lg:grid-cols-4 overflow-x-auto sm:overflow-visible snap-x snap-mandatory -mx-4 px-4 sm:mx-0 sm:px-0 pb-2 sm:pb-0">
            {shelf.decklists.map(deck => (
              <li class="w-[76%] shrink-0 snap-start sm:w-auto sm:shrink">
                <DeckCard deck={deck} locale={locale} from={`shelf_${shelf.key}`} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <!-- Full collection, searchable ------------------------------------------->
  <section id="all" class="border-t border-card-border/25 bg-bg-secondary/40">
    <div class="container mx-auto px-4 md:px-6 py-8">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-5">
        {t('archive.allDecklists', locale)}
      </h2>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" id="decklist-filters">
        <div class="sm:col-span-2 lg:col-span-1">
          <label for="filter-search" class="block text-xs font-heading font-bold uppercase tracking-wider text-text-muted mb-1.5">
            {t('archive.searchLabel', locale)}
          </label>
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input id="filter-search" type="search" autocomplete="off"
                   placeholder={t('archive.searchPlaceholder', locale)}
                   class="w-full pl-9 pr-3 py-2 bg-bg-primary border border-white/10 rounded-lg text-text-primary placeholder-text-muted focus:border-brand-orange/60 focus:outline-none transition-colors text-sm" />
          </div>
        </div>

        <div>
          <label for="filter-archetype" class="block text-xs font-heading font-bold uppercase tracking-wider text-text-muted mb-1.5">
            {t('archive.archetypeLabel', locale)}
          </label>
          <select id="filter-archetype"
                  class="w-full px-3 py-2 bg-bg-primary border border-white/10 rounded-lg text-text-primary focus:border-brand-orange/60 focus:outline-none transition-colors text-sm">
            <option value="">{t('archive.allArchetypes', locale)}</option>
            {archetypes.map(archetype => <option value={archetype}>{archetype}</option>)}
          </select>
        </div>

        <div>
          <label for="filter-color" class="block text-xs font-heading font-bold uppercase tracking-wider text-text-muted mb-1.5">
            {t('archive.colorLabel', locale)}
          </label>
          <select id="filter-color"
                  class="w-full px-3 py-2 bg-bg-primary border border-white/10 rounded-lg text-text-primary focus:border-brand-orange/60 focus:outline-none transition-colors text-sm">
            <option value="">{t('archive.allColors', locale)}</option>
            {colorIdentities.map(ci => <option value={ci}>{colorIdentityLabel(ci, locale)}</option>)}
          </select>
        </div>

        <div>
          <label for="filter-sort" class="block text-xs font-heading font-bold uppercase tracking-wider text-text-muted mb-1.5">
            {t('archive.sortLabel', locale)}
          </label>
          <select id="filter-sort"
                  class="w-full px-3 py-2 bg-bg-primary border border-white/10 rounded-lg text-text-primary focus:border-brand-orange/60 focus:outline-none transition-colors text-sm">
            <option value="recent">{t('archive.sortRecent', locale)}</option>
            <option value="result">{t('archive.sortResult', locale)}</option>
            <option value="commander">{t('archive.sortCommander', locale)}</option>
          </select>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4 mt-4">
        <label class="inline-flex items-center gap-2 cursor-pointer text-sm text-text-secondary">
          <input type="checkbox" id="filter-tournaments"
                 class="w-4 h-4 rounded border-white/20 bg-bg-primary accent-brand-orange" />
          {t('archive.onlyTournaments', locale)}
        </label>

        <p id="decklist-count"
           class="text-sm text-text-muted tabular-nums ml-auto"
           data-all={t('archive.countAll', locale).replace('%n%', String(decklists.length))}
           data-filtered={t('archive.countFiltered', locale)}
           aria-live="polite">
          {t('archive.countAll', locale).replace('%n%', String(decklists.length))}
        </p>

        <button id="filter-reset" type="button" class="hidden text-sm text-brand-orange hover:text-magic-gold transition-colors">
          {t('archive.filterReset', locale)}
        </button>
      </div>
    </div>
  </section>

  <section class="py-8 md:py-10">
    <div class="container mx-auto px-4 md:px-6">
      {/* Below sm each deck renders as a compact row instead of a full-height
          tile: the old layout spent ~800px per deck, so 25 decks made an
          11,000px page on a phone. */}
      <div class="grid gap-3 sm:gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4" id="decklist-grid">
        {decklists.map(deck => (
          <div class="min-w-0">
            <div class="sm:hidden"><DeckCard deck={deck} locale={locale} compact={true} /></div>
            <div class="hidden sm:block h-full"><DeckCard deck={deck} locale={locale} /></div>
          </div>
        ))}
      </div>

      <div id="decklist-empty" class="hidden text-center py-16">
        <h2 class="text-xl font-heading font-bold text-magic-gradient mb-3">
          {t('archive.noDecklistFound', locale)}
        </h2>
        <p class="text-text-secondary">{t('archive.noDecklistHint', locale)}</p>
      </div>
    </div>
  </section>

  <script>
    // Shelf picker: show the chosen panel, hide the rest. All of them are in the
    // DOM already, so this never fetches and works with the page as rendered.
    const shelfSelect = document.getElementById('shelf-select') as HTMLSelectElement | null;
    if (shelfSelect) {
      const panels = [...document.querySelectorAll<HTMLElement>('[data-shelf-panel]')];
      shelfSelect.addEventListener('change', () => {
        for (const panel of panels) {
          panel.hidden = panel.dataset.shelfPanel !== shelfSelect.value;
        }
      });
    }
  </script>

  <script>
    // Filter/sort/search over what is already in the DOM. Each deck renders twice
    // inside one wrapper (compact under sm, card above), so the wrapper is what
    // gets hidden and reordered.
    const search = document.getElementById('filter-search') as HTMLInputElement | null;
    const archetype = document.getElementById('filter-archetype') as HTMLSelectElement | null;
    const color = document.getElementById('filter-color') as HTMLSelectElement | null;
    const sort = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const onlyTournaments = document.getElementById('filter-tournaments') as HTMLInputElement | null;
    const reset = document.getElementById('filter-reset');
    const count = document.getElementById('decklist-count');
    const empty = document.getElementById('decklist-empty');
    const grid = document.getElementById('decklist-grid');

    if (grid) {
      const gridEl = grid;
      const wrappers = [...gridEl.children] as HTMLElement[];
      const total = wrappers.length;
      const labelAll = count?.dataset.all ?? '';
      const labelFiltered = count?.dataset.filtered ?? '%n% / %total%';

      const dataOf = (wrapper: HTMLElement) =>
        wrapper.querySelector<HTMLElement>('[data-deck]')?.dataset ?? {};

      let debounce: number | undefined;

      function apply() {
        const query = (search?.value ?? '').trim().toLowerCase();
        const arch = archetype?.value ?? '';
        const ci = color?.value ?? '';
        const tournamentsOnly = onlyTournaments?.checked ?? false;

        let visible = 0;
        for (const wrapper of wrappers) {
          const data = dataOf(wrapper);
          const matches =
            (!query || (data.search ?? '').includes(query)) &&
            (!arch || data.archetype === arch) &&
            (!ci || data.color === ci) &&
            (!tournamentsOnly || data.tournament === '1');

          wrapper.hidden = !matches;
          if (matches) visible++;
        }

        const mode = sort?.value ?? 'recent';
        const sorted = [...wrappers].sort((a, b) => {
          const da = dataOf(a);
          const db = dataOf(b);
          if (mode === 'commander') {
            return (da.sortCommander ?? '').localeCompare(db.sortCommander ?? '');
          }
          if (mode === 'result') {
            const byPlace = (da.sortPlace ?? '99').localeCompare(db.sortPlace ?? '99');
            if (byPlace !== 0) return byPlace;
          }
          return (db.sortDate ?? '').localeCompare(da.sortDate ?? '');
        });
        for (const wrapper of sorted) gridEl.appendChild(wrapper);

        const isFiltered = Boolean(query || arch || ci || tournamentsOnly);
        reset?.classList.toggle('hidden', !isFiltered);
        empty?.classList.toggle('hidden', visible > 0);
        if (count) {
          count.textContent = isFiltered
            ? labelFiltered.replace('%n%', String(visible)).replace('%total%', String(total))
            : labelAll;
        }

        if (query) {
          window.clearTimeout(debounce);
          debounce = window.setTimeout(() => {
            window.pdcTrack?.('decklist_search', { query_length: query.length, results: visible });
          }, 800);
        }
      }

      search?.addEventListener('input', apply);
      for (const control of [archetype, color, sort, onlyTournaments]) {
        control?.addEventListener('change', () => {
          const value = control instanceof HTMLInputElement ? String(control.checked) : control.value;
          window.pdcTrack?.('decklist_filter', { type: control.id, value });
          apply();
        });
      }

      reset?.addEventListener('click', () => {
        if (search) search.value = '';
        if (archetype) archetype.value = '';
        if (color) color.value = '';
        if (onlyTournaments) onlyTournaments.checked = false;
        apply();
      });

      // Deep link from the meta page: /decklist/?commander=Baleful%20Strix
      const requested = new URLSearchParams(window.location.search).get('commander');
      if (requested && search) {
        search.value = requested;
        apply();
        document.getElementById('all')?.scrollIntoView({ block: 'start' });
      }
    }
  </script>
</Base>
