---
/**
 * Decklist detail.
 *
 * The page a player opens next to their play mat, and the one the audit found
 * hardest to use there: 1,200px of commander art before the title, ninety-nine
 * cards in a single column (a 12,700px page), no contents, and an `author` field
 * that the data carried but the page never printed.
 *
 * Rebuilt mobile-first — title and facts first, art beside them on desktop and
 * after them on mobile — and wired into the rest of the site: the tournament it
 * came from, the other decks piloting the same commander, and the validator.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CardList from '@/components/CardList.astro';
import DeckStats from '@/components/DeckStats.astro';
import DeckCard from '@/components/DeckCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route, homeRoute } from '@/lib/routes';
import { parseDecklist } from '@/lib/decklist-parser';
import { prepareDeckData } from '@/lib/deck-renderer';
import { formatColorSymbols } from '@/lib/mana';
import { getDecklist, getSiblingDecklists, placeLabel } from '@/lib/decklists';
import { formatBanlistDate } from '@/lib/banlist';
import { SITE_ORIGIN } from '@/lib/site';
import '@/styles/decklist.css';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'decklists'>;
}

const { locale, entry } = Astro.props;
const data = entry.data;

const [enriched, siblings] = await Promise.all([
  getDecklist(entry.id),
  getSiblingDecklists(entry.id),
]);

const parsedCards = parseDecklist(data.cards);
const deck = await prepareDeckData(parsedCards, data.commander, data.partner || undefined);

const isBanned = enriched?.isBanned ?? false;
const result = enriched?.result ?? null;

const deckDate = data.date ? formatBanlistDate(data.date, locale) : null;
const totalCards = parsedCards.reduce((sum, card) => sum + card.quantity, 0);

const commanderManaCostHtml = deck.commander?.manaCost ? '' : '';

// Export payload, also used to prefill the validator.
const exportData = JSON.stringify({
  commander: deck.commander?.name ?? data.commander,
  partner: deck.partner?.name ?? data.partner ?? '',
  decklist: data.cards,
  filename: `${entry.id}.txt`,
});

const typeOrder = Object.keys(deck.cardsByType);
const TYPE_LABEL_KEYS: Record<string, string> = {
  Creature: 'common.creatures',
  Instant: 'common.instants',
  Sorcery: 'common.sorceries',
  Artifact: 'common.artifacts',
  Enchantment: 'common.enchantments',
  Land: 'common.lands',
  Planeswalker: 'common.planeswalkers',
  Other: 'common.other',
};
const typeAnchor = (type: string) => `type-${type.toLowerCase()}`;

const resultText = result
  ? `${placeLabel(result.place, locale)} · ${result.title}`
  : null;

const bannedCount = deck.bannedCards.length;
const bannedHeadline = bannedCount === 1
  ? t('decklist.bannedCardsOne', locale)
  : t('decklist.bannedCards', locale).replace('%n%', String(bannedCount));
const bannedChip = bannedCount === 1
  ? t('decklist.bannedCardsShortOne', locale)
  : `${bannedCount} ${t('decklist.bannedCardsShort', locale)}`;

const description = [
  data.commander + (data.partner ? ` // ${data.partner}` : ''),
  data.archetype,
  resultText,
  data.author,
]
  .filter(Boolean)
  .join(' — ');

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'fr' ? 'Accueil' : 'Home', item: SITE_ORIGIN + homeRoute(locale) },
      { '@type': 'ListItem', position: 2, name: t('archive.title', locale), item: SITE_ORIGIN + route('decklists', locale) },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---
<Base
  title={data.title}
  description={description}
  image={deck.commander?.imageUrlArtCrop ?? null}
  ogType="article"
  schemas={schemas}
>

  <article class="decklist-single">

    <!-- Header: facts before art. On a phone the previous version opened with
         1,200px of card scans, so the deck's own name was off-screen. -->
    <section class="page-head">
      <div class="page-head__bg"></div>
      {deck.commander?.imageUrlArtCrop && (
        <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
          <img src={deck.commander.imageUrlArtCrop} alt="" aria-hidden="true"
               width="626" height="457" class="w-full h-full object-cover" />
        </div>
      )}

      <div class="container mx-auto px-4 md:px-6 relative z-10">
        <Breadcrumb locale={locale} items={[
          { label: t('archive.title', locale), href: route('decklists', locale) },
          { label: data.commander },
        ]} />

        <div class="grid md:grid-cols-[minmax(0,1fr)_240px] gap-6 md:gap-8 items-start mt-4">

          <div class="min-w-0 order-1">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="inline-flex items-center gap-1">
                <span class="sr-only">{t('a11y.colors', locale)}</span>
                <span set:html={formatColorSymbols(enriched?.colors ?? [])} />
              </span>
              {data.archetype && <span class="badge">{data.archetype}</span>}
              {result && (
                <a href={route('tournaments', locale, result.slug)} class="badge badge--gold no-underline hover:border-magic-gold/60 transition-colors">
                  {placeLabel(result.place, locale)} · {result.title}
                </a>
              )}
              {enriched?.tags.includes('debutant') && (
                <span class="badge badge--new">{t('archive.beginnerBadge', locale)}</span>
              )}
              {deck.bannedCards.length > 0 && (
                <a href="#cartes-bannies" class="badge badge--danger no-underline hover:border-red-400/60 transition-colors">
                  {bannedChip}
                </a>
              )}
            </div>

            <h1 class:list={[
              'text-2xl sm:text-3xl md:text-4xl font-beleren font-bold text-magic-gradient mb-3 leading-tight',
              isBanned && 'line-through decoration-red-500/70',
            ]}>{data.title}</h1>

            {isBanned && (
              <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-lg flex items-start gap-3">
                <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
                <div class="min-w-0">
                  <p class="text-sm text-red-200 font-semibold mb-0.5">{t('decklist.bannedCommander', locale)}</p>
                  <p class="text-sm text-red-200/80 leading-relaxed">
                    {t('decklist.bannedDesc', locale)}
                    {' '}
                    <a href={route('banlist', locale)} class="underline hover:no-underline">{t('nav.banlist', locale)}</a>
                  </p>
                </div>
              </div>
            )}

            {deck.bannedCards.length > 0 && !isBanned && (
              <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-lg flex items-start gap-3">
                <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
                <div class="min-w-0">
                  <p class="text-sm text-red-200 font-semibold mb-1">
                    {bannedHeadline}
                  </p>
                  <p class="flex flex-wrap gap-1.5 mb-2">
                    {deck.bannedCards.map(card => (
                      <span class="inline-flex items-center text-sm font-beleren text-red-200 bg-red-500/15 rounded px-2 py-0.5" lang="en">
                        {card.name}
                      </span>
                    ))}
                  </p>
                  <p class="text-sm text-red-200/80 leading-relaxed">
                    {t('decklist.bannedCardsHelp', locale)}
                    {' '}
                    <a href={route('banlist', locale)} class="underline hover:no-underline">{t('nav.banlist', locale)}</a>
                  </p>
                </div>
              </div>
            )}

            <dl class="flex flex-wrap gap-2 mb-5 text-sm">
              <div class="stat-pill">
                <dt class="sr-only">{t('decklist.commanderLabel', locale)}</dt>
                <dd class="font-beleren text-text-primary" lang="en">{data.commander}</dd>
              </div>
              {data.partner && (
                <div class="stat-pill">
                  <dt class="sr-only">{t('decklist.partnerLabel', locale)}</dt>
                  <dd class="font-beleren text-text-primary" lang="en">+ {data.partner}</dd>
                </div>
              )}
              {data.author && (
                <div class="stat-pill">
                  <dt class="text-text-muted">{t('decklist.author', locale)}</dt>
                  <dd><strong>{data.author}</strong></dd>
                </div>
              )}
              {deckDate && (
                <div class="stat-pill">
                  <dt class="sr-only">{t('common.on', locale)}</dt>
                  <dd>{deckDate}</dd>
                </div>
              )}
              <div class="stat-pill">
                <dt class="sr-only">{t('decklist.cardCount', locale)}</dt>
                <dd><strong>{totalCards + (data.partner ? 2 : 1)}</strong> {t('decklist.cardCount', locale)}</dd>
              </div>
            </dl>

            <div class="flex flex-wrap gap-2">
              <button id="btn-copy" type="button" class="btn-secondary !px-4 !py-2.5 !text-sm"
                      data-label-default={t('decklist.copy', locale)}
                      data-label-done={t('decklist.exportCopied', locale)}
                      data-analytics="decklist_export" data-analytics-format="clipboard">
                {t('decklist.copy', locale)}
              </button>
              <button id="btn-download" type="button" class="btn-secondary !px-4 !py-2.5 !text-sm"
                      data-analytics="decklist_export" data-analytics-format="txt">
                {t('decklist.download', locale)}
              </button>
              <a id="btn-validate" href={route('validator', locale)} class="btn-secondary !px-4 !py-2.5 !text-sm"
                 data-analytics="decklist_validate_click">
                {t('decklist.validate', locale)}
              </a>
              {result && (
                <a href={route('tournaments', locale, result.slug)} class="btn-secondary !px-4 !py-2.5 !text-sm">
                  {t('decklist.viewTournament', locale)}
                </a>
              )}
            </div>
          </div>

          <!-- Art: to the right on desktop, below the facts on mobile. -->
          <div class="order-2 min-w-0">
            <div class="flex md:flex-col gap-3">
              {deck.commander?.imageUrl && (
                <img src={deck.commander.imageUrl}
                     alt={deck.commander.name}
                     width="488" height="680"
                     class:list={['w-1/2 md:w-full h-auto rounded-xl shadow-card', isBanned && 'grayscale']}
                     loading="eager" fetchpriority="high" decoding="async" />
              )}
              {deck.partner?.imageUrl && (
                <img src={deck.partner.imageUrl}
                     alt={deck.partner.name}
                     width="488" height="680"
                     class="w-1/2 md:w-full h-auto rounded-xl shadow-card"
                     loading="lazy" decoding="async" />
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contents: 99 cards need a way in other than scrolling -->
    <nav class="border-b border-card-border/25 bg-bg-secondary/50 sticky top-[68px] md:top-[76px] z-30 backdrop-blur-sm"
         aria-label={t('decklist.contents', locale)}>
      <div class="container mx-auto px-4 md:px-6 py-2.5">
        <ul class="flex items-center gap-2 overflow-x-auto scroll-x text-sm">
          {typeOrder.map(type => {
            const cards = deck.cardsByType[type];
            const total = cards.reduce((sum, card) => sum + card.quantity, 0);
            return (
              <li class="flex-shrink-0">
                <a href={`#${typeAnchor(type)}`}
                   class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-text-secondary hover:text-brand-orange hover:bg-brand-orange/10 transition-colors whitespace-nowrap">
                  {t(TYPE_LABEL_KEYS[type] ?? 'common.other', locale)}
                  <span class="text-text-muted tabular-nums">{total}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </nav>

    <section id="cartes-bannies" class="py-8 md:py-10">
      <div class="container mx-auto px-4 md:px-6">
        <CardList cardsByType={deck.cardsByType} locale={locale} />
      </div>
    </section>

    <section class="py-8 md:py-10 border-t border-card-border/20 bg-bg-secondary/40">
      <div class="container mx-auto px-4 md:px-6">
        <DeckStats stats={deck.stats} locale={locale} />
      </div>
    </section>

    {siblings.length > 0 && (
      <section class="py-10 md:py-12 border-t border-card-border/20">
        <div class="container mx-auto px-4 md:px-6">
          <h2 class="section-title !text-xl sm:!text-2xl">{t('decklist.siblings', locale)}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {siblings.map(sibling => (
              <DeckCard deck={sibling} locale={locale} from="sibling" />
            ))}
          </div>
        </div>
      </section>
    )}

    <script id="deck-export-data" type="application/json" set:html={exportData} is:inline />
  </article>

  <script>
    // Export and validator prefill. The list is already in the page; these are
    // three ways of getting it out of it.
    const node = document.getElementById('deck-export-data');
    const data = node ? JSON.parse(node.textContent || '{}') : null;

    /** Moxfield/Archidekt-compatible text: commander block, then the deck. */
    function asText(): string {
      if (!data) return '';
      const lines: string[] = [];
      if (data.commander) {
        lines.push('Commander');
        lines.push(`1 ${data.commander}`);
        if (data.partner) lines.push(`1 ${data.partner}`);
        lines.push('');
      }
      lines.push('Deck');
      lines.push(String(data.decklist ?? '').replace(/\r\n/g, '\n').trim());
      return lines.join('\n');
    }

    const copyButton = document.getElementById('btn-copy');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(asText());
        const done = copyButton.dataset.labelDone ?? 'OK';
        const previous = copyButton.textContent;
        copyButton.textContent = done;
        window.setTimeout(() => { copyButton.textContent = previous; }, 2000);
      } catch {
        // Clipboard denied (insecure context, or the user refused): the download
        // button below is the fallback, so fail quietly rather than alerting.
      }
    });

    document.getElementById('btn-download')?.addEventListener('click', () => {
      const blob = new Blob([asText()], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = data?.filename ?? 'decklist.txt';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });

    // Hand the list to the validator through sessionStorage: a 99-card decklist
    // does not belong in a query string.
    document.getElementById('btn-validate')?.addEventListener('click', () => {
      if (!data) return;
      try {
        sessionStorage.setItem('pdc:prefill', JSON.stringify({
          commander: data.commander,
          partner: data.partner,
          decklist: data.decklist,
        }));
      } catch {
        // Private browsing can refuse storage; the validator then opens empty.
      }
    });
  </script>
</Base>
