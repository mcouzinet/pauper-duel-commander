---
/**
 * Decklist detail.
 *
 * The page a player opens next to their play mat, and the one a newcomer opens
 * to see what a PDC deck looks like. The first rebuild put the facts before the
 * art; this one (docs/benchmark-decklists.md: Moxfield, Archidekt, MTGGoldfish,
 * EDHREC, MTGTop8, Melee) makes the list readable whole on a phone and gives
 * the reader ways into it:
 *   - list or visual view, grouped by type, mana value or colour;
 *   - a mana curve whose bars filter the list, symbols against sources per colour;
 *   - an opening hand drawn from the 99;
 *   - one primary action (copy), the other formats behind "Exporter".
 *
 * Phone: header (commander thumbnail, facts, actions), list, profile, hand.
 * Desktop: a sticky sidebar keeps the commander, the actions and the curve
 * beside the list it filters. The H1 is the commander; the list's full title
 * stays in <title> and the metadata. The faint art behind the old header is
 * gone: it was the page's largest paint, and the commander card shows the art.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CardList from '@/components/CardList.astro';
import ManaCurve from '@/components/ManaCurve.astro';
import DeckColors from '@/components/DeckColors.astro';
import DeckActions from '@/components/DeckActions.astro';
import SampleHand from '@/components/SampleHand.astro';
import DeckCard from '@/components/DeckCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, tf, localeTag, type Locale } from '@/lib/i18n';
import { route, homeRoute } from '@/lib/routes';
import { parseDecklist } from '@/lib/decklist-parser';
import { prepareDeckData, TYPE_LABEL_KEYS, TYPE_ORDER } from '@/lib/deck-renderer';
import { formatColorSymbols } from '@/lib/mana';
import { getDecklist, getSiblingDecklists, placeLabel } from '@/lib/decklists';
import { formatBanlistDate } from '@/lib/banlist';
import { SITE_ORIGIN } from '@/lib/site';
import '@/styles/decklist.css';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'decklists'>;
}

const { locale, entry } = Astro.props;
const data = entry.data;

const [enriched, siblings] = await Promise.all([
  getDecklist(entry.id),
  getSiblingDecklists(entry.id),
]);

const parsedCards = parseDecklist(data.cards);
const deck = await prepareDeckData(parsedCards, data.commander, data.partner || undefined);
const stats = deck.stats;

const isBanned = enriched?.isBanned ?? false;
const result = enriched?.result ?? null;
const identity = enriched?.colors ?? [];

const deckDate = data.date ? formatBanlistDate(data.date, locale) : null;
const deckSize = stats.totalCards + (data.partner ? 2 : 1);
const number = new Intl.NumberFormat(localeTag(locale), { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// Export payload, also used to prefill the validator.
const exportData = JSON.stringify({
  commander: deck.commander?.name ?? data.commander,
  partner: deck.partner?.name ?? data.partner ?? '',
  decklist: data.cards,
  filename: `${entry.id}.txt`,
});

const typeLabel = (type: string) => t(TYPE_LABEL_KEYS[type] ?? 'common.other', locale);
const navGroups = Object.entries(deck.cardsByType).map(([type, cards]) => ({
  anchor: `type-${type.toLowerCase()}`,
  label: typeLabel(type),
  total: cards.reduce((sum, card) => sum + card.quantity, 0),
}));

// Everything the page script prints, so it holds no copy in any language.
const clientLabels = {
  typeOrder: Object.keys(TYPE_ORDER).sort((a, b) => TYPE_ORDER[a] - TYPE_ORDER[b]),
  types: Object.fromEntries(Object.keys(TYPE_LABEL_KEYS).map(type => [type, typeLabel(type)])),
  colors: {
    W: t('color.W', locale),
    U: t('color.U', locale),
    B: t('color.B', locale),
    R: t('color.R', locale),
    G: t('color.G', locale),
    M: t('color.Multi', locale),
    C: t('color.C', locale),
  },
  costGroup: t('decklist.costGroup', locale),
  countOf: t('decklist.countOf', locale),
  filterStatus: t('decklist.filterStatus', locale),
  bannedOne: t('decklist.bannedCardsShortOne', locale),
  bannedMany: t('decklist.bannedCardsShort', locale),
  group: {
    type: t('decklist.groupType', locale),
    cost: t('decklist.groupCost', locale),
    color: t('decklist.groupColor', locale),
  },
  sort: {
    cost: t('decklist.groupCost', locale),
    name: t('decklist.sortName', locale),
  },
};

const groupOptions: [string, string][] = [
  ['type', 'decklist.groupType'],
  ['cost', 'decklist.groupCost'],
  ['color', 'decklist.groupColor'],
];
const sortOptions: [string, string][] = [
  ['cost', 'decklist.groupCost'],
  ['name', 'decklist.sortName'],
];

const resultText = result
  ? [placeLabel(result.place, locale), result.title, result.score].filter(Boolean).join(' · ')
  : null;

const bannedCount = deck.bannedCards.length;
const bannedHeadline = bannedCount === 1
  ? t('decklist.bannedCardsOne', locale)
  : t('decklist.bannedCards', locale).replace('%n%', String(bannedCount));
const bannedChip = bannedCount === 1
  ? t('decklist.bannedCardsShortOne', locale)
  : `${bannedCount} ${t('decklist.bannedCardsShort', locale)}`;

const description = [
  data.commander + (data.partner ? ` // ${data.partner}` : ''),
  data.archetype,
  resultText,
  data.author,
]
  .filter(Boolean)
  .join(' · ');

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('common.home', locale), item: SITE_ORIGIN + homeRoute(locale) },
      { '@type': 'ListItem', position: 2, name: t('archive.title', locale), item: SITE_ORIGIN + route('decklists', locale) },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---
<Base
  title={data.title}
  description={description}
  image={deck.commander?.imageUrlArtCrop ?? null}
  ogType="article"
  schemas={schemas}
>

  <article class="decklist-single">
    <!-- Before anything is painted: apply a stored visual view, so the page
         does not shift once it is on screen. -->
    <script is:inline>
      try {
        if (localStorage.getItem('pdc:deck-view') === 'visual') document.documentElement.dataset.deckView = 'visual';
      } catch (e) {}
    </script>

    <div class="container mx-auto px-4 md:px-6 pt-5 md:pt-8">
      <Breadcrumb locale={locale} items={[
        { label: t('archive.title', locale), href: route('decklists', locale) },
        { label: data.commander },
      ]} />

      <div class="mt-4 lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-x-10">

        <header class="min-w-0 pb-6 lg:col-start-2 lg:row-start-1">
          <div class="flex items-start gap-3.5">
            {deck.commander?.imageUrl && (
              <button type="button"
                      class:list={['card-hover-trigger lg:hidden flex-shrink-0 w-[72px] overflow-hidden rounded-[4.75%/3.5%] shadow-card', isBanned && 'grayscale']}
                      data-card-name={deck.commander.name}
                      data-card-image={deck.commander.imageUrl}>
                <img src={deck.commander.imageUrl} alt={deck.commander.name} width="488" height="680"
                     class="block w-full h-auto" decoding="async" />
              </button>
            )}
            <div class="min-w-0 flex flex-col gap-2">
              <div class="flex flex-wrap items-center gap-2">
                {result && (
                  <a href={route('tournaments', locale, result.slug)}
                     class="badge badge--gold sm:text-sm no-underline hover:border-magic-gold/60 transition-colors">
                    {resultText}
                  </a>
                )}
                <span class="inline-flex items-center gap-1">
                  <span class="sr-only">{t('a11y.colors', locale)}</span>
                  <span set:html={formatColorSymbols(identity)} />
                </span>
                {data.archetype && <span class="badge">{data.archetype}</span>}
                {enriched?.tags.includes('debutant') && (
                  <span class="badge badge--new">{t('archive.beginnerBadge', locale)}</span>
                )}
                {bannedCount > 0 && (
                  <a href="#cartes-bannies" class="badge badge--danger no-underline hover:border-red-400/60 transition-colors">
                    {bannedChip}
                  </a>
                )}
              </div>

              <h1 lang="en" class:list={[
                'font-beleren normal-case tracking-normal text-[1.75rem] sm:text-4xl lg:text-5xl leading-[1.05] text-text-primary',
                isBanned && 'line-through decoration-red-500/70',
              ]}>{data.commander}</h1>

              {data.partner && (
                <p class="text-base sm:text-lg text-text-secondary">
                  {t('decklist.withPartner', locale)}{' '}
                  <button type="button" lang="en"
                          class="card-hover-trigger font-beleren text-text-primary"
                          data-card-name={data.partner}
                          data-card-image={deck.partner?.imageUrl ?? ''}>{data.partner}</button>
                </p>
              )}

              {(data.author || deckDate) && (
                <p class="text-sm sm:text-base text-text-secondary">
                  {data.author && <>{t('decklist.by', locale)}{' '}<strong class="font-semibold text-text-primary">{data.author}</strong></>}
                  {data.author && deckDate && ' · '}
                  {deckDate}
                </p>
              )}
            </div>
          </div>

          {isBanned && (
            <div class="mt-4 px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-lg flex items-start gap-3">
              <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              <div class="min-w-0">
                <p class="text-sm text-red-200 font-semibold mb-0.5">{t('decklist.bannedCommander', locale)}</p>
                <p class="text-sm text-red-200/80 leading-relaxed">
                  {t('decklist.bannedDesc', locale)}
                  {' '}
                  <a href={route('banlist', locale)} class="underline hover:no-underline">{t('nav.banlist', locale)}</a>
                </p>
              </div>
            </div>
          )}

          {bannedCount > 0 && !isBanned && (
            <div class="mt-4 px-4 py-3 bg-red-500/10 border border-red-500/30 rounded-lg flex items-start gap-3">
              <svg class="w-5 h-5 text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              <div class="min-w-0">
                <p class="text-sm text-red-200 font-semibold mb-1">{bannedHeadline}</p>
                <p class="flex flex-wrap gap-1.5 mb-2">
                  {deck.bannedCards.map(card => (
                    <span class="inline-flex items-center text-sm font-beleren text-red-200 bg-red-500/15 rounded px-2 py-0.5" lang="en">
                      {card.name}
                    </span>
                  ))}
                </p>
                <p class="text-sm text-red-200/80 leading-relaxed">
                  {t('decklist.bannedCardsHelp', locale)}
                  {' '}
                  <a href={route('banlist', locale)} class="underline hover:no-underline">{t('nav.banlist', locale)}</a>
                </p>
              </div>
            </div>
          )}

          <!-- Narrower pills on a phone keep the three facts on one line. -->
          <ul class="mt-4 flex flex-wrap gap-1.5 sm:gap-2" role="list">
            <li class="stat-pill !px-2.5 sm:!px-3"><strong>{deckSize}</strong> {t('decklist.cardCount', locale)}</li>
            <li class="stat-pill !px-2.5 sm:!px-3"><strong>{stats.landCount}</strong> {t('decklist.lands', locale)}</li>
            <li class="stat-pill !px-2.5 sm:!px-3">{t('decklist.avgCost', locale)} <strong>{number.format(stats.averageCmc)}</strong></li>
          </ul>

          <div class="mt-4 lg:hidden">
            <DeckActions locale={locale} idPrefix="head" layout="row" />
          </div>
        </header>

        <!-- Desktop: stays beside the list it acts on. -->
        <aside class="hidden lg:flex lg:col-start-1 lg:row-start-1 lg:row-span-2 self-start sticky top-[96px] max-h-[calc(100vh-112px)] overflow-y-auto flex-col gap-4 p-1 -m-1">
          <div class:list={['relative', deck.partner?.imageUrl && 'h-[300px]']}>
            {deck.partner?.imageUrl && (
              <button type="button"
                      class="card-hover-trigger absolute right-0 top-0 w-[170px] rotate-[4deg] overflow-hidden rounded-[4.75%/3.5%] shadow-card"
                      data-card-name={deck.partner.name}
                      data-card-image={deck.partner.imageUrl}>
                <img src={deck.partner.imageUrl} alt={deck.partner.name} width="488" height="680" class="block w-full h-auto" decoding="async" />
              </button>
            )}
            {deck.commander?.imageUrl ? (
              <button type="button"
                      class:list={[
                        'card-hover-trigger block overflow-hidden rounded-[4.75%/3.5%] shadow-card',
                        deck.partner?.imageUrl ? 'absolute left-0 top-10 w-[180px] -rotate-3' : 'w-full',
                        isBanned && 'grayscale',
                      ]}
                      data-card-name={deck.commander.name}
                      data-card-image={deck.commander.imageUrl}>
                <img src={deck.commander.imageUrl} alt={deck.commander.name} width="488" height="680"
                     class="block w-full h-auto" fetchpriority="high" decoding="async" />
              </button>
            ) : (
              <p class="panel p-4 font-beleren text-lg text-text-primary" lang="en">{data.commander}</p>
            )}
          </div>

          <DeckActions locale={locale} idPrefix="side" layout="stack" />

          <div class="panel p-4 flex flex-col gap-3">
            <h2 class="font-heading font-bold text-base uppercase tracking-wider text-text-primary">{t('decklist.manaCurve', locale)}</h2>
            <p class="text-xs leading-relaxed text-text-muted">{t('decklist.curveHelp', locale)}</p>
            <ManaCurve distribution={stats.cmcDistribution} locale={locale} />
            <p class="text-sm text-text-secondary">{t('decklist.avgCost', locale)} <strong class="text-text-primary">{number.format(stats.averageCmc)}</strong></p>
          </div>
        </aside>

        <div class="min-w-0 lg:col-start-2 lg:row-start-2">
          <div class="flex flex-wrap items-center justify-between gap-3 py-3 border-t border-white/8 lg:justify-start lg:gap-x-6" data-needs-js>
            <div class="inline-flex gap-0.5 p-[3px] rounded-lg bg-bg-secondary border border-white/10" role="group" aria-label={t('decklist.viewLabel', locale)}>
              <button type="button" class="view-toggle" data-view-button="list" aria-pressed="true"
                      data-analytics="decklist_display" data-analytics-view="list">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                {t('decklist.viewList', locale)}
              </button>
              <button type="button" class="view-toggle" data-view-button="visual" aria-pressed="false"
                      data-analytics="decklist_display" data-analytics-view="visual">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="9" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                {t('decklist.viewVisual', locale)}
              </button>
            </div>

            <button type="button" class="arrange-toggle lg:hidden" aria-expanded="false" aria-controls="deck-arrange" data-arrange-toggle>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
              <span class="sr-only">{t('decklist.arrange', locale)}</span>
              <span data-arrange-summary>{t('decklist.groupType', locale)}</span>
              <span aria-hidden="true">▾</span>
            </button>

            <div id="deck-arrange" class="hidden data-[open=true]:flex lg:flex w-full lg:w-auto flex-col lg:flex-row gap-3 lg:gap-6 pb-1 lg:pb-0"
                 data-arrange-panel data-open="false">
              <div class="flex flex-wrap items-center gap-1.5" role="radiogroup" aria-labelledby="deck-group-by">
                <span id="deck-group-by" class="w-24 lg:w-auto text-sm text-text-muted">{t('decklist.groupBy', locale)}</span>
                {groupOptions.map(([value, key]) => (
                  <label class="choice" data-analytics="decklist_group" data-analytics-by={value}>
                    <input type="radio" name="deck-group" value={value} checked={value === 'type'} class="sr-only" />
                    <span class="choice__box">{t(key, locale)}</span>
                  </label>
                ))}
              </div>
              <div class="flex flex-wrap items-center gap-1.5" role="radiogroup" aria-labelledby="deck-sort-by">
                <span id="deck-sort-by" class="w-24 lg:w-auto text-sm text-text-muted">{t('decklist.sortBy', locale)}</span>
                {sortOptions.map(([value, key]) => (
                  <label class="choice" data-analytics="decklist_sort" data-analytics-by={value}>
                    <input type="radio" name="deck-sort" value={value} checked={value === 'cost'} class="sr-only" />
                    <span class="choice__box">{t(key, locale)}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- Sticky: the way into 99 cards, or the active filter. -->
          <div class="sticky top-[68px] md:top-[76px] z-30 -mx-4 px-4 md:mx-0 md:px-0 bg-bg-primary/95 backdrop-blur-sm border-y border-white/8">
            <nav aria-label={t('decklist.contents', locale)} data-deck-nav>
              <ul class="flex items-center gap-1 overflow-x-auto scroll-x py-2 text-sm" role="list" data-deck-nav-list>
                {navGroups.map(group => (
                  <li class="flex-shrink-0">
                    <a href={`#${group.anchor}`} class="deck-nav__link">{group.label} <span class="text-text-muted tabular-nums">{group.total}</span></a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="py-2" hidden data-filter-bar>
              <div class="mb-2 lg:hidden">
                <ManaCurve distribution={stats.cmcDistribution} locale={locale} variant="chips" />
              </div>
              <div class="flex items-center justify-between gap-3 text-sm">
                <p class="text-text-secondary" data-filter-status></p>
                <button type="button" class="inline-flex flex-shrink-0 items-center gap-1.5 min-h-10 px-2 -mr-2 text-brand-orange-light hover:text-magic-gold transition-colors" data-filter-clear>
                  {t('decklist.clearFilter', locale)}<span aria-hidden="true">✕</span>
                </button>
              </div>
            </div>
            <p class="sr-only" role="status" data-filter-live></p>
          </div>

          <div id="cartes-bannies" class="pt-4 pb-10">
            <CardList cardsByType={deck.cardsByType} locale={locale} />
          </div>

          <section class="py-8 md:py-10 border-t border-white/8" aria-labelledby="deck-profile-title">
            <h2 id="deck-profile-title" class="section-title">{t('decklist.profile', locale)}</h2>
            <div class="grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)]">
              <div class="panel p-5 flex flex-col gap-3 col-span-2 lg:hidden">
                <h3 class="font-heading font-bold text-base uppercase tracking-wider text-text-primary">{t('decklist.manaCurve', locale)}</h3>
                <p class="text-sm leading-relaxed text-text-secondary">{t('decklist.curveHelp', locale)}</p>
                <ManaCurve distribution={stats.cmcDistribution} locale={locale} />
              </div>
              <DeckColors class="col-span-2 xl:col-span-1"
                          identity={identity}
                          symbols={stats.colorSymbols}
                          sources={stats.colorSources}
                          landSources={stats.landSources}
                          locale={locale} />
              <div class="panel p-4 sm:p-5 flex flex-col gap-1.5">
                <span class="font-heading font-bold text-4xl leading-none text-text-primary">{number.format(stats.averageCmc)}</span>
                <span class="text-sm leading-relaxed text-text-secondary">{tf('decklist.avgCostDetail', locale, { n: number.format(stats.averageCmcWithLands) })}</span>
              </div>
              <div class="panel p-4 sm:p-5 flex flex-col gap-1.5">
                <span class="font-heading font-bold text-4xl leading-none text-text-primary">{number.format(stats.landsPerHand)}</span>
                <span class="text-sm leading-relaxed text-text-secondary">{t('decklist.landsPerHand', locale)}</span>
              </div>
            </div>
          </section>

          <SampleHand locale={locale} librarySize={stats.totalCards} />

          {siblings.length > 0 && (
            <section class="py-8 md:py-10 border-t border-white/8">
              <h2 class="section-title">{t('decklist.siblings', locale)}</h2>
              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {siblings.map(sibling => (
                  <DeckCard deck={sibling} locale={locale} from="sibling" />
                ))}
              </div>
            </section>
          )}
        </div>
      </div>
    </div>

    <p class="sr-only" role="status" data-copy-live></p>
    <script id="deck-export-data" type="application/json" set:html={exportData} is:inline />
    <script id="deck-labels" type="application/json" set:html={JSON.stringify(clientLabels)} is:inline />
  </article>

  <script src="@/scripts/decklist-detail.ts"></script>
</Base>
