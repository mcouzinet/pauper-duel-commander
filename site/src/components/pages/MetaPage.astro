---
/**
 * Metagame.
 *
 * The site's most distinctive feature, and the one that told the reader least
 * about itself. It listed 68 commanders (39 of them played exactly once) as an
 * unbroken 7,500px column, gave no analysis window, no freshness, and offered no
 * way from a commander to the decks playing it.
 *
 * All the aggregation lives in lib/meta.ts (shared with the home page). What is
 * left here is presentation: a compact header that states the sample before
 * any number, then for each ranking (every player, or the top 4):
 *   - the mosaic, where a commander's tile is its share of the field and the
 *     long tail fills the last box: the shape of the meta before any figure;
 *   - a dense table for the exact figures, beside the guild grid and the
 *     colour columns.
 * A row of chips shows one ranking at a time. Without JavaScript the chips are
 * hidden and both rankings read one after the other.
 */
import Base from '@/layouts/Base.astro';
import MetaMosaic from '@/components/MetaMosaic.astro';
import GuildGrid from '@/components/GuildGrid.astro';
import ColorColumns from '@/components/ColorColumns.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, tf, localeTag, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { getMeta, type Aggregate, type CommanderStat } from '@/lib/meta';
import { formatBanlistDate } from '@/lib/banlist';
import { formatColorSymbols } from '@/lib/mana';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = await getMeta();

const hasData = meta.global.commanders.length > 0;
const top4HasData = meta.top4.commanders.length > 0;

/** Table rows before the fold. */
const VISIBLE = 15;

interface Panel {
  id: 'global' | 'top4';
  aggregate: Aggregate;
  glance: string;
  glanceHelp: string;
  intro: string | null;
  tableTitle: string;
  countLabel: string;
  ciTitle: string;
  colorTitle: string;
}

const panels: Panel[] = [
  {
    id: 'global',
    aggregate: meta.global,
    glance: t('meta.glanceTitle', locale),
    glanceHelp: t('meta.glanceHelp', locale),
    intro: null,
    tableTitle: t('meta.mostPlayed', locale),
    countLabel: t('meta.colPlayers', locale),
    ciTitle: t('meta.ciTitle', locale),
    colorTitle: t('meta.colorPresence', locale),
  },
  ...(top4HasData ? [{
    id: 'top4' as const,
    aggregate: meta.top4,
    glance: t('meta.top4GlanceTitle', locale),
    glanceHelp: t('meta.top4GlanceHelp', locale),
    intro: `${t('meta.top4Desc', locale)} ${meta.top4.tournamentCount} ${t('meta.tournaments', locale)} · ${meta.top4.total} ${t('meta.top4Spots', locale)}`,
    tableTitle: t('meta.top4Commanders', locale),
    countLabel: t('meta.colSpots', locale),
    ciTitle: t('meta.top4Ci', locale),
    colorTitle: t('meta.top4Colors', locale),
  }] : []),
];

const percent = new Intl.NumberFormat(localeTag(locale), { style: 'percent', maximumFractionDigits: 0 });
const share = (count: number, total: number) => {
  const value = total > 0 ? count / total : 0;
  return value > 0 && value < 0.005 ? `< ${percent.format(0.01)}` : percent.format(value);
};
/** Decklists filtered to this commander; the index reads ?commander= on load. */
const decklistHref = (name: string) => `${route('decklists', locale)}?commander=${encodeURIComponent(name)}`;
const struck = (c: CommanderStat) => c.isBanned && 'line-through decoration-red-500/70';

const title = t('meta.seoTitle', locale);
const description = hasData
  ? t('meta.seoDescription', locale)
      .replace('%tournaments%', String(meta.global.tournamentCount))
      .replace('%entries%', String(meta.global.total))
  : t('meta.subtitle', locale);
---
<Base title={title} description={description} bareTitle={false}>
  <div class="container mx-auto px-4 md:px-6 pt-5 md:pt-8 pb-12">
    <Breadcrumb locale={locale} items={[{ label: t('meta.title', locale) }]} />

    <header class="mt-4 pb-6 max-w-3xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-text-primary">{t('meta.title', locale)}</h1>
      <p class="mt-3 text-lg leading-relaxed text-text-secondary">{t('meta.subtitle', locale)}</p>

      {hasData && (
        <>
          <ul class="mt-4 flex flex-wrap gap-1.5 sm:gap-2" role="list">
            <li class="stat-pill"><strong>{meta.global.tournamentCount}</strong> {t('meta.tournaments', locale)}</li>
            <li class="stat-pill"><strong>{meta.global.total}</strong> {t('meta.playerEntries', locale)}</li>
            <li class="stat-pill"><strong>{meta.global.commanders.length}</strong> {t('meta.distinctCommanders', locale)}</li>
            <li class="stat-pill">{tf('metaPage.window', locale, {
              from: formatBanlistDate(meta.from, locale),
              to: formatBanlistDate(meta.to, locale),
            })}</li>
          </ul>
          <p class="mt-4 flex items-start gap-2 text-sm leading-relaxed text-text-muted">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-magic-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{t('metaPage.sampleWarning', locale)} {t('metaPage.freshness', locale)}</span>
          </p>
        </>
      )}
    </header>

    {hasData ? (
      <>
        {panels.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5 py-3 border-t border-white/8" role="radiogroup" aria-labelledby="meta-ranking-label" data-needs-js>
            <span id="meta-ranking-label" class="mr-1 text-sm text-text-muted">{t('meta.rankingLabel', locale)}</span>
            <label class="choice" data-analytics="meta_scope" data-analytics-scope="global">
              <input type="radio" name="meta-ranking" value="global" checked class="sr-only" />
              <span class="choice__box">{t('meta.allPlayers', locale)}</span>
            </label>
            <label class="choice" data-analytics="meta_scope" data-analytics-scope="top4">
              <input type="radio" name="meta-ranking" value="top4" class="sr-only" />
              <span class="choice__box">{t('meta.top4Short', locale)}</span>
            </label>
          </div>
        )}

        {panels.map((panel, index) => {
          const a = panel.aggregate;
          // Folding a single row costs more than showing it.
          const cut = a.commanders.length === VISIBLE + 1 ? VISIBLE + 1 : VISIBLE;
          const head = a.commanders.slice(0, cut);
          const rest = a.commanders.slice(cut);
          return (
            <section class="scroll-mt-24 border-t border-white/8 pt-6 md:pt-8 pb-8" aria-labelledby={`meta-${panel.id}-title`} data-meta-panel={panel.id}>
              <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 mb-4">
                <h2 id={`meta-${panel.id}-title`} class="section-title !mb-0">{panel.glance}</h2>
                <p class="text-sm text-text-secondary">{panel.glanceHelp}</p>
              </div>
              {panel.intro && <p class="-mt-2 mb-4 text-sm text-text-secondary">{panel.intro}</p>}

              <MetaMosaic commanders={a.commanders} total={a.total} unattributed={a.unattributed} locale={locale} label={panel.glance} eager={index === 0} />

              <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-start">
                <section class="panel p-3 sm:p-5" aria-labelledby={`meta-${panel.id}-table`}>
                  <h3 id={`meta-${panel.id}-table`} class="px-1 mb-3 font-heading font-bold text-base uppercase tracking-wider text-text-primary">{panel.tableTitle}</h3>
                  <table class="meta-table">
                    <thead>
                      <tr>
                        <th scope="col" class="w-8 pl-1">#</th>
                        <th scope="col">{t('meta.colCommander', locale)}</th>
                        <th scope="col" class="hidden sm:table-cell">{t('a11y.colors', locale)}</th>
                        <th scope="col" class="text-right">{t('meta.colShare', locale)}</th>
                        <th scope="col" class="hidden sm:table-cell text-right pr-1">{panel.countLabel}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {head.map(c => (
                        <tr>
                          <td class="pl-1 font-heading font-bold text-text-muted tabular-nums">{c.rank}</td>
                          <td>
                            <span class="flex items-center gap-2.5">
                              {c.image ? (
                                <span class:list={['w-8 h-8 flex-shrink-0 overflow-hidden rounded ring-1 ring-white/10 card-hover-trigger', c.isBanned && 'grayscale']}
                                      data-card-name={c.mainName} data-card-image={c.cardImage ?? c.image}>
                                  <img src={c.image} alt="" width="32" height="32" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                                </span>
                              ) : (
                                <span class="w-8 h-8 flex-shrink-0 rounded bg-bg-tertiary" aria-hidden="true"></span>
                              )}
                              <span class="min-w-0">
                                <a href={decklistHref(c.mainName)} lang="en"
                                   data-analytics="meta_commander_click" data-analytics-commander={c.mainName}
                                   class:list={['font-beleren text-[15px] leading-snug text-text-primary hover:text-brand-orange transition-colors', struck(c)]}>{c.mainName}</a>
                                {c.partnerName && <span class:list={['block font-beleren text-xs leading-snug text-text-secondary', struck(c)]} lang="en">+ {c.partnerName}</span>}
                                {c.isBanned && <span class="badge badge--danger uppercase tracking-wider mt-1">{t('meta.banned', locale)}</span>}
                              </span>
                            </span>
                          </td>
                          <td class="hidden sm:table-cell"><span class="inline-flex" set:html={formatColorSymbols(c.colors)} /></td>
                          <td class="text-right font-heading font-bold text-base text-text-primary tabular-nums">{share(c.count, a.total)}</td>
                          <td class="hidden sm:table-cell text-right pr-1 text-text-muted tabular-nums">{c.count}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  {rest.length > 0 && (
                    <details class="group/fold mt-2">
                      <summary class="cursor-pointer select-none inline-flex items-center min-h-11 px-1 text-sm font-semibold text-brand-orange hover:text-brand-orange-light transition-colors"
                               data-analytics="meta_expand">
                        <span class="group-open/fold:hidden">{tf('metaPage.showAll', locale, { n: rest.length })}</span>
                        <span class="hidden group-open/fold:inline">{t('metaPage.hideAll', locale)}</span>
                      </summary>
                      <ol class="mt-1 sm:columns-2 sm:gap-x-8 text-sm" role="list">
                        {rest.map(c => (
                          <li class="break-inside-avoid flex items-baseline gap-2 py-1.5 border-t border-white/6">
                            <span class="w-7 flex-shrink-0 text-right text-xs text-text-muted tabular-nums">{c.rank}</span>
                            <a href={decklistHref(c.mainName)} lang="en"
                               class:list={['flex-1 min-w-0 font-beleren text-text-secondary hover:text-brand-orange transition-colors', struck(c)]}>{c.mainName}</a>
                            <span class="flex-shrink-0 text-xs text-text-muted tabular-nums">{share(c.count, a.total)} · {c.count}</span>
                          </li>
                        ))}
                      </ol>
                    </details>
                  )}
                  {a.unattributed > 0 && (
                    <p class="mt-3 px-1 text-xs text-text-muted">{tf('metaPage.unattributed', locale, { n: a.unattributed })}</p>
                  )}
                </section>

                <div class="flex flex-col gap-6">
                  <GuildGrid counts={a.ciCounts} locale={locale} title={panel.ciTitle} />
                  <ColorColumns counts={a.colorCounts} total={a.total - a.unattributed} locale={locale} title={panel.colorTitle} />
                </div>
              </div>
            </section>
          );
        })}

        <div class="pt-6 border-t border-white/8 flex flex-wrap gap-3">
          <a href={route('tournaments', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('home.resultsCta', locale)}</a>
          <a href={route('decklists', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">{t('archive.allDecklists', locale)}</a>
        </div>
      </>
    ) : (
      <div class="panel p-6 max-w-2xl">
        <h2 class="font-heading font-bold text-xl uppercase tracking-wide text-text-primary mb-2">{t('meta.noData', locale)}</h2>
        <p class="text-text-secondary">{t('meta.noDataDesc', locale)}</p>
      </div>
    )}
  </div>

  <script>
    /**
     * One ranking at a time. Both are in the HTML (they read one after the
     * other without JavaScript); the radios hide the other. A browser that
     * restores the radio on "back" gets the matching panel.
     */
    const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="meta-ranking"]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-meta-panel]')];

    function show(id: string) {
      for (const panel of panels) panel.hidden = panel.dataset.metaPanel !== id;
    }

    if (radios.length > 0) {
      show(radios.find(radio => radio.checked)?.value ?? 'global');
      for (const radio of radios) {
        radio.addEventListener('change', () => {
          show(radio.value);
          // Switching from far down the page: start the new ranking at its top.
          const panel = panels.find(p => p.dataset.metaPanel === radio.value);
          if (panel && panel.getBoundingClientRect().top < 0) panel.scrollIntoView({ block: 'start' });
        });
      }
    }

    window.pdcTrack?.('meta_view', {});
  </script>
</Base>
