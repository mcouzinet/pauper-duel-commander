---
/**
 * Metagame.
 *
 * The site's most distinctive feature, and the one that told the reader least
 * about itself. It listed 68 commanders — 39 of them played exactly once — as an
 * unbroken 7,500px column, gave no analysis window, no freshness, and offered no
 * way from a commander to the decks playing it.
 *
 * All the aggregation moved to lib/meta.ts (shared with the home page). What is
 * left here is presentation: sample banner first, top 15 with the tail folded,
 * a trend against the earlier tournaments, and every commander linking out.
 */
import Base from '@/layouts/Base.astro';
import CommanderRanking from '@/components/CommanderRanking.astro';
import ColorPieChart from '@/components/ColorPieChart.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import { getMeta, type Aggregate } from '@/lib/meta';
import { colorIdentityLabel, sortColorCounts } from '@/lib/colors';
import { formatBanlistDate } from '@/lib/banlist';
import { formatColorSymbols } from '@/lib/mana';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = await getMeta();

const hasData = meta.global.commanders.length > 0;
const top4HasData = meta.top4.commanders.length > 0;

/** Rows shown before the fold. */
const VISIBLE = 15;

interface CiRow {
  key: string;
  count: number;
  pct: number;
  barWidth: number;
  label: string;
  manaHtml: string;
}

function ciRows(aggregate: Aggregate): CiRow[] {
  const sorted = Object.entries(aggregate.ciCounts).sort((a, b) => b[1] - a[1]);
  const total = sorted.reduce((sum, [, count]) => sum + count, 0);
  const max = sorted.reduce((m, [, count]) => Math.max(m, count), 0);

  return sorted.map(([key, count]) => ({
    key,
    count,
    pct: total > 0 ? Math.round((count / total) * 100) : 0,
    barWidth: max > 0 ? Math.round((count / max) * 100) : 0,
    label: colorIdentityLabel(key, locale),
    manaHtml: formatColorSymbols(key === 'C' ? 'C' : key),
  }));
}

const globalCi = ciRows(meta.global);
const top4Ci = ciRows(meta.top4);
const globalCiTotal = globalCi.reduce((sum, row) => sum + row.count, 0);
const top4CiTotal = top4Ci.reduce((sum, row) => sum + row.count, 0);

const sampleLabel = t('metaPage.sample', locale)
  .replace('%tournaments%', String(meta.global.tournamentCount))
  .replace('%entries%', String(meta.global.total))
  .replace('%from%', formatBanlistDate(meta.from, locale))
  .replace('%to%', formatBanlistDate(meta.to, locale));

const title = locale === 'fr'
  ? 'Méta Pauper Duel Commander : généraux les plus joués'
  : 'Pauper Duel Commander metagame: most played commanders';
const description = hasData
  ? (locale === 'fr'
      ? `Les généraux les plus joués en Pauper Duel Commander, mesurés sur ${meta.global.tournamentCount} tournois et ${meta.global.total} entrées joueurs. Identités de couleur, répartition et top 4.`
      : `The most played Pauper Duel Commander commanders, measured across ${meta.global.tournamentCount} tournaments and ${meta.global.total} player entries. Color identities, distribution and top 4.`)
  : t('meta.subtitle', locale);
---
<Base title={title} description={description} bareTitle={false}>

  <section class="page-head">
    <div class="page-head__bg"></div>
    <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
      <img src="/img/cards-background.webp" alt="" aria-hidden="true"
           width="1024" height="356" class="w-full h-full object-cover" />
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-4xl">
        <Breadcrumb locale={locale} items={[{ label: t('meta.title', locale) }]} />

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-magic-gradient mt-3 mb-3">
          {t('meta.title', locale)}
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl mb-5">
          {t('meta.subtitle', locale)}
        </p>

        {hasData && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="stat-pill">
              <strong>{meta.global.tournamentCount}</strong> {t('meta.tournaments', locale)}
            </span>
            <span class="stat-pill">
              <strong>{meta.global.total}</strong> {t('meta.playerEntries', locale)}
            </span>
            <span class="stat-pill">
              {formatBanlistDate(meta.from, locale)} — {formatBanlistDate(meta.to, locale)}
            </span>
          </div>
        )}
      </div>
    </div>
  </section>

  {hasData ? (
    <>
      <!-- Sample size, stated before any number is read ---------------------->
      <section class="border-b border-card-border/25 bg-bg-secondary/50">
        <div class="container mx-auto px-4 md:px-6 py-4">
          <div class="max-w-4xl flex items-start gap-3">
            <svg class="w-5 h-5 text-magic-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-sm">
              <p class="text-text-secondary">{sampleLabel}</p>
              <p class="text-text-muted mt-0.5">
                {t('metaPage.sampleWarning', locale)} {t('metaPage.freshness', locale)}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Global metagame ---------------------------------------------------->
      <section class="py-10 md:py-14">
        <div class="container mx-auto px-4 md:px-6">
          <div class="max-w-6xl">
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-6">
              {t('meta.global', locale)}
            </h2>

            <div class="grid lg:grid-cols-5 gap-5 lg:gap-8 items-start">

              <div class="lg:col-span-3 min-w-0">
                <h3 class="section-title">{t('meta.mostPlayed', locale)}</h3>
                <div class="panel p-3 sm:p-4">
                  <CommanderRanking
                    commanders={meta.global.commanders}
                    total={meta.global.total}
                    locale={locale}
                    limit={VISIBLE}
                    foldRest={true}
                    showTrend={true}
                  />
                  <p class="text-xs text-text-muted mt-4 pt-3 border-t border-white/8">
                    {t('metaPage.trendHint', locale)}
                  </p>
                </div>
              </div>

              <div class="lg:col-span-2 min-w-0 space-y-6">
                {globalCi.length > 0 && (
                  <div>
                    <h3 class="section-title">{t('meta.ciTitle', locale)}</h3>
                    <div class="panel p-3 sm:p-4">
                      <ul class="space-y-2">
                        {globalCi.map(row => (
                          <li class="py-1">
                            <div class="flex items-center justify-between gap-2 mb-1">
                              <span class="flex items-center gap-2 min-w-0">
                                <span class="flex items-center gap-0.5 flex-shrink-0" set:html={row.manaHtml} />
                                <span class="text-xs sm:text-sm text-text-primary truncate">{row.label}</span>
                              </span>
                              <span class="flex-shrink-0 text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                {row.count}<span class="text-text-muted">/{globalCiTotal}</span>
                                <span class="ml-1 text-magic-gold font-semibold">{row.pct}%</span>
                              </span>
                            </div>
                            <div class="w-full h-1.5 bg-bg-primary/60 rounded-full overflow-hidden" aria-hidden="true">
                              <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold"
                                   style={`width: ${row.barWidth}%`}></div>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}

                {Object.keys(meta.global.colorCounts).length > 0 && (
                  <div>
                    <h3 class="section-title">{t('meta.colorDist', locale)}</h3>
                    <ColorPieChart colorCounts={sortColorCounts(meta.global.colorCounts)} locale={locale} />
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Top 4 -------------------------------------------------------------->
      {top4HasData && (
        <section class="py-10 md:py-14 border-t border-card-border/20 bg-bg-secondary/40">
          <div class="container mx-auto px-4 md:px-6">
            <div class="max-w-6xl">
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-magic-gradient mb-2">
                {t('meta.top4', locale)}
              </h2>
              <p class="text-sm text-text-secondary mb-6">
                {t('meta.top4Desc', locale)}{' '}
                <strong class="text-magic-gold">{meta.top4.tournamentCount}</strong> {t('meta.tournaments', locale)}
                {' — '}
                <strong class="text-magic-gold">{meta.top4.total}</strong> {t('meta.top4Spots', locale)}
              </p>

              <div class="grid lg:grid-cols-5 gap-5 lg:gap-8 items-start">
                <div class="lg:col-span-3 min-w-0">
                  <h3 class="section-title">{t('meta.top4Commanders', locale)}</h3>
                  <div class="panel p-3 sm:p-4">
                    <CommanderRanking
                      commanders={meta.top4.commanders}
                      total={meta.top4.total}
                      locale={locale}
                      limit={VISIBLE}
                      foldRest={true}
                    />
                  </div>
                </div>

                <div class="lg:col-span-2 min-w-0 space-y-6">
                  {top4Ci.length > 0 && (
                    <div>
                      <h3 class="section-title">{t('meta.top4Ci', locale)}</h3>
                      <div class="panel p-3 sm:p-4">
                        <ul class="space-y-2">
                          {top4Ci.map(row => (
                            <li class="py-1">
                              <div class="flex items-center justify-between gap-2 mb-1">
                                <span class="flex items-center gap-2 min-w-0">
                                  <span class="flex items-center gap-0.5 flex-shrink-0" set:html={row.manaHtml} />
                                  <span class="text-xs sm:text-sm text-text-primary truncate">{row.label}</span>
                                </span>
                                <span class="flex-shrink-0 text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                  {row.count}<span class="text-text-muted">/{top4CiTotal}</span>
                                  <span class="ml-1 text-magic-gold font-semibold">{row.pct}%</span>
                                </span>
                              </div>
                              <div class="w-full h-1.5 bg-bg-primary/60 rounded-full overflow-hidden" aria-hidden="true">
                                <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold"
                                     style={`width: ${row.barWidth}%`}></div>
                              </div>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  )}

                  {Object.keys(meta.top4.colorCounts).length > 0 && (
                    <div>
                      <h3 class="section-title">{t('meta.top4Colors', locale)}</h3>
                      <ColorPieChart colorCounts={sortColorCounts(meta.top4.colorCounts)} locale={locale} />
                    </div>
                  )}
                </div>
              </div>

              <div class="flex flex-wrap gap-3 mt-8">
                <a href={route('tournaments', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
                  {t('home.resultsCta', locale)}
                </a>
                <a href={route('decklists', locale)} class="btn-secondary !px-5 !py-2.5 !text-sm">
                  {t('archive.allDecklists', locale)}
                </a>
              </div>
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="py-16">
      <div class="container mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-3">{t('meta.noData', locale)}</h2>
        <p class="text-text-secondary">{t('meta.noDataDesc', locale)}</p>
      </div>
    </section>
  )}

  <script>
    window.pdcTrack?.('meta_view', {});
  </script>
</Base>
