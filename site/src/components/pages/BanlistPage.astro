---
import Base from '@/layouts/Base.astro';
import BanListGrid from '@/components/BanListGrid.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { t, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const banlistPath = join(process.cwd(), 'content', 'banlist.json');
const banlist = JSON.parse(readFileSync(banlistPath, 'utf-8'));
const bannedAsCommander: string[] = banlist.bannedAsCommander ?? [];
const bannedInDeck: string[] = banlist.bannedInDeck ?? [];

// Announcement history, newest first.
const history = (await getCollection('banlistHistory'))
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

// Group an announcement's changes by type, in a fixed display order.
const CHANGE_ORDER = ['banned', 'unbanned', 'restricted'] as const;
const CHANGE_STYLE: Record<string, string> = {
  banned: 'text-red-400 border-red-500/30 bg-red-500/5',
  unbanned: 'text-green-400 border-green-500/30 bg-green-500/5',
  restricted: 'text-yellow-400 border-yellow-500/30 bg-yellow-500/5',
};
const CHANGE_LABEL: Record<string, string> = {
  banned: t('banlist.changeBanned', locale),
  unbanned: t('banlist.changeUnbanned', locale),
  restricted: t('banlist.changeRestricted', locale),
};

function groupChanges(changes: { card: string; type: string; experimental?: boolean }[]) {
  return CHANGE_ORDER
    .map(type => ({ type, cards: changes.filter(c => c.type === type) }))
    .filter(g => g.cards.length > 0);
}

function formatDate(iso: string): string {
  return new Date(iso + 'T00:00:00').toLocaleDateString(t('common.dateLocale', locale), {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---
<Base title={t('nav.banlist', locale)}>

  <!-- Hero -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="absolute inset-0 opacity-5">
      <img src="/img/artefacts.jpg" alt="" aria-hidden="true" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/4 left-10 w-64 h-64 bg-brand-orange/20 rounded-full blur-[100px] animate-float"></div>
      <div class="absolute bottom-1/4 right-10 w-80 h-80 bg-magic-gold/20 rounded-full blur-[120px] animate-float" style="animation-delay: -3s;"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center max-w-5xl mx-auto">
        <div class="inline-block mb-10">
          <span class="px-6 py-3 glass-effect border border-magic-purple/30 rounded-full text-magic-gold text-sm font-heading font-semibold tracking-wider uppercase shadow-card">
            Banlist
          </span>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-heading font-bold mb-8 leading-tight">
          <span class="block text-text-primary mb-2">{t('banlist.titleTop', locale)}</span>
          <span class="block text-magic-gradient">{t('banlist.titleBottom', locale)}</span>
        </h1>

        <div class="text-xl md:text-2xl text-text-secondary mb-14 max-w-3xl mx-auto" style="line-height: 32px;">
          <p>{t('banlist.intro', locale)}</p>
        </div>

        <div class="flex flex-wrap gap-6 justify-center items-center">
          <a href="#banned-commander" class="btn-secondary">{t('banlist.asCommander', locale)}</a>
          <a href="#banned-deck" class="btn-secondary">{t('banlist.inDeck', locale)}</a>
          {history.length > 0 && (
            <a href="#history" class="btn-secondary">{t('banlist.historyTitle', locale)}</a>
          )}
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-bg-primary to-transparent"></div>
  </section>

  <!-- Banned as commander -->
  <section id="banned-commander" class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">
          {t('banlist.asCommander', locale)}
        </h2>
        <p class="text-lg text-text-secondary max-w-3xl mx-auto leading-relaxed">
          {t('banlist.asCommanderDesc', locale)}
        </p>
      </div>

      <BanListGrid cards={bannedAsCommander} />
    </div>
  </section>

  <!-- Banned in deck -->
  <section id="banned-deck" class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">
          {t('banlist.inDeck', locale)}
        </h2>
        <p class="text-lg text-text-secondary max-w-3xl mx-auto leading-relaxed">
          {t('banlist.inDeckDesc', locale)}
        </p>
      </div>

      <BanListGrid cards={bannedInDeck} />
    </div>
  </section>

  <!-- Announcement history -->
  {history.length > 0 && (
    <section id="history" class="py-24 relative">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-heading font-bold text-magic-gradient mb-6">
              {t('banlist.historyTitle', locale)}
            </h2>
            <p class="text-lg text-text-secondary max-w-3xl mx-auto leading-relaxed">
              {t('banlist.historyCadence', locale)}
            </p>
          </div>

          <div class="relative border-l border-card-border pl-6 md:pl-8 space-y-8 ml-2">
            {history.map(entry => (
              <article class="relative">
                {/* timeline dot */}
                <span class="absolute -left-[31px] md:-left-[39px] top-1.5 w-3 h-3 rounded-full bg-brand-orange ring-4 ring-bg-primary"></span>

                <div class="magic-card p-6">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-5">
                    <span class="text-xs font-heading font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full border border-magic-purple/30 text-magic-gold">
                      {entry.data.kind === 'initial' ? t('banlist.kindInitial', locale) : t('banlist.kindUpdate', locale)}
                    </span>
                    <span class="text-text-primary font-semibold">{formatDate(entry.data.date)}</span>
                    <span class="text-sm text-text-muted">{t('banlist.by', locale)} {entry.data.source}</span>
                  </div>

                  <div class="space-y-4">
                    {groupChanges(entry.data.changes).map(group => (
                      <div class="flex flex-col sm:flex-row sm:items-start gap-x-4 gap-y-2">
                        <span class={`shrink-0 text-xs font-heading font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${CHANGE_STYLE[group.type]}`}>
                          {CHANGE_LABEL[group.type]}
                        </span>
                        <div class="flex flex-wrap gap-2">
                          {group.cards.map(c => (
                            <span class="inline-flex items-center gap-1.5 text-sm font-beleren text-text-primary bg-bg-tertiary rounded-md px-2.5 py-1">
                              {c.card}
                              {c.experimental && (
                                <span class="text-[10px] font-heading font-semibold uppercase tracking-wider text-yellow-400/90">{t('banlist.experimental', locale)}</span>
                              )}
                            </span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>

                  {entry.data.notes.length > 0 && (
                    <details class="mt-5 group">
                      <summary class="cursor-pointer text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors select-none">
                        {t('banlist.details', locale)}
                      </summary>
                      <div class="mt-3 space-y-3 border-l-2 border-card-border pl-4">
                        {entry.data.notes.map(note => (
                          <p class="text-sm text-text-secondary leading-relaxed">{note[locale]}</p>
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

</Base>
