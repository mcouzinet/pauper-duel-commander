---
/**
 * Ban list.
 *
 * Probably the most-consulted page on the site, and the one that hid the fact a
 * player needs first: `lastUpdated` sat in the JSON and was never rendered, so
 * there was no way to tell whether what you were reading was current.
 *
 * Now: freshness and count in the header, the latest announcement summarised at
 * the top, a search box (the names are in the DOM, so filtering them is free),
 * and a "new" badge on whatever the last announcement moved.
 */
import Base from '@/layouts/Base.astro';
import BanListGrid from '@/components/BanListGrid.astro';
import AnnouncementChanges from '@/components/AnnouncementChanges.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t, type Locale } from '@/lib/i18n';
import { route } from '@/lib/routes';
import {
  getBanlist,
  getAnnouncements,
  getBanlistDate,
  formatBanlistDate,
  recentlyChangedNames,
  noteText,
} from '@/lib/banlist';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const banlist = getBanlist();
const [history, updatedAt, recentlyChanged] = await Promise.all([
  getAnnouncements(),
  getBanlistDate(),
  recentlyChangedNames(),
]);

const latest = history[0] ?? null;

const updatedLabel = formatBanlistDate(updatedAt, locale);
const title = t('banlist.seoTitle', locale).replace('%date%', updatedLabel);
const description = t('banlist.seoDescription', locale)
  .replace('%total%', String(banlist.cards.length))
  .replace('%commander%', String(banlist.bannedAsCommander.length))
  .replace('%deck%', String(banlist.bannedInDeck.length))
  .replace('%date%', updatedLabel);
---
<Base title={title} description={description} bareTitle={true}>

  <section class="page-head">
    <div class="page-head__bg"></div>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none">
      <img src="/img/artefacts.webp" alt="" aria-hidden="true"
           width="1280" height="950" class="w-full h-full object-cover" />
    </div>

    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="max-w-4xl">
        <Breadcrumb locale={locale} items={[{ label: t('nav.banlist', locale) }]} />

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold mt-3 mb-4">
          <span class="text-text-primary">{t('banlist.titleTop', locale)} </span>
          <span class="text-magic-gradient">{t('banlist.titleBottom', locale)}</span>
        </h1>

        <!-- Freshness first: this is the reason the page gets opened. -->
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="stat-pill">
            <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {t('banlist.lastUpdate', locale)} <strong>{updatedLabel}</strong>
          </span>
          <span class="stat-pill"><strong>{banlist.cards.length}</strong> {t('banlist.cardCount', locale)}</span>
          <a href={route('rules', locale)} class="stat-pill hover:border-brand-orange/50 hover:text-brand-orange transition-colors no-underline">
            {t('banlist.seeRules', locale)}
          </a>
          <a href={route('validator', locale)} class="stat-pill hover:border-brand-orange/50 hover:text-brand-orange transition-colors no-underline">
            {t('banlist.checkDeck', locale)}
          </a>
        </div>

        <p class="text-text-secondary leading-relaxed max-w-3xl">{t('banlist.intro', locale)}</p>
      </div>
    </div>
  </section>

  <!-- Latest announcement: what changed, for the reader who already knows the list -->
  {latest && (
    <section class="border-b border-card-border/25 bg-bg-secondary/50">
      <div class="container mx-auto px-4 md:px-6 py-6">
        <div class="max-w-4xl">
          <div class="panel p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
              <span class="eyebrow">{t('banlist.latestAnnouncement', locale)}</span>
              <span class="text-text-primary font-semibold">{formatBanlistDate(latest.date, locale)}</span>
              <span class="text-sm text-text-muted">{t('banlist.by', locale)} {latest.source}</span>
            </div>

            <AnnouncementChanges changes={latest.changes} locale={locale} />

            <p class="mt-4">
              <a href="#history" class="text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors">
                {t('banlist.seeHistory', locale)} →
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <section id="banned-commander" class="py-10 md:py-12">
    <div class="container mx-auto px-4 md:px-6">
      <div class="mb-6 max-w-3xl">
        <h2 class="section-title !text-2xl sm:!text-3xl !mb-2">{t('banlist.asCommander', locale)}</h2>
        <p class="text-sm text-text-secondary leading-relaxed">{t('banlist.asCommanderDesc', locale)}</p>
      </div>
      <BanListGrid cards={banlist.bannedAsCommander} locale={locale} recentlyChanged={recentlyChanged} />
    </div>
  </section>

  <section id="banned-deck" class="py-10 md:py-12 border-t border-card-border/20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="mb-6 max-w-3xl">
        <h2 class="section-title !text-2xl sm:!text-3xl !mb-2">{t('banlist.inDeck', locale)}</h2>
        <p class="text-sm text-text-secondary leading-relaxed">{t('banlist.inDeckDesc', locale)}</p>
      </div>
      <BanListGrid cards={banlist.bannedInDeck} locale={locale} recentlyChanged={recentlyChanged} />
    </div>
  </section>

  {history.length > 0 && (
    <section id="history" class="py-12 md:py-16 border-t border-card-border/20 bg-bg-secondary/40">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-4xl">
          <h2 class="section-title !text-2xl sm:!text-3xl !mb-2">{t('banlist.historyTitle', locale)}</h2>
          <p class="text-sm text-text-secondary mb-8">{t('banlist.historyCadence', locale)}</p>

          <ol class="relative border-l border-card-border/40 pl-6 md:pl-8 space-y-6 ml-2">
            {history.map(entry => (
              <li class="relative">
                <span class="absolute -left-[31px] md:-left-[39px] top-2 w-3 h-3 rounded-full bg-brand-orange ring-4 ring-bg-secondary" aria-hidden="true"></span>

                <article class="panel p-5">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
                    <span class="badge badge--gold uppercase tracking-wider">
                      {entry.kind === 'initial' ? t('banlist.kindInitial', locale) : t('banlist.kindUpdate', locale)}
                    </span>
                    <span class="text-text-primary font-semibold">{formatBanlistDate(entry.date, locale)}</span>
                    <span class="text-sm text-text-muted">{t('banlist.by', locale)} {entry.source}</span>
                  </div>

                  <AnnouncementChanges changes={entry.changes} locale={locale} />

                  {entry.notes.length > 0 && (
                    <details class="mt-4" data-analytics="banlist_history_open">
                      <summary class="cursor-pointer text-sm font-semibold text-brand-orange hover:text-magic-gold transition-colors select-none">
                        {t('banlist.details', locale)}
                      </summary>
                      <div class="mt-3 space-y-3 border-l-2 border-card-border/40 pl-4">
                        {entry.notes.map(note => (
                          <p class="text-sm text-text-secondary leading-relaxed">{noteText(note, locale)}</p>
                        ))}
                      </div>
                    </details>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <script>
    window.pdcTrack?.('banlist_view', {});
  </script>
</Base>
