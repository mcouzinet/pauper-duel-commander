---
/**
 * Grid of banned cards.
 *
 * Three things were wrong with the previous version, all of which mattered most
 * to the reader it was written for — someone checking a card mid-tournament, on a
 * phone:
 *
 *   - the name existed only inside the image, so the page could not be searched
 *     (not by the site, not by the browser's own find);
 *   - `card.imageUrl && (...)` meant a card whose art failed to resolve was not
 *     rendered *at all* — a banned card silently absent from the ban list;
 *   - full-width scans, two per row on mobile.
 *
 * Names are text now, missing art degrades to a labelled placeholder, and each
 * tile is a search target via `data-card-name`.
 */
import { t, type Locale } from '@/lib/i18n';
import { getCardByName, getCardImage } from '@/lib/scryfall';

interface Props {
  cards: string[];
  locale: Locale;
  /** Cards touched by the latest announcement get a "new" badge. */
  recentlyChanged?: Set<string>;
}

const { cards, locale, recentlyChanged = new Set() } = Astro.props;

const enriched = await Promise.all(
  cards.map(async name => {
    const card = await getCardByName(name);
    return {
      name,
      // `normal` rather than `border_crop`: same legibility at a third of the
      // bytes on the 17 scans this page loads.
      imageUrl: card ? getCardImage(card, 'normal') : null,
      isNew: recentlyChanged.has(name.toLowerCase()),
    };
  }),
);

const scryfallUrl = (name: string) =>
  `https://scryfall.com/search?q=${encodeURIComponent(`!"${name}"`)}`;
---

<ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-3 sm:gap-4" data-banlist-grid>
  {enriched.map(card => (
    <li data-card-name={card.name.toLowerCase()} class="min-w-0">
      <a href={scryfallUrl(card.name)} target="_blank" rel="noopener noreferrer"
         class="group block no-underline"
         aria-label={`${card.name} — ${t('banlist.viewOnScryfall', locale)}`}>
        <span class:list={[
          "relative block overflow-hidden rounded-lg bg-bg-tertiary aspect-[488/680]",
          card.isNew && "ring-2 ring-green-400/70 ring-offset-2 ring-offset-bg-primary",
        ]}>
          {card.imageUrl ? (
            <img src={card.imageUrl} alt=""
                 width="488" height="680"
                 class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                 loading="lazy" decoding="async" />
          ) : (
            <span class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-3 text-center">
              <svg class="w-7 h-7 text-magic-gold/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-xs text-text-muted leading-tight">{t('banlist.imageMissing', locale)}</span>
            </span>
          )}

        </span>

        <span class="block mt-1.5 font-beleren text-xs sm:text-sm text-text-secondary group-hover:text-brand-orange transition-colors leading-tight" lang="en">
          {card.name}
        </span>

        {card.isNew && (
          <span class="badge--new-solid mt-1">{t('banlist.isNew', locale)}</span>
        )}
      </a>
    </li>
  ))}
</ul>
