---
import Base from '@/layouts/Base.astro';
import { t } from '@/lib/i18n';
import { getCollection } from 'astro:content';
import { getCardByName, getCardImage } from '@/lib/scryfall';
import { colorIdentityKey, mergeColorIdentities, colorIdentityLabel } from '@/lib/colors';
import { formatColorSymbols } from '@/lib/mana';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const locale = 'en';
const banlist = JSON.parse(readFileSync(join(process.cwd(), 'content', 'banlist.json'), 'utf-8'));
const bannedNames = new Set((banlist.cards as string[]).map((n: string) => n.toLowerCase()));

const entries = await getCollection('decklists');

// Enrich each decklist with commander data
const decklists = await Promise.all(entries.map(async (entry) => {
  const { commander, partner, title, author, archetype, date } = entry.data;

  const cmdCard = await getCardByName(commander);
  const partnerCard = partner ? await getCardByName(partner) : null;

  const cmdImage = cmdCard ? getCardImage(cmdCard, 'art_crop') : null;
  const colors = mergeColorIdentities(
    cmdCard?.color_identity ?? [],
    partnerCard?.color_identity ?? [],
  );
  const ciKey = colorIdentityKey(colors);
  const isBanned = bannedNames.has(commander.toLowerCase()) ||
    (partner ? bannedNames.has(partner.toLowerCase()) : false);

  return {
    slug: entry.id,
    title,
    commander,
    partner,
    author,
    archetype,
    date,
    commanderImage: cmdImage,
    colors,
    ciKey,
    isBanned,
  };
}));

// Sort by date DESC
decklists.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

// Collect filter options
const archetypes = [...new Set(decklists.map(d => d.archetype).filter(Boolean))].sort();
const colorIdentities = [...new Set(decklists.map(d => d.ciKey))].sort();
---
<Base title={t('archive.decklistTitle', locale)} description={t('archive.decklistDesc', locale)}>

  <!-- Hero -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="absolute inset-0 opacity-10">
      <img src="/img/cards-background.png" alt="" aria-hidden="true" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-heading font-bold text-magic-gradient mb-6">
          {t('archive.decklistTitle', locale)}
        </h1>
        <p class="text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
          {t('archive.decklistDesc', locale)}
        </p>
      </div>
    </div>
  </section>

  <!-- Filters -->
  <section class="py-8 bg-bg-secondary/50 border-b border-magic-gold/10">
    <div class="container mx-auto px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-4" id="decklist-filters">
          <div>
            <label class="block text-sm font-semibold text-text-secondary mb-2">
              {t('archive.archetypeLabel', locale)}
            </label>
            <select id="filter-archetype" class="w-full px-4 py-2 bg-bg-primary border border-magic-gold/20 rounded-lg text-text-primary focus:border-brand-orange focus:outline-none transition-colors">
              <option value="">{t('archive.allArchetypes', locale)}</option>
              {archetypes.map(a => <option value={a}>{a}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-text-secondary mb-2">
              {t('archive.colorLabel', locale)}
            </label>
            <select id="filter-color" class="w-full px-4 py-2 bg-bg-primary border border-magic-gold/20 rounded-lg text-text-primary focus:border-brand-orange focus:outline-none transition-colors">
              <option value="">{t('archive.allColors', locale)}</option>
              {colorIdentities.map(ci => <option value={ci}>{colorIdentityLabel(ci, locale)}</option>)}
            </select>
          </div>

          <div class="md:col-span-2 flex justify-center hidden" id="filter-reset-wrapper">
            <button id="filter-reset" class="text-sm text-brand-orange hover:text-magic-gold transition-colors">
              {t('archive.filterReset', locale)}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Decklists Grid -->
  <section class="py-16 bg-bg-primary">
    <div class="container mx-auto px-6">
      <div class="max-w-7xl mx-auto">

        {decklists.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12" id="decklist-grid">
            {decklists.map(deck => {
              const bannedBorder = deck.isBanned ? 'border-red-500/30' : 'border-magic-gold/10';
              const bannedGray = deck.isBanned ? 'grayscale' : '';
              const bannedStrike = deck.isBanned ? 'line-through decoration-red-500/70' : '';
              return (
                <article class="group relative" data-archetype={deck.archetype ?? ''} data-color={deck.ciKey}>
                  <a href={`/en/decklist/${deck.slug}/`} class="block h-full">
                    <div class={`relative overflow-hidden rounded-xl bg-bg-secondary border ${bannedBorder} hover:border-brand-orange/40 transition-all duration-300 shadow-card hover:shadow-card-hover h-full flex flex-col`}>
                      <div class={`aspect-[4/3] overflow-hidden bg-gradient-to-br from-bg-secondary to-bg-primary flex-shrink-0 relative ${bannedGray}`}>
                        {deck.commanderImage ? (
                          <img src={deck.commanderImage} alt={deck.commander}
                               class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                               loading="lazy" />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-16 h-16 text-magic-gold/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                            </svg>
                          </div>
                        )}
                        {deck.isBanned && (
                          <div class="absolute top-2 right-2 px-2 py-1 bg-red-600/90 border border-red-500/50 rounded text-[10px] font-bold text-white uppercase tracking-wider leading-none shadow-lg">
                            {t('meta.banned', locale)}
                          </div>
                        )}
                      </div>

                      <div class="p-4 flex-1 flex flex-col">
                        <div class="flex">
                          <div class="flex items-center gap-2 mr-auto">
                            <span set:html={formatColorSymbols(deck.colors)} />
                          </div>
                          {deck.archetype && (
                            <div class="flex flex-wrap gap-2 ml-auto">
                              <span class="text-xs px-2 py-1 glass-effect border border-white/10 rounded text-text-secondary">
                                {deck.archetype}
                              </span>
                            </div>
                          )}
                        </div>

                        <h2 class={`text-2xl font-beleren font-bold text-text-primary group-hover:text-brand-orange transition-colors mt-2 line-clamp-2 ${bannedStrike}`}>
                          {deck.commander}
                        </h2>
                        {deck.partner && (
                          <p class={`text-sm font-beleren text-magic-gold/70 mt-1 truncate ${bannedStrike}`}>
                            + {deck.partner}
                          </p>
                        )}
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-16">
            <svg class="w-24 h-24 text-magic-gold/20 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-4">
              {t('archive.noDecklistFound', locale)}
            </h2>
            <p class="text-text-secondary mb-6">
              {t('archive.noDecklistHint', locale)}
            </p>
            <a href={`/en/decklist`} class="inline-block px-6 py-3 bg-brand-orange text-white font-semibold rounded-lg hover:bg-brand-orange/90 transition-colors">
              {t('archive.viewAllDecklists', locale)}
            </a>
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- Client-side filter script -->
  <script>
    const archSelect = document.getElementById('filter-archetype') as HTMLSelectElement;
    const colorSelect = document.getElementById('filter-color') as HTMLSelectElement;
    const resetBtn = document.getElementById('filter-reset') as HTMLElement;
    const resetWrapper = document.getElementById('filter-reset-wrapper') as HTMLElement;
    const grid = document.getElementById('decklist-grid');

    function applyFilters() {
      if (!grid) return;
      const arch = archSelect?.value ?? '';
      const color = colorSelect?.value ?? '';
      const cards = grid.querySelectorAll<HTMLElement>('article[data-archetype]');

      let visible = 0;
      cards.forEach(card => {
        const matchArch = !arch || card.dataset.archetype === arch;
        const matchColor = !color || card.dataset.color === color;
        card.style.display = matchArch && matchColor ? '' : 'none';
        if (matchArch && matchColor) visible++;
      });

      if (resetWrapper) {
        resetWrapper.classList.toggle('hidden', !arch && !color);
      }
    }

    archSelect?.addEventListener('change', applyFilters);
    colorSelect?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', () => {
      if (archSelect) archSelect.value = '';
      if (colorSelect) colorSelect.value = '';
      applyFilters();
    });
  </script>
</Base>
