---
/**
 * Tournament detail page (English)
 *
 * Uses getStaticPaths to generate one page per tournament from the content collection.
 * Fetches Scryfall data at build time to enrich top 8 and meta with card images/colors.
 */
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '@/layouts/Base.astro';
import Top8Table from '@/components/Top8Table.astro';
import MetaPanel from '@/components/MetaPanel.astro';
import ColorPieChart from '@/components/ColorPieChart.astro';
import { t } from '@/lib/i18n';
import {
  formatDate,
  splitCommanderName,
  expandCommanderNames,
  sortColorCounts,
} from '@/lib/tournaments';
import { getCardsByNames, getCardImage } from '@/lib/scryfall';
import type { ScryfallCard } from '@/types/scryfall';

const locale = 'en';

// ---------------------------------------------------------------------------
// Static paths
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  const entries = await getCollection('tournaments');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

// ---------------------------------------------------------------------------
// Load banlist
// ---------------------------------------------------------------------------
const banlistPath = join(process.cwd(), 'content', 'banlist.json');
const banlistRaw = JSON.parse(readFileSync(banlistPath, 'utf-8')) as { cards: string[] };
const bannedNames = new Set(banlistRaw.cards.map((n: string) => n.toLowerCase()));

// ---------------------------------------------------------------------------
// Determine if tournament is past
// ---------------------------------------------------------------------------
const today = new Date().toISOString().slice(0, 10);
const isPast = data.date < today;
const dateFormatted = formatDate(data.date, locale);
const playerCount = data.actualPlayerCount || data.playerCount;

// ---------------------------------------------------------------------------
// Collect all commander names and batch-fetch Scryfall data
// ---------------------------------------------------------------------------
const allCommanderNames: string[] = [];
for (const t8 of data.top8) {
  if (t8.commanderName) allCommanderNames.push(t8.commanderName);
}
for (const meta of data.metaList) {
  allCommanderNames.push(meta.name);
}
const expandedNames = expandCommanderNames(allCommanderNames);
const uniqueNames = [...new Set(expandedNames.filter(Boolean))];
const cardsMap = uniqueNames.length > 0
  ? await getCardsByNames(uniqueNames)
  : new Map<string, ScryfallCard | null>();

// ---------------------------------------------------------------------------
// Resolve commander card (handles partner pairs: pick first found)
// ---------------------------------------------------------------------------
function resolveCommanderCard(name: string): ScryfallCard | null {
  const parts = splitCommanderName(name);
  for (const part of parts) {
    const card = cardsMap.get(part.toLowerCase()) ?? null;
    if (card) return card;
  }
  return null;
}

function getCommanderColors(name: string): string[] {
  const parts = splitCommanderName(name);
  const colors = new Set<string>();
  for (const part of parts) {
    const card = cardsMap.get(part.toLowerCase()) ?? null;
    if (card?.color_identity) {
      for (const c of card.color_identity) colors.add(c);
    }
  }
  return [...colors].sort();
}

function isCommanderBanned(name: string): boolean {
  const parts = splitCommanderName(name);
  return parts.some(part => bannedNames.has(part.toLowerCase()));
}

// ---------------------------------------------------------------------------
// Enrich Top 8
// ---------------------------------------------------------------------------
const top8 = data.top8
  .map(t8 => {
    const card = resolveCommanderCard(t8.commanderName);
    return {
      place: t8.place,
      playerName: t8.playerName,
      commanderName: t8.commanderName,
      score: t8.score,
      commanderImage: getCardImage(card, 'art_crop'),
      cardImage: getCardImage(card, 'normal'),
      decklistUrl: t8.decklistSlug ? `/${locale}/decklists/${t8.decklistSlug}/` : null,
      isBanned: isCommanderBanned(t8.commanderName),
    };
  })
  .sort((a, b) => a.place - b.place);

const topLabel = top8.length <= 4 ? 'Top 4' : 'Top 8';

// ---------------------------------------------------------------------------
// Compute meta stats
// ---------------------------------------------------------------------------
const totalParticipants = data.metaList.reduce((sum, m) => sum + m.count, 0);

const colorCounts: Record<string, number> = {};
const colorIdentityCounts: Record<string, number> = {};

const metaCommanders = data.metaList.map(meta => {
  const card = resolveCommanderCard(meta.name);
  const colors = getCommanderColors(meta.name);

  // Accumulate color counts
  if (colors.length > 0) {
    for (const c of colors) {
      colorCounts[c] = (colorCounts[c] ?? 0) + meta.count;
    }
  } else {
    colorCounts['C'] = (colorCounts['C'] ?? 0) + meta.count;
  }

  // Accumulate color identity counts
  const identityKey = colors.length > 0 ? colors.join('') : 'C';
  colorIdentityCounts[identityKey] = (colorIdentityCounts[identityKey] ?? 0) + meta.count;

  return {
    name: meta.name,
    count: meta.count,
    percentage: totalParticipants > 0 ? Math.round(meta.count / totalParticipants * 100) : 0,
    image: getCardImage(card, 'art_crop'),
    cardImage: getCardImage(card, 'normal'),
    colors,
    isBanned: isCommanderBanned(meta.name),
  };
});

const hasMeta = metaCommanders.length > 0;
const sortedColorCounts = sortColorCounts(colorCounts);

// Hero image: art_crop of the 1st-place commander
const heroImage = top8.length > 0 && top8[0].place === 1 ? top8[0].commanderImage : null;

const archiveUrl = `/${locale}/tournaments/`;
---
<Base title={data.title} description={`${data.title} — ${dateFormatted}`}>

  {/* ---- Compact Hero ---- */}
  <section class="tournament-hero relative overflow-hidden">
    {heroImage ? (
      <Fragment>
        <div class="absolute inset-0 opacity-15">
          <img src={heroImage} alt="" class="w-full h-full object-cover" aria-hidden="true" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/70 via-bg-secondary/90 to-bg-primary"></div>
      </Fragment>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    )}

    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-8 md:py-10">
      <div class="max-w-6xl mx-auto">
        <a href={archiveUrl}
           class="inline-flex items-center gap-1.5 text-xs text-text-muted hover:text-brand-orange transition-colors mb-3 uppercase tracking-wider font-heading">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          {t('tournament.label', locale)}
        </a>

        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <h1 class="text-2xl md:text-3xl font-heading font-bold text-magic-gradient leading-tight">
            {data.title}
          </h1>

          {/* Inline meta badges */}
          <div class="flex flex-wrap items-center gap-2 sm:flex-shrink-0">
            {dateFormatted && (
              <span class="tournament-badge tournament-badge--primary">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                {dateFormatted}
              </span>
            )}
            {data.location && (
              <span class="tournament-badge">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {data.location}{data.city ? `, ${data.city}` : ''}
              </span>
            )}
            {isPast && playerCount > 0 && (
              <span class="tournament-badge">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {playerCount} {t('tournament.players', locale)}
              </span>
            )}
            {!isPast && data.playerCount > 0 && (
              <span class="tournament-badge">
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {data.playerCount} spots
              </span>
            )}
            {data.signupUrl && (
              <a href={data.signupUrl} target="_blank" rel="noopener noreferrer"
                 class="tournament-badge hover:border-brand-orange/50 hover:text-brand-orange transition-colors">
                {t('tournament.registration', locale)}
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---- Tournament details (rich text) ---- */}
  {data.details && (
    <section class="py-6 md:py-8 bg-bg-secondary border-b border-magic-gold/10">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <div class="rich-text text-sm text-text-secondary" set:html={data.details} />
          {data.signupUrl && (
            <div class="mt-6">
              <a href={data.signupUrl} target="_blank" rel="noopener noreferrer"
                 class="btn-primary text-sm px-5 py-2">
                {t('tournament.signUp', locale)}
                <svg class="w-4 h-4 ml-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {/* ---- Main content: Top 8 + Meta (only for past tournaments) ---- */}
  {isPast && (
    <section class="py-6 md:py-8 bg-bg-primary">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid lg:grid-cols-5 gap-6 items-start">

            {/* Left: Top 8 (3 cols) */}
            <Top8Table top8={top8} locale={locale} topLabel={topLabel} />

            {/* Right: Meta sidebar (2 cols) */}
            <div class="lg:col-span-2 min-w-0 space-y-4">
              <h2 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                {t('tournament.metaLabel', locale)}
              </h2>

              {hasMeta ? (
                <Fragment>
                  <MetaPanel
                    metaCommanders={metaCommanders}
                    colorIdentityCounts={colorIdentityCounts}
                    playerCount={playerCount}
                    locale={locale}
                  />

                  {sortedColorCounts.length > 0 && (
                    <ColorPieChart
                      colorCounts={sortedColorCounts}
                      locale={locale}
                    />
                  )}
                </Fragment>
              ) : (
                <div class="tournament-meta-panel !p-3 sm:!p-4">
                  <p class="text-text-muted italic text-sm">{t('tournament.metaUnavailable', locale)}</p>
                </div>
              )}
            </div>

          </div>
        </div>
      </div>
    </section>
  )}

</Base>
