---
import Base from '@/layouts/Base.astro';
import { t } from '@/lib/i18n';
import { getAllTournaments, splitCommanderName, expandCommanderNames } from '@/lib/tournaments';
import { getCardsByNames, getCardImage } from '@/lib/scryfall';
import { colorIdentityLabel, sortColorCounts } from '@/lib/colors';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const locale = 'en';
const banlist = JSON.parse(readFileSync(join(process.cwd(), 'content', 'banlist.json'), 'utf-8'));
const bannedNames = new Set((banlist.cards as string[]).map((n: string) => n.toLowerCase()));

const all = await getAllTournaments();
const today = new Date().toISOString().slice(0, 10);
const past = all.filter(t => t.date < today);

// ---- Global Meta: aggregate metaList across all past tournaments ----
const globalCounts: Record<string, { name: string; count: number }> = {};
let globalTotalPlayers = 0;
let globalTournamentCount = 0;

for (const tournament of past) {
  if (tournament.metaList.length === 0) continue; // Skip tournaments without meta data
  globalTournamentCount++;
  for (const entry of tournament.metaList) {
    const key = entry.name.toLowerCase();
    if (!globalCounts[key]) globalCounts[key] = { name: entry.name, count: 0 };
    globalCounts[key].count += entry.count;
  }
  const total = tournament.metaList.reduce((s, e) => s + e.count, 0);
  globalTotalPlayers += total;
}

const globalSorted = Object.values(globalCounts).sort((a, b) => b.count - a.count);

// ---- Top 4 Meta: only commanders from top8 places 1-4 ----
const top4Counts: Record<string, { name: string; count: number }> = {};
let top4Total = 0;
let top4TournamentCount = 0;

for (const tournament of past) {
  const top4Entries = tournament.top8.filter(e => e.place >= 1 && e.place <= 4);
  if (top4Entries.length === 0) continue; // Skip tournaments without top8 results
  top4TournamentCount++;
  for (const entry of top4Entries) {
    const key = entry.commanderName.toLowerCase();
    if (!top4Counts[key]) top4Counts[key] = { name: entry.commanderName, count: 0 };
    top4Counts[key].count += 1;
    top4Total += 1;
  }
}

const top4Sorted = Object.values(top4Counts).sort((a, b) => b.count - a.count);

// ---- Fetch Scryfall data ----
const allNames = expandCommanderNames([
  ...globalSorted.map(c => c.name),
  ...top4Sorted.map(c => c.name),
]);
const cardsMap = await getCardsByNames([...new Set(allNames)]);

// ---- Helpers ----
const COLOR_HEX: Record<string, string> = {
  W: '#F8F6F1', U: '#0E68AB', B: '#564D44', R: '#D3202A', G: '#00733E', C: '#BEB9B2',
};

function manaIcon(color: string): string {
  return `<i class="ms ms-${color.toLowerCase()} ms-cost ms-shadow" title="${color}"></i>`;
}

function manaIcons(colors: string[]): string {
  if (colors.length === 0) return manaIcon('C');
  return colors.map(c => manaIcon(c)).join('');
}

function ciManaIcons(key: string): string {
  if (key === 'C') return manaIcon('C');
  return [...key].map(c => manaIcon(c)).join('');
}

// ---- Build enriched commanders ----
interface EnrichedCommander {
  rank: number;
  name: string;
  mainName: string;
  partnerName: string | null;
  count: number;
  percentage: number;
  image: string | null;
  cardImage: string | null;
  colors: string[];
  ciKey: string;
  isBanned: boolean;
  manaHtml: string;
}

function enrichCommanders(sorted: { name: string; count: number }[], total: number) {
  const colorCounts: Record<string, number> = {};
  const ciCounts: Record<string, number> = {};

  const commanders: EnrichedCommander[] = sorted.map((entry, i) => {
    const parts = splitCommanderName(entry.name);
    const mainCard = cardsMap.get(parts[0].toLowerCase()) ?? null;
    const partnerCard = parts.length > 1 ? (cardsMap.get(parts[1].toLowerCase()) ?? null) : null;

    const colors = [
      ...(mainCard?.color_identity ?? []),
      ...(partnerCard?.color_identity ?? []),
    ];
    const uniqueColors = [...new Set(colors)].sort();
    const ciKey = uniqueColors.length > 0 ? uniqueColors.join('') : 'C';

    for (const c of uniqueColors) {
      colorCounts[c] = (colorCounts[c] ?? 0) + entry.count;
    }
    ciCounts[ciKey] = (ciCounts[ciKey] ?? 0) + entry.count;

    const image = mainCard ? getCardImage(mainCard, 'art_crop') : null;
    const cardImage = mainCard ? getCardImage(mainCard, 'normal') : null;
    const isBanned = parts.some(p => bannedNames.has(p.toLowerCase()));
    const percentage = total > 0 ? Math.round((entry.count / total) * 100) : 0;

    return {
      rank: i + 1,
      name: entry.name,
      mainName: parts[0],
      partnerName: parts.length > 1 ? parts[1] : null,
      count: entry.count,
      percentage,
      image,
      cardImage,
      colors: uniqueColors,
      ciKey,
      isBanned,
      manaHtml: manaIcons(uniqueColors),
    };
  });

  return { commanders, colorCounts, ciCounts };
}

const global = enrichCommanders(globalSorted, globalTotalPlayers);
const top4 = enrichCommanders(top4Sorted, top4Total);
const hasData = global.commanders.length > 0;
const top4HasData = top4.commanders.length > 0;

// ---- Pre-compute max percentages for progress bars ----
const globalMaxPct = global.commanders.reduce((max, c) => Math.max(max, c.percentage), 0);
const top4MaxPct = top4.commanders.reduce((max, c) => Math.max(max, c.percentage), 0);

// ---- Pre-compute rank badge classes ----
function rankBadgeClass(rank: number): string {
  if (rank === 1) return 'bg-yellow-500/20 text-yellow-400 ring-1 ring-yellow-500/30';
  if (rank === 2) return 'bg-gray-400/15 text-gray-300 ring-1 ring-gray-400/20';
  if (rank === 3) return 'bg-amber-700/20 text-amber-500 ring-1 ring-amber-700/30';
  return 'bg-bg-tertiary text-text-muted';
}

// ---- Pre-compute bar widths for commanders ----
function barWidth(percentage: number, maxPct: number): number {
  return maxPct > 0 ? Math.round(percentage / maxPct * 100) : 0;
}

// ---- Pre-compute color identity data ----
interface CiRow {
  key: string;
  count: number;
  pct: number;
  barWidth: number;
  label: string;
  manaHtml: string;
  isLast: boolean;
}

function buildCiRows(ciCounts: Record<string, number>): CiRow[] {
  const sorted = Object.entries(ciCounts).sort((a, b) => b[1] - a[1]);
  const ciTotal = sorted.reduce((s, [, c]) => s + c, 0);
  const ciMax = sorted.reduce((max, [, c]) => Math.max(max, c), 0);

  return sorted.map(([key, count], i) => {
    const pct = ciTotal > 0 ? Math.round(count / ciTotal * 100) : 0;
    return {
      key,
      count,
      pct,
      barWidth: ciMax > 0 ? Math.round(count / ciMax * 100) : 0,
      label: colorIdentityLabel(key, locale),
      manaHtml: ciManaIcons(key),
      isLast: i === sorted.length - 1,
    };
  });
}

const globalCiRows = buildCiRows(global.ciCounts);
const top4CiRows = buildCiRows(top4.ciCounts);

// ---- Pre-compute CI totals ----
const globalCiTotal = globalCiRows.reduce((s, r) => s + r.count, 0);
const top4CiTotal = top4CiRows.reduce((s, r) => s + r.count, 0);

// ---- Pre-compute color distribution data ----
interface ColorSlice {
  code: string;
  count: number;
  pct: number;
  dash: number;
  gap: number;
  offset: number;
  hex: string;
  label: string;
  borderStyle: string;
}

function buildColorSlices(colorCounts: Record<string, number>): ColorSlice[] {
  const sorted = sortColorCounts(colorCounts);
  const colorTotal = sorted.reduce((s, [, c]) => s + c, 0);
  const circ = 251.33;
  let cumulative = 0;

  return sorted.map(([code, count]) => {
    const pct = colorTotal > 0 ? count / colorTotal * 100 : 0;
    const pctRound = Math.round(pct);
    const dash = pct / 100 * circ;
    const gap = circ - dash;
    const offset = circ / 4 - (cumulative / 100 * circ);
    cumulative += pct;
    const hex = COLOR_HEX[code] ?? '#6B7280';
    return {
      code,
      count,
      pct: pctRound,
      dash,
      gap,
      offset,
      hex,
      label: t(`color.${code}`, locale),
      borderStyle: code === 'B' ? ' border: 1px solid rgba(255,255,255,0.15);' : '',
    };
  });
}

const globalColorSlices = buildColorSlices(global.colorCounts);
const top4ColorSlices = buildColorSlices(top4.colorCounts);
---
<Base title={t('meta.title', locale)} description={t('meta.subtitle', locale)}>

  <!-- Hero -->
  <section class="py-16 bg-gradient-to-b from-bg-primary to-bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="absolute inset-0 opacity-10">
      <img src="/img/cards-background.png" alt="" aria-hidden="true" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 sm:px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-bold text-magic-gradient mb-6">
          {t('meta.title', locale)}
        </h1>
        <p class="text-base sm:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
          {t('meta.subtitle', locale)}
        </p>
      </div>
    </div>
  </section>

  {hasData ? (
    <Fragment>
      {/* ================================================================ */}
      {/* ---- Global Meta ---- */}
      {/* ================================================================ */}
      <section class="py-10 sm:py-16 bg-bg-secondary border-t border-magic-gold/10">
        <div class="container mx-auto px-4 sm:px-6">
          <div class="max-w-5xl mx-auto">

            <div class="text-center mb-8 sm:mb-10">
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-magic-gradient mb-3">
                {t('meta.global', locale)}
              </h2>
              <p class="text-sm sm:text-base text-text-secondary">
                {t('meta.statsOn', locale)}{' '}
                <span class="text-magic-gold font-semibold">{globalTournamentCount}</span>{' '}
                {t('meta.tournaments', locale)}
                {' '}&mdash;{' '}
                <span class="text-magic-gold font-semibold">{globalTotalPlayers}</span>{' '}
                {t('meta.playerEntries', locale)}
              </p>
            </div>

            <div class="grid lg:grid-cols-5 gap-6 lg:gap-8 items-start">

              {/* ===== Left: Commander ranking (3 cols) ===== */}
              <div class="lg:col-span-3 min-w-0">
                <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                  <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                  {t('meta.mostPlayed', locale)}
                </h3>

                <div class="tournament-meta-panel !p-3 sm:!p-4">
                  <div class="space-y-3">
                    {global.commanders.map((cmd) => (
                      <div class={`tournament-commander-row flex-wrap sm:flex-nowrap ${cmd.isBanned ? 'opacity-60' : ''}`}>
                        {/* Rank badge */}
                        <div class={`w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold ${rankBadgeClass(cmd.rank)}`}>
                          {cmd.rank}
                        </div>

                        {cmd.image ? (
                          <div class={`relative w-11 h-11 sm:w-14 sm:h-14 rounded-lg overflow-hidden flex-shrink-0 ring-1 ${cmd.isBanned ? 'ring-red-500/40 grayscale' : 'ring-white/10'} card-hover-trigger`}
                               data-card-name={cmd.mainName}
                               data-card-image={cmd.cardImage ?? cmd.image}>
                            <img src={cmd.image} alt={cmd.name} class="w-full h-full object-cover" loading="lazy" />
                          </div>
                        ) : (
                          <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-lg bg-bg-tertiary flex-shrink-0"></div>
                        )}

                        <div class="flex-1 min-w-0">
                          <div class="flex items-center justify-between gap-1">
                            <span class={`text-xs sm:text-sm font-beleren text-text-primary truncate ${cmd.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{cmd.mainName}</span>
                            <div class="flex items-center gap-1.5 flex-shrink-0">
                              {cmd.isBanned && (
                                <span class="px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-[10px] font-bold text-red-400 uppercase tracking-wider leading-none">
                                  {t('meta.banned', locale)}
                                </span>
                              )}
                              <span class="text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                {cmd.count}<span class="text-text-secondary/60">/{globalTotalPlayers}</span>
                                <span class="ml-1 text-magic-gold font-semibold">{cmd.percentage}%</span>
                              </span>
                            </div>
                          </div>
                          {cmd.partnerName && (
                            <span class={`font-beleren text-text-secondary/60 truncate block leading-tight ${cmd.isBanned ? 'line-through decoration-red-500/70' : ''}`} style="font-size:10px">+ {cmd.partnerName}</span>
                          )}
                          <div class="flex items-center gap-0.5 mt-0.5">
                            <span set:html={cmd.manaHtml} />
                          </div>
                        </div>

                        {/* Bar */}
                        <div class="hidden sm:block flex-shrink-0 w-20 h-2 bg-bg-primary/50 rounded-full overflow-hidden self-center">
                          <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold" style={`width: ${barWidth(cmd.percentage, globalMaxPct)}%`}></div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* ===== Right: Color identity + Color distribution (2 cols) ===== */}
              <div class="lg:col-span-2 min-w-0 space-y-6 sm:space-y-8">

                {/* --- Color Identity Breakdown --- */}
                {globalCiRows.length > 0 && (
                  <Fragment>
                    <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                      <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                      {t('meta.ciTitle', locale)}
                    </h3>

                    <div class="tournament-meta-panel !p-3 sm:!p-4">
                      <div class="space-y-2">
                        {globalCiRows.map((row) => (
                          <div class={`flex flex-col gap-1 sm:gap-1.5 py-1.5 ${!row.isLast ? 'border-b border-white/5' : ''}`}>
                            <div class="flex items-center justify-between gap-1">
                              <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
                                <div class="flex items-center gap-0.5 flex-shrink-0">
                                  <span set:html={row.manaHtml} />
                                </div>
                                <span class="text-xs sm:text-sm font-mono text-text-primary truncate">{row.label}</span>
                              </div>
                              <span class="flex-shrink-0 text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                {row.count}<span class="text-text-secondary/60">/{globalCiTotal}</span>
                                <span class="ml-1 text-magic-gold font-semibold">{row.pct}%</span>
                              </span>
                            </div>
                            <div class="w-full h-1.5 bg-bg-primary/50 rounded-full overflow-hidden">
                              <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold" style={`width: ${row.barWidth}%`}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </Fragment>
                )}

                {/* --- Color distribution pie --- */}
                {globalColorSlices.length > 0 && (
                  <Fragment>
                    <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                      <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                      {t('meta.colorDist', locale)}
                    </h3>

                    <div class="tournament-meta-panel !p-3 sm:!p-4">
                      <div class="flex flex-col items-center gap-4 sm:gap-6">
                        {/* SVG Pie chart */}
                        <div class="flex-shrink-0">
                          <svg viewBox="0 0 100 100" class="w-32 h-32 sm:w-40 sm:h-40 tournament-pie">
                            {globalColorSlices.map((slice) => (
                              <circle cx="50" cy="50" r="40"
                                      fill="none"
                                      stroke={slice.hex}
                                      stroke-width="18"
                                      stroke-dasharray={`${slice.dash} ${slice.gap}`}
                                      stroke-dashoffset={slice.offset}
                                      class="tournament-pie__slice" />
                            ))}
                          </svg>
                        </div>

                        {/* Legend */}
                        <div class="w-full space-y-2">
                          {globalColorSlices.map((slice) => (
                            <div class="flex items-center gap-2">
                              <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background: ${slice.hex};${slice.borderStyle}`}></span>
                              <span class="text-xs sm:text-sm text-text-secondary">{slice.label}</span>
                              <span class="text-xs sm:text-sm font-bold text-text-primary ml-auto tabular-nums">{slice.count}</span>
                              <span class="text-xs text-text-secondary tabular-nums w-8 sm:w-10 text-right">{slice.pct}%</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </Fragment>
                )}

              </div>

            </div>{/* /grid */}

          </div>
        </div>
      </section>

      {/* ================================================================ */}
      {/* ---- Top 4 Meta ---- */}
      {/* ================================================================ */}
      {top4HasData && (
        <section class="py-10 sm:py-16 bg-bg-primary border-t border-white/5">
          <div class="container mx-auto px-4 sm:px-6">
            <div class="max-w-5xl mx-auto">

              <div class="text-center mb-8 sm:mb-10">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-magic-gradient mb-3">
                  {t('meta.top4', locale)}
                </h2>
                <p class="text-sm sm:text-base text-text-secondary">
                  {t('meta.top4Desc', locale)}{' '}
                  <span class="text-magic-gold font-semibold">{top4TournamentCount}</span>{' '}
                  {t('meta.tournaments', locale)}
                  {' '}&mdash;{' '}
                  <span class="text-magic-gold font-semibold">{top4Total}</span>{' '}
                  {t('meta.top4Spots', locale)}
                </p>
              </div>

              <div class="grid lg:grid-cols-5 gap-6 lg:gap-8 items-start">

                {/* ===== Left: Commander ranking (3 cols) ===== */}
                <div class="lg:col-span-3 min-w-0">
                  <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                    <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                    {t('meta.top4Commanders', locale)}
                  </h3>

                  <div class="tournament-meta-panel !p-3 sm:!p-4">
                    <div class="space-y-3">
                      {top4.commanders.map((cmd) => (
                        <div class={`tournament-commander-row flex-wrap sm:flex-nowrap ${cmd.isBanned ? 'opacity-60' : ''}`}>
                          {/* Rank badge */}
                          <div class={`w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold ${rankBadgeClass(cmd.rank)}`}>
                            {cmd.rank}
                          </div>

                          {cmd.image ? (
                            <div class={`relative w-11 h-11 sm:w-14 sm:h-14 rounded-lg overflow-hidden flex-shrink-0 ring-1 ${cmd.isBanned ? 'ring-red-500/40 grayscale' : 'ring-white/10'} card-hover-trigger`}
                                 data-card-name={cmd.mainName}
                                 data-card-image={cmd.cardImage ?? cmd.image}>
                              <img src={cmd.image} alt={cmd.name} class="w-full h-full object-cover" loading="lazy" />
                            </div>
                          ) : (
                            <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-lg bg-bg-tertiary flex-shrink-0"></div>
                          )}

                          <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-1">
                              <span class={`text-xs sm:text-sm font-beleren text-text-primary truncate ${cmd.isBanned ? 'line-through decoration-red-500/70' : ''}`}>{cmd.mainName}</span>
                              <div class="flex items-center gap-1.5 flex-shrink-0">
                                {cmd.isBanned && (
                                  <span class="px-1.5 py-0.5 bg-red-500/20 border border-red-500/30 rounded text-[10px] font-bold text-red-400 uppercase tracking-wider leading-none">
                                    {t('meta.banned', locale)}
                                  </span>
                                )}
                                <span class="text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                  {cmd.count}<span class="text-text-secondary/60">/{top4Total}</span>
                                  <span class="ml-1 text-magic-gold font-semibold">{cmd.percentage}%</span>
                                </span>
                              </div>
                            </div>
                            {cmd.partnerName && (
                              <span class={`font-beleren text-text-secondary/60 truncate block leading-tight ${cmd.isBanned ? 'line-through decoration-red-500/70' : ''}`} style="font-size:10px">+ {cmd.partnerName}</span>
                            )}
                            <div class="flex items-center gap-0.5 mt-0.5">
                              <span set:html={cmd.manaHtml} />
                            </div>
                          </div>

                          {/* Bar */}
                          <div class="hidden sm:block flex-shrink-0 w-20 h-2 bg-bg-primary/50 rounded-full overflow-hidden self-center">
                            <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold" style={`width: ${barWidth(cmd.percentage, top4MaxPct)}%`}></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                {/* ===== Right: Color identity + Color distribution (2 cols) ===== */}
                <div class="lg:col-span-2 min-w-0 space-y-6 sm:space-y-8">

                  {/* --- Color Identity Breakdown --- */}
                  {top4CiRows.length > 0 && (
                    <Fragment>
                      <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                        {t('meta.top4Ci', locale)}
                      </h3>

                      <div class="tournament-meta-panel !p-3 sm:!p-4">
                        <div class="space-y-2">
                          {top4CiRows.map((row) => (
                            <div class={`flex flex-col gap-1 sm:gap-1.5 py-1.5 ${!row.isLast ? 'border-b border-white/5' : ''}`}>
                              <div class="flex items-center justify-between gap-1">
                                <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
                                  <div class="flex items-center gap-0.5 flex-shrink-0">
                                    <span set:html={row.manaHtml} />
                                  </div>
                                  <span class="text-xs sm:text-sm font-mono text-text-primary truncate">{row.label}</span>
                                </div>
                                <span class="flex-shrink-0 text-xs sm:text-sm text-text-secondary tabular-nums whitespace-nowrap">
                                  {row.count}<span class="text-text-secondary/60">/{top4CiTotal}</span>
                                  <span class="ml-1 text-magic-gold font-semibold">{row.pct}%</span>
                                </span>
                              </div>
                              <div class="w-full h-1.5 bg-bg-primary/50 rounded-full overflow-hidden">
                                <div class="h-full rounded-full bg-gradient-to-r from-brand-orange to-magic-gold" style={`width: ${row.barWidth}%`}></div>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    </Fragment>
                  )}

                  {/* --- Color distribution pie --- */}
                  {top4ColorSlices.length > 0 && (
                    <Fragment>
                      <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-text-primary uppercase tracking-wide mb-4 flex items-center gap-2">
                        <span class="w-1 h-6 bg-brand-orange rounded-full"></span>
                        {t('meta.top4Colors', locale)}
                      </h3>

                      <div class="tournament-meta-panel !p-3 sm:!p-4">
                        <div class="flex flex-col items-center gap-4 sm:gap-6">
                          <div class="flex-shrink-0">
                            <svg viewBox="0 0 100 100" class="w-32 h-32 sm:w-40 sm:h-40 tournament-pie">
                              {top4ColorSlices.map((slice) => (
                                <circle cx="50" cy="50" r="40"
                                        fill="none"
                                        stroke={slice.hex}
                                        stroke-width="18"
                                        stroke-dasharray={`${slice.dash} ${slice.gap}`}
                                        stroke-dashoffset={slice.offset}
                                        class="tournament-pie__slice" />
                              ))}
                            </svg>
                          </div>

                          <div class="w-full space-y-2">
                            {top4ColorSlices.map((slice) => (
                              <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background: ${slice.hex};${slice.borderStyle}`}></span>
                                <span class="text-xs sm:text-sm text-text-secondary">{slice.label}</span>
                                <span class="text-xs sm:text-sm font-bold text-text-primary ml-auto tabular-nums">{slice.count}</span>
                                <span class="text-xs text-text-secondary tabular-nums w-8 sm:w-10 text-right">{slice.pct}%</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </Fragment>
                  )}

                </div>

              </div>{/* /grid */}

            </div>
          </div>
        </section>
      )}
    </Fragment>
  ) : (
    /* ---- Empty state ---- */
    <section class="py-16 bg-bg-primary">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="text-center py-16">
          <svg class="w-24 h-24 text-magic-gold/20 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <h2 class="text-2xl font-heading font-bold text-magic-gradient mb-4">
            {t('meta.noData', locale)}
          </h2>
          <p class="text-text-secondary">
            {t('meta.noDataDesc', locale)}
          </p>
        </div>
      </div>
    </section>
  )}

</Base>
