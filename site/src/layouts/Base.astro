---
/**
 * The only layout.
 *
 * Beyond the shell, this owns everything a page needs to be found and shared.
 * None of it existed before: no canonical, no hreflang (so the localised copies
 * competed with each other), and no Open Graph — every link posted to the
 * Discord where this format actually lives rendered as a bare URL.
 *
 * `image` accepts a site-relative or absolute URL and is resolved against
 * `Astro.site`; pages that have a commander pass its art, everything else falls
 * back to the logo.
 */
import '@/styles/globals.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLocaleFromPath, localeTag, ogLocale, locales, t } from '@/lib/i18n';
import { translatePath } from '@/lib/routes';

export interface Props {
  title: string;
  description?: string;
  /** Social preview image. Defaults to the logo. */
  image?: string | null;
  /** Open Graph type. `article` for decklists and tournament reports. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD documents, injected as-is. */
  schemas?: Record<string, unknown>[];
  /** Suffix the site name onto the tab title. Off for pages that self-title. */
  bareTitle?: boolean;
}

const {
  title,
  description,
  image = null,
  ogType = 'website',
  schemas = [],
  bareTitle = false,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const path = Astro.url.pathname;

const site = Astro.site ?? new URL('https://pauperduelcommander.fr');
const canonical = new URL(path, site).href;

// One alternate per language, including this one — Google expects a page to be
// listed among its own alternates. French is x-default: it is the locale the
// content is authored in and the only one guaranteed complete.
const alternates = locales.map(target => ({
  locale: target,
  href: new URL(target === locale ? path : translatePath(path, target), site).href,
}));
const defaultHref = alternates.find(a => a.locale === 'fr')!.href;

const fullTitle = bareTitle ? title : `${title} — Pauper Duel Commander`;
const ogImage = new URL(image ?? '/img/logo.png', site).href;
const metaDescription = description ?? t('site.description', locale);

// Site-wide JSON-LD. Page-level documents (Event, BreadcrumbList…) come in via
// `schemas` so each page describes only what it actually is.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pauper Duel Commander',
  alternateName: 'PDC',
  url: site.href,
  inLanguage: localeTag(locale),
  description: metaDescription,
};
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />

  <link rel="canonical" href={canonical} />
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.locale} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={defaultHref} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Pauper Duel Commander" />
  <meta property="og:locale" content={ogLocale(locale)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  <link rel="manifest" href="/img/site.webmanifest" />
  <meta name="theme-color" content="#FF5722" />

  {/* Headings are the first thing painted; the body face follows. */}
  <link rel="preload" href="/fonts/webfonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/webfonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
  {schemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  ))}
</head>
<body>
  <a href="#main" class="skip-link">{t('a11y.skipToContent', locale)}</a>

  <Header locale={locale} currentPath={path} />

  <main id="main" class="site-main pt-[68px] md:pt-[76px]">
    <slot />
  </main>

  <Footer locale={locale} />

  <!-- Global scripts -->
  <script src="@/scripts/cookieconsent-config.ts"></script>
  <script src="@/scripts/mobile-menu.ts"></script>
  <script src="@/scripts/card-preview.ts"></script>
  <script src="@/scripts/analytics.ts"></script>
</body>
</html>
