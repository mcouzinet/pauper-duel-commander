# Web-root redirects for the WordPress -> Astro cutover.
#
# The old WordPress site served un-prefixed URLs (/banlist/, /tournois/…); the
# Astro site serves locale-prefixed ones (/fr/banlist/…). Without these 301s,
# every existing link, bookmark and search-engine result would 404.
#
# Copied into dist/ at build time (Astro ships public/ verbatim), so it deploys
# with the site. Apache only — the nginx equivalent is at the bottom.
#
# The rules match only un-prefixed old paths, so they never touch /fr/… or
# /en/… and cannot loop.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical host. Both www and the apex resolve, which served the whole site
    # twice to search engines.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Absolute targets on purpose: a path-only target made Apache emit
# "https://host:443/fr/..." in Location, which is valid but ugly in every log,
# analytics report and shared link.

# --- Single pages ---
RedirectMatch 301 ^/banlist/?$                          https://pauperduelcommander.fr/fr/banlist/
RedirectMatch 301 ^/validateur/?$                       https://pauperduelcommander.fr/fr/validateur/
RedirectMatch 301 ^/meta/?$                             https://pauperduelcommander.fr/fr/meta/
RedirectMatch 301 ^/declaration-de-confidentialite/?$   https://pauperduelcommander.fr/fr/confidentialite/

# --- Collections: keep the slug, land on the localized route ---
RedirectMatch 301 ^/tournois/?$        https://pauperduelcommander.fr/fr/tournois/
RedirectMatch 301 ^/tournois/(.+)$     https://pauperduelcommander.fr/fr/tournois/$1
RedirectMatch 301 ^/decklist/?$        https://pauperduelcommander.fr/fr/decklist/
RedirectMatch 301 ^/decklist/(.+)$     https://pauperduelcommander.fr/fr/decklist/$1

# --- Home ---
RedirectMatch 301 ^/$ https://pauperduelcommander.fr/fr/

# Serve index.html for directory requests (Astro emits <route>/index.html).
DirectoryIndex index.html

# Custom 404 (Astro emits /404.html at the web root).
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Caching
#
# The host answered `max-age=900` for everything, so a returning visitor
# re-downloaded the hashed bundles and the fonts on any visit fifteen minutes
# apart. Astro fingerprints /_astro/, and the fonts are versioned in their
# filenames, so both can be cached indefinitely; HTML must not be.
# ---------------------------------------------------------------------------
# Path-based rules go through SetEnvIf, never <LocationMatch>: that directive is
# server-config only, and Apache answers 500 to every request when it appears in
# a .htaccess. The file carried it for months without anyone noticing, because
# the deploy skipped dotfiles and the server kept an older hand-pushed copy. The
# day the deploy started sending them, the whole site went down.
<IfModule mod_setenvif.c>
    # Fingerprinted build output and fonts: the filename changes when the bytes
    # do, so they can be cached indefinitely.
    SetEnvIf Request_URI "^/(_astro|fonts)/" PDC_IMMUTABLE
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=PDC_IMMUTABLE

    # Images and video: stable but not fingerprinted, so a month then revalidate.
    # Without mp4 here the host answers its own max-age=900 and a returning
    # visitor re-downloads fourteen megabytes twice an hour.
    <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2|mp4)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>

    # HTML always revalidates: the ban list date must never be stale.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# ---------------------------------------------------------------------------
# nginx equivalent (.htaccess is ignored by nginx — add this to the server block):
#
#   location = /                              { return 301 /fr/; }
#   location = /banlist/                      { return 301 /fr/banlist/; }
#   location = /validateur/                   { return 301 /fr/validateur/; }
#   location = /meta/                         { return 301 /fr/meta/; }
#   location = /declaration-de-confidentialite/ { return 301 /fr/confidentialite/; }
#   location ^~ /tournois/ { rewrite ^/tournois/(.*)$ /fr/tournois/$1 permanent; }
#   location ^~ /decklist/ { rewrite ^/decklist/(.*)$ /fr/decklist/$1 permanent; }
#   error_page 404 /404.html;
#   if ($host ~* ^www\.(.*)$) { return 301 https://$1$request_uri; }
#   location ^~ /_astro/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
#   location ^~ /fonts/  { add_header Cache-Control "public, max-age=31536000, immutable"; }
# ---------------------------------------------------------------------------
