msgstr "Do not include your commander in the decklist, it is specified separately above."

#: views/page-validateur.twig:123
msgid "Valider le deck"
msgstr "Validate deck"

#: views/page-validateur.twig:150
msgid "Règles du format PDC"
msgstr "PDC Format Rules"

#: views/page-validateur.twig:167
msgid "100 cartes"
msgstr "100 cards"

#: views/page-validateur.twig:168
msgid "99 cartes + 1 général (ou 98 + 2 en cas de partenaire)."
msgstr "99 cards + 1 commander (or 98 + 2 with partner)."

#: views/page-validateur.twig:181
msgid "Général Uncommon"
msgstr "Uncommon Commander"

#: views/page-validateur.twig:182
msgid "Le général doit obligatoirement être de rareté Uncommon."
msgstr "The commander must be of Uncommon rarity."

#: views/page-validateur.twig:197
msgid "Cartes Communes"
msgstr "Common Cards"

#: views/page-validateur.twig:198
msgid "Toutes les 99 cartes du deck doivent être de rareté Commune (Common)."
msgstr "All 99 cards in the deck must be of Common rarity."

#: views/page-validateur.twig:216
msgid "Identité de couleur"
msgstr "Color Identity"

#: views/page-validateur.twig:217
msgid "Toutes les cartes doivent respecter l'identité de couleur du général."
msgstr "All cards must respect the commander's color identity."

#: views/page-validateur.twig:233
msgid "Pas de doublon"
msgstr "No duplicates"

#: views/page-validateur.twig:234
msgid "Maximum 1 exemplaire de chaque carte, sauf les terrains de base."
msgstr "Maximum 1 copy of each card, except basic lands."

#: views/page-validateur.twig:250
msgid "Ban List"
msgstr "Ban List"

#: views/page-validateur.twig:251
msgid "Les cartes figurant sur la liste des interdictions PDC ne sont pas autorisées."
msgstr "Cards on the PDC ban list are not allowed."

