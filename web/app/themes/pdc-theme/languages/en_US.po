#. Deck Validator (PHP backend)
#. ================================================================

#: inc/class-deck-validator.php
msgid "Le nom du général est obligatoire."
msgstr "The commander name is required."

#: inc/class-deck-validator.php
msgid "La decklist est vide ou dans un format invalide. Utilisez le format MTGO : \"1 Nom de la carte\"."
msgstr "The decklist is empty or in an invalid format. Use the MTGO format: \"1 Card Name\"."

#: inc/class-deck-validator.php
msgid "Le général « %s » est introuvable sur Scryfall. Vérifiez l'orthographe (en anglais)."
msgstr "Commander \"%s\" was not found on Scryfall. Please check the spelling (in English)."

#: inc/class-deck-validator.php
msgid "Le partenaire « %s » est introuvable sur Scryfall. Vérifiez l'orthographe (en anglais)."
msgstr "Partner \"%s\" was not found on Scryfall. Please check the spelling (in English)."

#: inc/class-deck-validator.php
msgid "inconnu"
msgstr "unknown"

#: inc/class-deck-validator.php
msgid "Le général « %1$s » doit être une créature (type actuel : %2$s)."
msgstr "Commander \"%1$s\" must be a creature (current type: %2$s)."

#: inc/class-deck-validator.php
msgid "inconnue"
msgstr "unknown"

#: inc/class-deck-validator.php
msgid "Le général « %1$s » doit être de rareté Uncommon (rareté actuelle : %2$s)."
msgstr "Commander \"%1$s\" must be Uncommon rarity (current rarity: %2$s)."

#: inc/class-deck-validator.php
msgid "98 cartes (avec 2 généraux partenaires)"
msgstr "98 cards (with 2 partner commanders)"

#: inc/class-deck-validator.php
msgid "99 cartes (avec 1 général)"
msgstr "99 cards (with 1 commander)"

#: inc/class-deck-validator.php
msgid "Le deck contient %1$s carte(s). Un deck PDC doit contenir %2$s."
msgstr "The deck contains %1$s card(s). A PDC deck must contain %2$s."

#: inc/class-deck-validator.php
msgid "Les cartes suivantes sont introuvables sur Scryfall. Vérifiez l'orthographe (noms en anglais) :"
msgstr "The following cards were not found on Scryfall. Check the spelling (English names):"

#: inc/class-deck-validator.php
msgid "Les cartes suivantes apparaissent en plusieurs exemplaires (seuls les terrains de base sont autorisés en plusieurs copies) :"
msgstr "The following cards appear in multiple copies (only basic lands are allowed in multiple copies):"

#: inc/class-deck-validator.php
msgid "Les cartes suivantes n'ont jamais été imprimées en rareté Commune (non légales en Pauper) :"
msgstr "The following cards have never been printed at Common rarity (not Pauper legal):"

#: inc/class-deck-validator.php
msgid "« %1$s » + « %2$s » (%3$s)"
msgstr "\"%1$s\" + \"%2$s\" (%3$s)"

#: inc/class-deck-validator.php
msgid "« %1$s » (%2$s)"
msgstr "\"%1$s\" (%2$s)"

#: inc/class-deck-validator.php
msgid "Les cartes suivantes sont hors de l'identité de couleur du général %s :"
msgstr "The following cards are outside the color identity of commander %s:"

#: inc/class-deck-validator.php
msgid "Les cartes suivantes sont bannies dans le format PDC :"
msgstr "The following cards are banned in the PDC format:"

#: inc/class-deck-validator.php
msgid "La liste des cartes bannies n'a pas pu être chargée. La vérification de la ban list a été ignorée."
msgstr "The ban list could not be loaded. Ban list verification was skipped."

